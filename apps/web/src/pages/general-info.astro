---
/**
 * MANDATORY PUBLIC DISCLOSURE.
 *
 * Every figure, every document link and all 131 staff rows come out of
 * data/disclosure.ts, transcribed from the school's own MPD.pdf, BRS.pdf and
 * affiliation letter. That file's header records where the school's /general-info/
 * web page disagrees with the PDF it links to, and why the PDF was followed.
 *
 * Writing this file also retires the generated placeholder: [...slug].astro
 * emits every nav destination that has no page, and a static route always wins.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import MpdPage from '../components/disclosure/MpdPage.astro';

import banner from '../assets/photos/sunbeem-1.jpg';
---

<BaseLayout
  title="Mandatory Public Disclosure — Sunbeam School Ballia"
  description="The CBSE Mandatory Public Disclosure for Sunbeam School Ballia: affiliation 2131962, school code 70205, the school's certificates, three years of Class X and XII board results, all 131 filed staff members, and its infrastructure figures."
>
  <PageHero
    title="Mandatory Public Disclosure"
    standfirst="Official information and documents published by Sunbeam School Ballia in accordance with CBSE guidelines."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'General Information', href: '/general-info/' },
    ]}
    src={banner}
    alt="The main building of Sunbeam School Ballia at Agarsanda, seen across its front lawn."
    position="50% 46%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <MpdPage />
  </div>
</BaseLayout>

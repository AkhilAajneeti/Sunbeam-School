---
/**
 * ACADEMIC STRUCTURE · SECONDARY — Classes IX and X.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION, NOT THE Ac* SYSTEM. Sourcing, the
 * photograph roster and the two places where this page departs from the written
 * brief — on the reference image's authority, and on evidence grounds — are
 * documented in the component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import SecondaryPage from '../../../components/academics/structure/SecondaryPage.astro';

import banner from '../../../assets/chem lab/DSC_1262 copy.jpg';
---

<BaseLayout
  title="Secondary — Sunbeam School Ballia"
  description="Secondary at Sunbeam School Ballia, Classes IX and X: board practicals in the Physics, Chemistry and Biology laboratories from Class IX, a published syllabus document for every class, and a serving IRS officer taking the Guiding Futures session."
>
  <PageHero
    title="Secondary"
    standfirst="Classes IX to X — where board practicals begin and an IRS officer comes to talk about how he got there."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Academic Structure', href: '/academics/structure/' },
    ]}
    src={banner}
    alt="The chemistry laboratory at Sunbeam School Ballia, benches laid out with reagent shelves and gas taps."
    position="50% 52%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <SecondaryPage />
  </div>
</BaseLayout>

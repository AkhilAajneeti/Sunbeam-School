---
/**
 * ACADEMIC STRUCTURE · MIDDLE SCHOOL — Classes VI to VIII.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION, NOT THE Ac* SYSTEM. Sourcing, the
 * photograph roster and the two places where this page departs from the design
 * brief on evidence grounds are documented in the component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import MiddleSchoolPage from '../../../components/academics/structure/MiddleSchoolPage.astro';

import banner from '../../../assets/photos/sb-phy-lab.jpg';
---

<BaseLayout
  title="Middle School — Sunbeam School Ballia"
  description="Middle School at Sunbeam School Ballia, Classes VI to VIII: specialist teaching, twelve laboratories, a Class VII entrepreneurship programme that runs a real venture end to end, and a Class VIII winner of a seventy-entrant contest."
>
  <PageHero
    title="Middle School"
    standfirst="Classes VI to VIII — where learning becomes more independent, practical and exploratory."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Academic Structure', href: '/academics/structure/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia working at benches in the physics laboratory, with portraits of Nikola Tesla and Michael Faraday on the wall."
    position="50% 46%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <MiddleSchoolPage />
  </div>
</BaseLayout>

---
/**
 * STUDENT SUCCESS · UNIVERSITY COUNSELLING.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION. The placement board is the page's visual
 * focus rather than an illustration beside text, and the eight result cards are
 * a data-driven rail. Sourcing — all of it read off the school's own artwork —
 * and the four things this page refuses to compute are in the component header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import UniversityCounsellingPage from '../../../components/academics/assessment/UniversityCounsellingPage.astro';

import banner from '../../../assets/library/DSC_1224 copy.jpg';
---

<BaseLayout
  title="University Counselling — Sunbeam School Ballia"
  description="Where the 2024-25 leavers of Sunbeam School Ballia went: eighteen named placements on the school's own board — ten University of Delhi colleges, three at BHU — and the published CUET (UG) 2025 scores behind them."
>
  <PageHero
    title="University Counselling"
    standfirst="The school prints the destinations on a board, with names on it. This page is that board."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Student Success', href: '/academics/student-success/' },
    ]}
    src={banner}
    alt="The Nalanda Library at Sunbeam School Ballia, its shelves signed by subject and reading tables ringed with chairs."
    position="50% 48%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <UniversityCounsellingPage />
  </div>
</BaseLayout>

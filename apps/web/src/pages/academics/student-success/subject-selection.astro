---
/**
 * STUDENT SUCCESS · SUBJECT SELECTION GUIDANCE.
 *
 * The body is a bespoke composition. Sourcing — the four streams, the Class X
 * and XI audience read off the school's own hand-painted banner, the counselling
 * desk, and the CUET results that follow the choice — plus the things this page
 * refuses to claim, are set out in the component header.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import SubjectSelectionPage from '../../../components/academics/assessment/SubjectSelectionPage.astro';

import banner from '../../../assets/bio lab/DSC_1274 copy.jpg';
---

<BaseLayout
  title="Subject Selection Guidance — Sunbeam School Ballia"
  description="How the stream choice is supported at Sunbeam School Ballia: one-to-one counselling for Classes X and XI, four streams to board level, and CUET (UG) 2025 results published across three of them."
>
  <PageHero
    title="Subject Selection Guidance"
    standfirst="The school's own banner says who this is for — Class X and Class XI. One year before the choice, and the year it lands."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Student Success', href: '/academics/student-success/' },
    ]}
    src={banner}
    alt="A subject laboratory at Sunbeam School Ballia, benches and apparatus laid out along the room."
    position="50% 50%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <SubjectSelectionPage />
  </div>
</BaseLayout>

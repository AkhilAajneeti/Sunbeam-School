---
/**
 * ASSESSMENT & SUPPORT · COMPETITIVE EXAMINATION PREPARATION.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION. Sourcing, the split with Olympiad
 * Achievements, and the seven things this page refuses to claim are in the
 * component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import CompetitiveExamPage from '../../../components/academics/assessment/CompetitiveExamPage.astro';

import banner from '../../../assets/photos/sb-chem-lab.jpg';
---

<BaseLayout
  title="Competitive Examination Preparation — Sunbeam School Ballia"
  description="The national programmes Sunbeam School Ballia enters: Vidyarthi Vigyan Manthan for Classes VI to XI, the National Children's Science Congress, Inspire Award MANAK and the SOF olympiads."
>
  <PageHero
    title="Competitive Examination Preparation"
    standfirst="Four national programmes, named — because an entry can be checked and an abstraction cannot."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Assessment & Support', href: '/academics/assessment/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia working along the chemistry bench, test tubes held over the burners."
    position="50% 44%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <CompetitiveExamPage />
  </div>
</BaseLayout>

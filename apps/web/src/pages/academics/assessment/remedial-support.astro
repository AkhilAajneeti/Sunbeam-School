---
/**
 * ASSESSMENT & SUPPORT · REMEDIAL SUPPORT.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION. Sourcing — the school's own promotion
 * policy — and the one place this page departs from the reference mockup on
 * evidence grounds (the class range) are in the component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import RemedialSupportPage from '../../../components/academics/assessment/RemedialSupportPage.astro';

import banner from '../../../assets/chem lab/DSC_1262 copy.jpg';
---

<BaseLayout
  title="Remedial Support — Sunbeam School Ballia"
  description="How a retest works at Sunbeam School Ballia: no sooner than ten days after results, two clear days between retests, results within two and a half weeks, and a retest still required after a medical absence."
>
  <PageHero
    title="Remedial Support"
    standfirst="A retest with dates attached — ten days, two clear days, two and a half weeks."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Assessment & Support', href: '/academics/assessment/' },
    ]}
    src={banner}
    alt="The chemistry laboratory at Sunbeam School Ballia, benches laid out with reagent shelves and gas taps."
    position="50% 50%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <RemedialSupportPage />
  </div>
</BaseLayout>

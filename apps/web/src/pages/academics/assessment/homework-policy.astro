---
/**
 * ASSESSMENT & SUPPORT · HOMEWORK POLICY.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION. Sourcing — one published sentence and two
 * numbered items read off the school's own projected agenda — and the four
 * absences this page states rather than fills are in the component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import HomeworkPolicyPage from '../../../components/academics/assessment/HomeworkPolicyPage.astro';

import banner from '../../../assets/photos/sb-library.jpg';
---

<BaseLayout
  title="Homework Policy — Sunbeam School Ballia"
  description="What Sunbeam School Ballia publishes about homework: that it is set to a published pattern, and that the quality of assignments and the correction of notebooks are standing items on the Parents' Forum agenda."
>
  <PageHero
    title="Homework Policy"
    standfirst="One published sentence, one published agenda item — and nothing invented to fill the gap between them."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Assessment & Support', href: '/academics/assessment/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia reading at the long tables of the library, a member of staff at the head of the row."
    position="50% 46%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <HomeworkPolicyPage />
  </div>
</BaseLayout>

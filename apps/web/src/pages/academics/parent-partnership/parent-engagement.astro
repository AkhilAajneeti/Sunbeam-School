---
/**
 * PARENT PARTNERSHIP · PARENT ENGAGEMENT.
 *
 * The body is a bespoke composition. What was removed from this page and stays
 * removed — four engagement "channels" the school does not publish, two of them
 * making claims about what parents do on the premises — is in the component
 * header, along with why the agenda cards carry no invented descriptions.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import ParentEngagementPage from '../../../components/academics/partnership/ParentEngagementPage.astro';

import banner from '../../../assets/parents forum/parents forum (3).jpg';
---

<BaseLayout
  title="Parent Engagement — Sunbeam School Ballia"
  description="How parents are engaged at Sunbeam School Ballia: seated by class section at the Parents' Forum from Nursery upward, with a projected twelve-item agenda that names Grandparents Cove."
>
  <PageHero
    title="Parent Engagement"
    standfirst="Not an open invitation — a seat, with a class written on it."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Parent Partnership', href: '/academics/parent-partnership/' },
    ]}
    src={banner}
    alt="Parents of Sunbeam School Ballia seated at desks carrying class nameplates during a Parents' Forum session."
    position="50% 52%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <ParentEngagementPage />
  </div>
</BaseLayout>

---
/**
 * PARENT PARTNERSHIP · PARENTS' FORUM.
 *
 * The body is a bespoke composition and its agenda is data-driven from
 * data/parentsForum.ts — twelve items transcribed off the school's own projected
 * slide. Why the design brief's twelve are not the school's twelve, and why four
 * of them carry no description, are in that file's header and the component's.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import ParentsForumPage from '../../../components/academics/partnership/ParentsForumPage.astro';

import banner from '../../../assets/parents forum/parents forum (5).jpg';
---

<BaseLayout
  title="Parents’ Forum — Sunbeam School Ballia"
  description="The Parents' Forum at Sunbeam School Ballia: a seat per class section, the school's leadership on the panel, and a twelve-item agenda projected on the wall — from the Almanac and the pace of teaching to the correction of notebooks."
>
  <PageHero
    title="Parents’ Forum"
    standfirst="A seat with your child's class written on it, and an agenda projected on the wall."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Parent Partnership', href: '/academics/parent-partnership/' },
    ]}
    src={banner}
    alt="A sitting of the Parents' Forum at Sunbeam School Ballia, its agenda projected on the screen above the school's leadership panel."
    position="50% 42%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <ParentsForumPage />
  </div>
</BaseLayout>

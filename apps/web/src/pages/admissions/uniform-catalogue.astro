---
/**
 * ADMISSIONS · UNIFORM CATALOGUE.
 *
 * The school's Uniform page carries two PDF links and nothing else. Everything
 * below the two cards — the class groups, the four seasons, the shoe table and
 * the school's own eleven notes — was read out of the catalogues themselves,
 * which are image-only and had to be rendered at 4x to be read. Sourcing and
 * the discrepancies found are in data/uniform.ts.
 *
 * The route already existed in the footer utility row, which is where the brief
 * wants it — Uniform Catalogue is deliberately NOT in the navbar, and was not
 * in it before this page was written either.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import UniformPage from '../../components/uniform/UniformPage.astro';

import banner from '../../assets/photos/sunbeem-1.jpg';
---

<BaseLayout
  title="Uniform Catalogue — Sunbeam School Ballia"
  description="The official uniform catalogues of Sunbeam School Ballia: the Winter Uniform Catalogue for Session 2025-26 and the school's general uniform catalogue, with the class groups, seasons, shoe list and uniform notes they set out."
>
  <PageHero
    title="Uniform Catalogue"
    standfirst="School uniform and dress guidelines for all classes and seasons."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Essential Information', href: '/admissions/' },
    ]}
    src={banner}
    alt="The main building of Sunbeam School Ballia at Agarsanda, seen across its front lawn."
    position="50% 46%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <UniformPage />
  </div>
</BaseLayout>

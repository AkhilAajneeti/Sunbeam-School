---
/**
 * THE ROUTE MAP — the page's signature.
 *
 * ═══ IT IS PLOTTED FROM REAL COORDINATES ════════════════════════════════════
 *
 * Every dot below is a genuine latitude and longitude, projected linearly into
 * the viewBox. Jaipur really is that far west of Ballia; Bhubaneswar really is
 * that far south-east. A "map" with cities scattered for composition would be a
 * decoration pretending to be information, and any reader who knows the country
 * would spot it instantly.
 *
 *   x = (lon - LON0) / LON_SPAN * W
 *   y = (LAT1 - lat) / LAT_SPAN * H     (inverted: north is up)
 *
 * ═══ NO COUNTRY OUTLINE, AND THAT IS DELIBERATE ═════════════════════════════
 *
 * A hand-drawn India silhouette is a border drawn from memory — it would be
 * subtly wrong, and a subtly wrong national border on an Indian school's website
 * is not a small mistake. What this draws instead is the thing the page is
 * actually about: the ROUTES. Every arc springs from Ballia, because every
 * journey did.
 *
 * IT SCALES BY ADDING A DOT. A new destination is one entry in `stops` with its
 * coordinates; the projection places it and the arc draws itself.
 */
interface Stop {
  name: string;
  state: string;
  lat: number;
  lon: number;
  /** The origin — drawn larger, and no arc to itself. */
  home?: boolean;
  /** Nudges the label off the dot where two sit close together. */
  anchor?: 'start' | 'middle' | 'end';
  dy?: number;
}

const stops: Stop[] = [
  { name: 'Ballia', state: 'Uttar Pradesh', lat: 25.76, lon: 84.15, home: true, anchor: 'start', dy: -16 },
  { name: 'Varanasi', state: 'Uttar Pradesh', lat: 25.32, lon: 82.97, anchor: 'end', dy: 4 },
  { name: 'Buxar', state: 'Bihar', lat: 25.56, lon: 83.98, anchor: 'start', dy: 20 },
  { name: 'Jaipur', state: 'Rajasthan', lat: 26.91, lon: 75.79, anchor: 'start', dy: -14 },
  { name: 'Indore', state: 'Madhya Pradesh', lat: 22.72, lon: 75.86, anchor: 'start', dy: 22 },
  { name: 'Bhubaneswar', state: 'Odisha', lat: 20.30, lon: 85.82, anchor: 'end', dy: 24 },
];

/* The window, chosen to frame the six stops with margin rather than to crop
   them. Change a coordinate and this still holds. */
const W = 560;
const H = 380;
const LON0 = 73.6;
const LON1 = 87.8;
const LAT0 = 18.9;
const LAT1 = 28.4;

const px = (lon: number) => ((lon - LON0) / (LON1 - LON0)) * W;
const py = (lat: number) => ((LAT1 - lat) / (LAT1 - LAT0)) * H;

const home = stops.find((s) => s.home)!;
const hx = px(home.lon);
const hy = py(home.lat);

/* Each route is a quadratic curve, bowed perpendicular to its own line so long
   arcs read as travel rather than as a spider's web of straight rules. The bow
   scales with distance: short hops stay nearly straight. */
const routes = stops
  .filter((s) => !s.home)
  .map((s) => {
    const x = px(s.lon);
    const y = py(s.lat);
    const mx = (hx + x) / 2;
    const my = (hy + y) / 2;
    const dx = x - hx;
    const dy = y - hy;
    const len = Math.hypot(dx, dy);
    const bow = len * 0.16;
    // Perpendicular to the chord, normalised.
    const cx = mx + (-dy / len) * bow;
    const cy = my + (dx / len) * bow;
    return { d: `M ${hx.toFixed(1)} ${hy.toFixed(1)} Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${x.toFixed(1)} ${y.toFixed(1)}`, len };
  });

const states = [...new Set(stops.map((s) => s.state))];
---

<section class="rmap" aria-labelledby="rmap-title">
  <div class="u-container rmap__inner">
    <div class="rmap__lede">
      <p class="rmap__eyebrow t-label">Where we have been</p>
      <h2 class="rmap__h" id="rmap-title">{states.length} states, and everything starts at Ballia</h2>
      <p class="rmap__b">
        Every journey on this page begins on the same ground — an afternoon at the district
        court, or three days on a conference floor eight hundred kilometres away.
      </p>

      <ul class="rmap__states">
        {states.map((st) => <li>{st}</li>)}
      </ul>
    </div>

    {/* The drawing is decorative — every destination it shows is named in the
        list above and again in the trip bands below, so a screen reader loses
        nothing by skipping it. */}
    <div class="rmap__figure" aria-hidden="true">
      <svg viewBox={`0 0 ${W} ${H}`} fill="none" role="presentation">
        {routes.map((r, i) => (
          <path
            class="rmap__route"
            d={r.d}
            stroke="var(--sb-violet)"
            stroke-width="1.6"
            stroke-linecap="round"
            style={`--len:${Math.round(r.len * 1.4)}; --i:${i};`}
          />
        ))}

        {stops.map((s) => {
          const x = px(s.lon);
          const y = py(s.lat);
          return (
            <g class:list={['rmap__stop', s.home && 'rmap__stop--home']}>
              {s.home && <circle cx={x} cy={y} r="13" class="rmap__halo" />}
              <circle cx={x} cy={y} r={s.home ? 5.5 : 3.6} class="rmap__dot" />
              <text
                x={s.anchor === 'end' ? x - 10 : x + 10}
                y={y + (s.dy ?? 4)}
                text-anchor={s.anchor === 'end' ? 'end' : 'start'}
                class="rmap__label"
              >
                {s.name}
              </text>
            </g>
          );
        })}
      </svg>
    </div>
  </div>
</section>

<style>
  .rmap {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
    overflow: hidden;
  }

  .rmap__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(28px, 5vw, 80px);
    align-items: center;
  }

  .rmap__eyebrow { color: var(--sb-violet); }

  .rmap__h {
    margin-top: var(--sb-4);
    max-width: 15ch;
    font-family: var(--sb-font-display);
    font-size: clamp(28px, 3.4vw, 48px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .rmap__b {
    margin-top: var(--sb-5);
    max-width: 44ch;
    font-size: var(--sb-body);
    line-height: 1.65;
    color: var(--sb-text-secondary);
  }

  .rmap__states {
    list-style: none;
    margin: var(--sb-7) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-3);
  }

  .rmap__states li {
    padding: 6px 14px;
    border-radius: var(--sb-r-full);
    background: var(--sb-paper);
    box-shadow: inset 0 0 0 1px var(--sb-border);
    font-size: var(--sb-caption);
    font-weight: 650;
    color: var(--sb-charcoal);
  }

  .rmap__figure svg { display: block; width: 100%; height: auto; overflow: visible; }

  /* THE ROUTES DRAW THEMSELVES IN. `--len` is each arc's own measured length, so
     the dash offset is right for a 60px hop and an 800px flight alike — one
     hard-coded dash array would leave short arcs finished before they started
     and long ones still drawing. */
  .rmap__route {
    stroke-dasharray: var(--len);
    stroke-dashoffset: var(--len);
    opacity: 0.55;
    animation: draw 1.5s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: calc(var(--i) * 160ms + 200ms);
  }

  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }

  .rmap__halo { fill: var(--sb-violet); opacity: 0.14; }
  .rmap__dot { fill: var(--sb-violet); }
  .rmap__stop--home .rmap__dot { fill: var(--sb-violet); }

  .rmap__label {
    font-family: var(--sb-font-sans);
    font-size: 15px;
    font-weight: 650;
    fill: var(--sb-charcoal);
  }

  .rmap__stop--home .rmap__label { font-weight: 800; }

  /* The drawing is the one piece of motion here; a reader who has asked for less
     gets the finished map immediately. */
  @media (prefers-reduced-motion: reduce) {
    .rmap__route { animation: none; stroke-dashoffset: 0; }
  }

  @media (max-width: 900px) {
    .rmap__inner { grid-template-columns: minmax(0, 1fr); }
    .rmap__label { font-size: 19px; }
  }
</style>

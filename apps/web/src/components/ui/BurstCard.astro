---
/**
 * BURST CARD — the card treatment from Parent Partnership §04, extracted.
 *
 * WHY THIS EXISTS. The design was built inside Comms.astro as `.ccard` and the
 * client asked for the same card on the Facilities KPI band. Copying it would
 * have meant two copies of a 3-D flip, a pointer-tracked bloom and a masked
 * ribbon — three things that are fiddly enough that the copies WOULD drift, and
 * the drift would only be visible with both pages open side by side. So the
 * chrome lives here once and both callers pass their own content in.
 *
 * WHAT THE CARD IS, in three layers:
 *
 *   ::before  a warm radial bloom that follows the pointer. The script at the
 *             foot writes --mx/--my as percentages; the fallback is the card's
 *             centre, so a coarse pointer or a failed script still gets a static
 *             glow rather than nothing.
 *
 *   ::after   shape-2.png used as a MASK, not an image. Measured, the file is
 *             1429×552 RGBA in which every opaque pixel is pure white — dropped
 *             on a white card it would render as nothing. Masking a gradient
 *             through it is what makes the line work visible. It is inked only
 *             over the card's right third and is transparent by 62%, so it never
 *             crosses the copy; at 0.18 opacity the body text still measures
 *             9.6:1.
 *
 *   badge     two faces of one disc — an index numeral and an icon — rotated
 *             180° apart with backface-visibility hidden, so hover flips
 *             between them instead of smearing both at once.
 *
 * The icon is a SLOT rather than a prop because the two callers use different
 * icon sets (AcademicGlyph and FacIcon) and neither should have to know about
 * the other.
 */
interface Props {
  /** 1-based; rendered zero-padded on the numeral face. */
  index: number;
  /** Element to render as — `li` inside a list, `div` otherwise. */
  as?: 'li' | 'div';
  class?: string;
  /** Minimum card height. Callers with denser content pass their own. */
  minHeight?: string;
  [key: string]: unknown;
}

const {
  index,
  as: Tag = 'li',
  class: className = '',
  minHeight = 'clamp(260px, 25vw, 350px)',
  ...rest
} = Astro.props;
---

<Tag class:list={['bcard', className]} style={`--bcard-min: ${minHeight};`} {...rest}>
  {/* Decorative throughout — the list already conveys sequence to a screen
      reader, and hearing "01" before every label is the numbering read twice. */}
  <span class="bcard__badge" aria-hidden="true">
    <span class="bcard__face bcard__face--n t-tabular">{String(index).padStart(2, '0')}</span>
    <span class="bcard__face bcard__face--i"><slot name="icon" /></span>
  </span>

  <slot />
</Tag>

<style>
  .bcard {
    position: relative;
    /* Contains the burst: it is a z-index:-1 pseudo, and without a stacking
       context of its own it would paint behind the card's white ground and be
       invisible. `overflow: hidden` keeps it inside the rounded corner. */
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: var(--bcard-min);
    padding: clamp(22px, 2.2vw, 32px);
    border: 1px solid rgba(201, 60, 10, 0.08);
    border-radius: clamp(20px, 2vw, 30px);
    background: #fff;
    box-shadow: 0 18px 44px -30px rgba(28, 14, 8, 0.34);
    transition:
      transform var(--sb-dur-image) var(--sb-ease),
      box-shadow var(--sb-dur-image) var(--sb-ease),
      border-color var(--sb-dur-image) var(--sb-ease);
  }

  .bcard:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 66px -30px rgba(28, 14, 8, 0.42);
    border-color: rgba(201, 60, 10, 0.2);
  }

  /* --- The burst ----------------------------------------------------------
     Only the OPACITY transitions. Transitioning the position too would make the
     bloom chase the cursor a beat behind, which reads as lag rather than light;
     it is repainted on the same frame as the pointer instead. */
  .bcard::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      clamp(140px, 16vw, 230px) circle at var(--mx, 50%) var(--my, 50%),
      rgba(255, 122, 74, 0.22) 0%,
      rgba(255, 138, 92, 0.09) 42%,
      rgba(255, 138, 92, 0) 72%
    );
    opacity: 0;
    transition: opacity 260ms var(--sb-ease);
    pointer-events: none;
  }

  .bcard:hover::before { opacity: 1; }

  /* --- The ribbon ---------------------------------------------------------- */
  .bcard::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(
      to left,
      var(--sb-lime) 0%,
      var(--sb-violet) 30%,
      rgba(201, 60, 10, 0) 62%
    );
    -webkit-mask-image: url('../../assets/icons/shape-2.png');
    mask-image: url('../../assets/icons/shape-2.png');
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    -webkit-mask-size: 202% 118%;
    mask-size: 202% 118%;
    -webkit-mask-position: 80% 100%;
    mask-position: 80% 100%;
    opacity: 0.18;
    transition:
      opacity var(--sb-dur-image) var(--sb-ease),
      transform var(--sb-dur-image) var(--sb-ease);
    pointer-events: none;
  }

  /* Leans in as the card lifts, scaled from its own bottom-right so it grows out
     of the corner it is anchored to rather than drifting across the card. */
  .bcard:hover::after {
    opacity: 0.34;
    transform: scale(1.07) rotate(-2deg);
    transform-origin: 100% 100%;
  }

  /* --- The flipping disc --------------------------------------------------- */

  .bcard__badge {
    position: relative;
    width: clamp(52px, 4.4vw, 64px);
    aspect-ratio: 1;
    flex-shrink: 0;
    transform-style: preserve-3d;
    transform: perspective(700px) rotateY(0deg);
    transition: transform 620ms var(--sb-ease);
  }

  .bcard:hover .bcard__badge { transform: perspective(700px) rotateY(180deg); }

  .bcard__face {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border-radius: var(--sb-r-full);
    /* Without this both faces paint at once and the disc reads as a smear. */
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .bcard__face--n {
    border: 1px solid var(--sb-border);
    background: #fff;
    font-family: var(--sb-font-display);
    font-size: clamp(19px, 1.7vw, 25px);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--sb-violet);
  }

  .bcard__face--i {
    transform: rotateY(180deg);
    border: 1px solid var(--sb-violet);
    background: var(--sb-violet);
    color: #fff;
  }

  /* A 3-D flip and a lift are both motion for its own sake. The card keeps its
     bloom and its ribbon, which are static, and stops moving. */
  @media (prefers-reduced-motion: reduce) {
    .bcard,
    .bcard__badge,
    .bcard::after { transition: none; }
    .bcard:hover { transform: none; }
    .bcard:hover .bcard__badge { transform: perspective(700px) rotateY(0deg); }
  }
</style>

<script>
  /**
   * The burst follows the pointer.
   *
   * ONLY WHERE THERE IS A POINTER TO FOLLOW. On a touch screen `:hover` sticks
   * after a tap and there is no pointermove to track, so the card would keep a
   * bloom frozen wherever the finger last landed. The media query gate means
   * those readers get the CSS fallback — the bloom centred, and only while the
   * card is actually hovered — rather than a stuck highlight.
   *
   * WRITES PERCENTAGES, NOT PIXELS, so the value survives a resize without this
   * having to listen for one.
   *
   * `getBoundingClientRect` on every pointermove is deliberately not cached: the
   * card MOVES on hover (it lifts 6px), so a rect measured once on enter would
   * be six pixels wrong for the whole interaction.
   */
  if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
    document.querySelectorAll<HTMLElement>('.bcard').forEach((card) => {
      card.addEventListener(
        'pointermove',
        (e) => {
          const r = card.getBoundingClientRect();
          card.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
          card.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
        },
        { passive: true }
      );

      // Back to centre on the way out, so the next hover starts from the card's
      // middle rather than from wherever the pointer happened to leave.
      card.addEventListener('pointerleave', () => {
        card.style.removeProperty('--mx');
        card.style.removeProperty('--my');
      });
    });
  }
</script>

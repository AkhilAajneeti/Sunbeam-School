---
/**
 * DEVELOPMENT ASSET PLACEHOLDER
 *
 * Every photograph on this site is an outstanding client asset (docs/07 § A2).
 * Placeholder policy, docs/07: "Placeholders are deliberately obvious. They are
 * never filled with stock photography."
 *
 * So this renders a flat tonal field at the correct ratio, carrying the exact
 * shot brief. The tone approximates the intended photograph's luminance so that
 * overlaid typography can be contrast-judged before the real image arrives.
 *
 * Replace with <Picture> from astro:assets when photography is delivered.
 */
interface Props {
  /** CSS aspect-ratio, e.g. '16 / 9'. Omit to fill the parent (absolute). */
  ratio?: string;
  /** Approximates the final photograph's luminance. */
  tone?: 'ink' | 'charcoal' | 'maroon' | 'sand' | 'ivory';
  /** The shot brief. Becomes the visible label and the alt-text stand-in. */
  brief: string;
  /** Asset-request id from docs/07, e.g. 'A2 · Priority 1'. */
  ref?: string;
  /** Hide the label where it would wreck a composition being reviewed. */
  quiet?: boolean;
  class?: string;
}

const {
  ratio,
  tone = 'charcoal',
  brief,
  ref = 'A2',
  quiet = false,
  class: className = '',
} = Astro.props;
---

<div
  class:list={['ph', `ph--${tone}`, quiet && 'ph--quiet', className]}
  style={ratio ? `aspect-ratio: ${ratio};` : undefined}
  data-asset-placeholder={ref}
  role="img"
  aria-label={`Placeholder for photography not yet supplied: ${brief}`}
>
  <div class="ph__grid" aria-hidden="true"></div>
  {!quiet && (
    <div class="ph__label">
      <span class="ph__tag t-label">Needed · {ref}</span>
      <span class="ph__brief">{brief}</span>
    </div>
  )}
</div>

<style>
  .ph {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--sb-r-0); /* photography is square-cornered — I5 */
    background: var(--ph-bg);
    color: var(--ph-fg);
    display: flex;
    align-items: flex-end;
  }

  /* Tonal fields — chosen to sit where the real photograph's value will sit. */
  .ph--ink       { --ph-bg: #1a1715; --ph-fg: rgba(255, 255, 255, 0.62); --ph-line: rgba(255, 255, 255, 0.07); }
  .ph--charcoal  { --ph-bg: #2a2522; --ph-fg: rgba(255, 255, 255, 0.60); --ph-line: rgba(255, 255, 255, 0.06); }
  .ph--maroon    { --ph-bg: #2e100e; --ph-fg: rgba(255, 255, 255, 0.62); --ph-line: rgba(255, 255, 255, 0.07); }
  .ph--sand      { --ph-bg: #e8e0d4; --ph-fg: rgba(28, 25, 23, 0.55);    --ph-line: rgba(28, 25, 23, 0.07); }
  .ph--ivory     { --ph-bg: #f1ebe1; --ph-fg: rgba(28, 25, 23, 0.50);    --ph-line: rgba(28, 25, 23, 0.06); }

  /* A fine rule grid — reads unmistakably as "not a photograph". */
  .ph__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--ph-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--ph-line) 1px, transparent 1px);
    background-size: 48px 48px;
  }

  .ph__label {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sb-3);
    padding: var(--sb-6);
    max-width: 46ch;
  }

  .ph__tag {
    color: var(--sb-gold);
    display: block;
  }

  .ph--sand .ph__tag,
  .ph--ivory .ph__tag {
    color: var(--sb-maroon);
  }

  .ph__brief {
    font-size: var(--sb-body-sm);
    line-height: 1.5;
    color: var(--ph-fg);
  }

  @media (max-width: 767px) {
    .ph__label { padding: var(--sb-5); }
    .ph__brief { font-size: var(--sb-caption); }
    .ph__grid  { background-size: 32px 32px; }
  }
</style>

---
/**
 * DOWNLOAD TRANSFER CERTIFICATE — two sections.
 *
 * ⚠⚠ THE LOOKUP BELONGS TO THE SCHOOL'S OWN SITE, AND THIS PAGE DOES NOT FAKE
 * IT. The school's /download-tc/ page runs `<form id="roll-lookup-form">` with a
 * `roll_search` field, handled by that installation's own script. No endpoint is
 * reachable from this project, and the brief is explicit: do not mock the API
 * response. So `tcEndpoint` is null, the field validates for real, and the form
 * then hands the reader to the school's page where the search actually works.
 * Set the endpoint in data/services.ts and this same form posts to it.
 *
 * ⚠ THE FIELD NAME MATCHES THE SCHOOL'S — `roll_search` — so wiring the real
 * handler needs no change here.
 *
 * ⚠ NO SECURITY LINE UNDER THE BUTTON. The reference art carried "Your
 * information is secure and will not be shared." Nothing this project controls
 * makes that true, and the brief says not to claim it unless the existing
 * application supports the wording. What sits there instead is a statement of
 * where the search runs.
 *
 * ⚠ NOT CLAIMED ANYWHERE: eligibility, fees, processing time, or what the
 * certificate contains.
 *
 * ═══ COMPOSITION ═══════════════════════════════════════════════════════════
 *   01 · IVORY  photograph left, the search card right.
 *   02 · PAPER  the four-item help strip.
 */
import { Picture } from 'astro:assets';
import '../../styles/assessment.css';
import { MARK } from '../academics/assessment/marks';
import { tcEndpoint, tcField, tcSourcePage, tcHelp } from '../../data/services';
import { school } from '../../data/site';

import pCampus from '../../assets/photos/sunbeem-1.jpg';

const S = 'Sunbeam School Ballia';
---

{/* ══ 01 · THE SEARCH ════════════════════════════════════════════════════════ */}
<section class="as-sec as-sec--ivory as-pad tc-main" aria-labelledby="tc-main-t">
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container tc-grid">
    <div class="tc-pic" data-mask>
      <Picture
        src={pCampus}
        alt={`The main building of ${S} at Agarsanda, seen across its front lawn.`}
        formats={['webp']}
        widths={[520, 860, 1200]}
        sizes="(max-width: 1023px) 92vw, 42vw"
        loading="eager"
        decoding="async"
      />
    </div>

    <div class="tc-card">
      <div class="tc-card__head">
        <span class="tc-card__m" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.download} />
          </svg>
        </span>
        <div>
          <h2 class="tc-card__h" id="tc-main-t">Download Transfer Certificate</h2>
          <p class="tc-card__v">Please enter the enrolment number provided at the time of admission.</p>
        </div>
      </div>

      <form class="tc-form" novalidate data-tc data-endpoint={tcEndpoint ?? ''} data-fallback={tcSourcePage}>
        <p class="tc-field">
          <label class="tc-lab" for="tc-roll">Enrolment number</label>
          <span class="tc-inwrap">
            <input
              id="tc-roll"
              name={tcField}
              type="text"
              inputmode="numeric"
              placeholder="Enter enrolment number"
              autocomplete="off"
              aria-describedby="tc-err tc-status"
            />
            <span class="tc-inm" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.person} />
              </svg>
            </span>
          </span>
          <span class="tc-err" id="tc-err" data-tc-err></span>
        </p>

        <p class="tc-act">
          <button type="submit" class="tc-btn" data-tc-submit>
            <span data-tc-label>Search</span>
            <span class="tc-spin" aria-hidden="true"></span>
          </button>
        </p>

        {/* ⚠ WHERE THE SEARCH RUNS — not a security promise. See the header. */}
        <p class="tc-note">
          <span class="tc-note__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.shield} />
            </svg>
          </span>
          The certificate search runs on the school’s own records system.
        </p>

        <p class="tc-status" id="tc-status" role="status" aria-live="polite" data-tc-status></p>
      </form>
    </div>
  </div>
</section>

{/* ══ 02 · THE HELP STRIP ════════════════════════════════════════════════════ */}
<section class="as-sec as-sec--paper as-pad--sm tc-help" aria-labelledby="tc-help-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container">
    <h2 class="tc-help__h" id="tc-help-t">Important information</h2>
    <span class="tc-rule" aria-hidden="true"></span>

    <ul class="tc-items">
      {tcHelp.map((h, i) => (
        <li class="tc-item" data-reveal data-reveal-delay={110 + i * 80}>
          <span class="tc-item__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[h.mark]} />
            </svg>
          </span>
          <span class="tc-item__n t-tabular">{h.n}</span>
          <h3 class="tc-item__k">{h.k}</h3>
          <p class="tc-item__v">{h.v}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-tc]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('input[type="text"]');
    const err = form.querySelector<HTMLElement>('[data-tc-err]');
    const status = form.querySelector<HTMLElement>('[data-tc-status]');
    const btn = form.querySelector<HTMLButtonElement>('[data-tc-submit]');
    const label = form.querySelector<HTMLElement>('[data-tc-label]');
    const endpoint = form.dataset.endpoint || '';
    const fallback = form.dataset.fallback || '';
    let busy = false;

    const setErr = (msg: string) => {
      if (err) { err.textContent = msg; err.classList.toggle('is-on', Boolean(msg)); }
      input?.setAttribute('aria-invalid', msg ? 'true' : 'false');
      form.classList.toggle('has-err', Boolean(msg));
    };

    const check = () => {
      const v = (input?.value ?? '').trim();
      if (!v) return 'Please enter your enrolment number.';
      /* Deliberately loose — the school's numbering is not published, so this
         catches an empty or obviously wrong entry and nothing more. */
      if (v.length < 3) return 'That enrolment number looks too short.';
      return '';
    };

    input?.addEventListener('input', () => { if (input.getAttribute('aria-invalid') === 'true') setErr(check()); });

    const setBusy = (on: boolean) => {
      busy = on;
      form.classList.toggle('is-busy', on);
      if (btn) { btn.disabled = on; btn.setAttribute('aria-busy', on ? 'true' : 'false'); }
      if (label) label.textContent = on ? 'Searching…' : 'Search';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (busy) return;

      const msg = check();
      setErr(msg);
      if (msg) { input?.focus(); return; }

      /* ⚠ NO ENDPOINT — HAND OVER, DO NOT PRETEND. The school's own T.C. page
         has the working lookup, so the reader is sent somewhere that can
         actually answer instead of being shown a fabricated result. */
      if (!endpoint) {
        if (status) {
          status.innerHTML =
            'This search is handled by the school’s own records system. ' +
            `<a href="${fallback}" target="_blank" rel="noopener noreferrer">Continue on the school’s Transfer Certificate page</a> ` +
            'to look up your certificate, or call the office on ' +
            '<a href="tel:' + '+917755005905' + '">+91 77550 05905</a>.';
          status.className = 'tc-status is-note';
          status.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
        return;
      }

      setBusy(true);
      try {
        const url = new URL(endpoint);
        url.searchParams.set(input!.name, (input!.value ?? '').trim());
        const res = await fetch(url.toString(), { headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        const data = await res.json();
        if (status) {
          /* ⚠ WHATEVER THE BACKEND RETURNS IS WHAT IS SHOWN. Nothing about the
             certificate is composed here. */
          if (data && data.url) {
            status.innerHTML = `Certificate found. <a href="${data.url}" target="_blank" rel="noopener noreferrer">View or download it</a>.`;
            status.className = 'tc-status is-ok';
          } else {
            status.textContent = 'No certificate was found for that enrolment number. Please check it and try again.';
            status.className = 'tc-status is-err';
          }
        }
      } catch {
        if (status) {
          status.textContent = 'That search could not be completed just now. Please try again, or contact the school office.';
          status.className = 'tc-status is-err';
        }
      } finally {
        setBusy(false);
        status?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });
  });
</script>

<style>
  /* ═══ 01 · THE SEARCH ═════════════════════════════════════════════════════ */
  .tc-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(24px, 3.2vw, 54px);
    align-items: center;
  }
  .tc-pic { overflow: hidden; border-radius: var(--sb-r-3); box-shadow: var(--sb-shadow-card); }
  .tc-pic :global(picture) { display: block; }
  .tc-pic :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 12; object-fit: cover; transition: scale 600ms var(--sb-ease); }
  .tc-pic:hover :global(img) { scale: 1.03; }

  .tc-card {
    padding: clamp(20px, 2.6vw, 34px) clamp(19px, 2.4vw, 32px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-3);
    background: var(--sb-paper);
    box-shadow: 0 24px 54px -34px rgba(28, 14, 8, 0.34);
  }
  .tc-card__head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(12px, 1.5vw, 18px); align-items: center; }
  .tc-card__m {
    display: grid;
    place-items: center;
    width: clamp(44px, 4vw, 58px);
    aspect-ratio: 1 / 1;
    border-radius: var(--sb-r-2);
    background: var(--sb-violet-wash);
    color: var(--sb-orange-bright);
  }
  .tc-card__m svg { width: 50%; height: auto; }
  .tc-card__h {
    margin: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(16px, 1.5vw, 25px);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--sb-charcoal);
  }
  .tc-card__v { margin: 4px 0 0; font-size: clamp(9.8px, 0.74vw, 11.6px); line-height: 1.6; color: var(--sb-text-muted); }

  .tc-form { margin: clamp(18px, 2.2vw, 28px) 0 0; }
  .tc-field { display: grid; gap: 6px; margin: 0; }
  .tc-lab { font-size: clamp(9.8px, 0.74vw, 11.6px); font-weight: 700; color: var(--sb-text-secondary); }
  .tc-inwrap { position: relative; display: block; }
  .tc-inwrap input {
    width: 100%;
    padding: clamp(11px, 1.25vw, 15px) clamp(38px, 3.6vw, 46px) clamp(11px, 1.25vw, 15px) clamp(13px, 1.5vw, 17px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-ivory);
    font: inherit;
    font-size: clamp(11px, 0.82vw, 13px);
    color: var(--sb-charcoal);
    transition: border-color 200ms var(--sb-ease), box-shadow 200ms var(--sb-ease);
  }
  .tc-inwrap input::placeholder { color: var(--sb-text-muted); }
  .tc-inwrap input:focus-visible {
    outline: none;
    border-color: var(--sb-orange-bright);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sb-orange-bright) 18%, transparent);
  }
  .has-err .tc-inwrap input { border-color: #b3341a; }
  .tc-inm { position: absolute; top: 50%; right: clamp(13px, 1.4vw, 17px); translate: 0 -50%; display: block; width: clamp(15px, 1.3vw, 18px); color: var(--sb-text-muted); pointer-events: none; }
  .tc-inm svg { display: block; width: 100%; height: auto; }
  .tc-err { display: none; font-size: clamp(9px, 0.68vw, 10.8px); line-height: 1.5; color: #b3341a; }
  .tc-err.is-on { display: block; }

  .tc-act { margin: clamp(12px, 1.5vw, 18px) 0 0; }
  .tc-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    width: 100%;
    padding: clamp(12px, 1.35vw, 16px) clamp(20px, 2.2vw, 28px);
    border: 0;
    border-radius: var(--sb-r-2);
    background: var(--sb-orange-bright);
    font: inherit;
    font-size: clamp(11.5px, 0.86vw, 13.6px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #fff;
    cursor: pointer;
    transition: background 220ms var(--sb-ease), transform 220ms var(--sb-ease);
  }
  .tc-btn:hover:not(:disabled) { transform: translateY(-1px); background: var(--sb-violet); }
  .tc-btn:disabled { opacity: 0.8; cursor: progress; }
  .tc-spin {
    display: none;
    width: 14px;
    height: 14px;
    border: 2px solid rgba(255, 255, 255, 0.42);
    border-top-color: #fff;
    border-radius: 50%;
    animation: tc-turn 700ms linear infinite;
  }
  .is-busy .tc-spin { display: block; }
  @keyframes tc-turn { to { transform: rotate(360deg); } }

  .tc-note { display: flex; align-items: center; justify-content: center; gap: 7px; margin: clamp(10px, 1.2vw, 14px) 0 0; font-size: clamp(8.8px, 0.66vw, 10.4px); color: var(--sb-text-muted); }
  .tc-note__m { display: block; width: 13px; color: var(--sb-text-muted); }
  .tc-note__m svg { display: block; width: 100%; height: auto; }

  .tc-status {
    display: none;
    margin: clamp(12px, 1.5vw, 18px) 0 0;
    padding: clamp(11px, 1.3vw, 15px) clamp(12px, 1.5vw, 17px);
    border: 1px solid var(--sb-border-strong);
    border-left: 3px solid var(--sb-border-strong);
    border-radius: var(--sb-r-2);
    font-size: clamp(9.6px, 0.72vw, 11.4px);
    line-height: 1.68;
    color: var(--sb-text-secondary);
  }
  .tc-status.is-note, .tc-status.is-ok, .tc-status.is-err { display: block; }
  .tc-status.is-note { border-left-color: var(--sb-orange-bright); background: var(--sb-violet-wash); }
  .tc-status.is-ok { border-left-color: #2f7d4f; background: #eef7f1; color: #205537; }
  .tc-status.is-err { border-left-color: #b3341a; background: #fdf0ec; color: #8a2a15; }
  .tc-status :global(a) { color: var(--sb-violet); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .tc-status :global(a:hover) { color: var(--sb-orange-bright); }

  /* ═══ 02 · THE HELP STRIP ═════════════════════════════════════════════════ */
  .tc-help { text-align: center; }
  .tc-help__h {
    margin: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(15px, 1.35vw, 22px);
    font-weight: 700;
    letter-spacing: -0.032em;
    color: var(--sb-charcoal);
  }
  .tc-rule { display: block; width: clamp(34px, 3.4vw, 46px); height: 3px; margin: clamp(9px, 1.1vw, 14px) auto 0; border-radius: 3px; background: var(--sb-orange-bright); }

  .tc-items {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: clamp(22px, 2.8vw, 36px) 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .tc-item { display: grid; align-content: start; padding: clamp(4px, 0.6vw, 8px) clamp(14px, 2vw, 26px); }
  .tc-item:first-child { padding-left: 0; }
  .tc-item:last-child { padding-right: 0; }
  .tc-item + .tc-item { border-left: 1px solid var(--sb-border); }
  .tc-item__m { display: block; width: clamp(24px, 2.2vw, 31px); color: var(--sb-orange-bright); }
  .tc-item__m svg { display: block; width: 100%; height: auto; }
  .tc-item__n { margin-top: clamp(9px, 1.1vw, 14px); font-size: clamp(8.6px, 0.64vw, 10.2px); font-weight: 700; letter-spacing: 0.14em; color: var(--sb-orange-bright); }
  .tc-item__k {
    margin: 4px 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(11.5px, 0.9vw, 14.4px);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .tc-item__v { margin: clamp(6px, 0.8vw, 9px) 0 0; font-size: clamp(9px, 0.68vw, 10.8px); line-height: 1.62; color: var(--sb-text-muted); }

  @media (prefers-reduced-motion: reduce) {
    .tc-spin { animation-duration: 2s; }
    .tc-pic :global(img) { transition: none; }
  }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1023px) {
    .tc-grid { grid-template-columns: minmax(0, 1fr); }
    .tc-items { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: clamp(20px, 3vw, 28px); }
    .tc-item:nth-child(odd) { padding-left: 0; border-left: 0; }
    .tc-item:nth-child(even) { padding-right: 0; }
  }

  @media (max-width: 559px) {
    .tc-items { grid-template-columns: minmax(0, 1fr); }
    .tc-item { padding: 0 !important; border-left: 0 !important; }
    .tc-item + .tc-item { padding-top: clamp(18px, 4vw, 24px) !important; border-top: 1px solid var(--sb-border); }
  }
</style>

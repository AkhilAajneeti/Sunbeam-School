---
/**
 * "WHY THIS MATTERS" — the centred heading and the row of reason cards, shared
 * by the Parents' Forum and School–Parent Communication pages.
 *
 * ⚠ IT COUNTS ITS OWN ITEMS. `grid-template-columns` comes from the array's
 * length, so four reasons or six lay out correctly without a second component
 * and without a magic number in the CSS.
 *
 * ⚠ THE CARDS CARRY NO NUMBER. Numbered cards imply a sequence, and these are
 * five parallel reasons rather than five steps — the numbered treatment belongs
 * to the agenda, which really is a list in the school's own order.
 */
import '../../../styles/assessment.css';
import { MARK } from '../assessment/marks';

interface Item {
  readonly n: string;
  readonly mark: string;
  readonly k: string;
  readonly v: string;
}

interface Props {
  /** Heading, in two halves — the second is set orange. */
  lead: string;
  accent: string;
  items: readonly Item[];
  id: string;
}

const { lead, accent, items, id } = Astro.props;
---

<section class="as-sec as-sec--paper as-pad--sm pp-why" aria-labelledby={id}>
  <div class="u-container">
    <h2 class="as-h as-h--md pp-why__h" id={id}>
      <span data-clip data-clip-delay="0">{lead}</span>
      {' '}<span data-clip data-clip-delay="140"><em>{accent}</em></span>
    </h2>
    <span class="pp-why__rule" aria-hidden="true" data-draw></span>

    <ul class="pp-why__list" style={`--n: ${items.length};`}>
      {items.map((it, i) => (
        <li class="pp-card" data-pop data-pop-delay={120 + i * 80}>
          <span class="pp-card__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[it.mark]} />
            </svg>
          </span>
          <h3 class="pp-card__k">{it.k}</h3>
          <p class="pp-card__v">{it.v}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .pp-why { text-align: center; }
  .pp-why__h { margin-top: 0; }
  .pp-why__h em { color: var(--sb-orange-bright); font-style: normal; }
  .pp-why__h > span { display: inline; }

  /* The short orange rule under the heading, drawn on scroll. */
  .pp-why__rule {
    display: block;
    width: clamp(38px, 4vw, 56px);
    height: 2px;
    margin: clamp(10px, 1.2vw, 15px) auto 0;
    border-radius: 2px;
    background: var(--sb-orange-bright);
  }

  .pp-why__list {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 20px);
    margin: clamp(22px, 2.8vw, 38px) 0 0;
    padding: 0;
    list-style: none;
    text-align: left;
  }
  .pp-card {
    display: grid;
    align-content: start;
    justify-items: center;
    padding: clamp(16px, 1.9vw, 24px) clamp(13px, 1.5vw, 19px) clamp(18px, 2.1vw, 26px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: 0 4px 16px -12px rgba(28, 14, 8, 0.16);
    text-align: center;
    transition: transform var(--sb-dur-image) var(--sb-ease), border-color var(--sb-dur-image) var(--sb-ease), box-shadow var(--sb-dur-image) var(--sb-ease);
  }
  .pp-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--sb-orange-bright) 42%, transparent);
    box-shadow: var(--sb-shadow-card);
  }
  .pp-card__m { display: block; width: clamp(26px, 2.4vw, 34px); color: var(--sb-orange-bright); }
  .pp-card__m svg { display: block; width: 100%; height: auto; }
  .pp-card__k {
    margin: clamp(11px, 1.4vw, 17px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(12px, 0.96vw, 15px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .pp-card__v {
    margin: clamp(6px, 0.8vw, 10px) 0 0;
    font-size: clamp(9.5px, 0.7vw, 11px);
    line-height: 1.62;
    color: var(--sb-text-muted);
  }

  @media (max-width: 1023px) {
    .pp-why__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 767px) {
    .pp-why__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 479px) {
    .pp-why__list { grid-template-columns: minmax(0, 1fr); }
  }
</style>

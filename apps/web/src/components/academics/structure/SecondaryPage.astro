      </div>
    </div>
  </div>
</section>

<script>
  /* THE JOURNEY RULE DRAWS ITSELF. Decoration only — the dashed rule beneath is
     always painted, so with this script absent nothing is lost but the
     travelling line. `pathLength="1"` keeps the maths in fractions. */
  const scTrack = document.querySelector('.sc-jrn__track');
  const scRule = document.querySelector('.sc-jrn__draw');

  if (scTrack instanceof HTMLElement && scRule instanceof SVGPathElement
    && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;

    const paint = () => {
      queued = false;
      const r = scTrack.getBoundingClientRect();
      const travelled = window.innerHeight * 0.86 - r.top;
      const p = Math.min(1, Math.max(0, travelled / Math.max(1, r.height * 0.85)));
      scRule.style.strokeDashoffset = String(1 - p);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  }
</script>


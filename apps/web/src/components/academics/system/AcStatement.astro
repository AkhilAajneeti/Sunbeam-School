---
import '../../../styles/academics.css';
/**
 * AcStatement — a page's one loud sentence, set at poster scale.
 *
 * Typography-led: the statement IS the section, the prose is deliberately small
 * and pushed into a column beside or beneath it, and the rest is air. Use it
 * once per page. A page with two poster statements has neither.
 *
 * `portrait` rises into the statement's last line rather than sitting beside it
 * — the overlap is the composition. `ghost` sets a word at poster scale behind
 * everything at almost the ground's own value.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  kicker?: string;
  /** The statement. `<br />` for line breaks, `<em>` for the accent colour. */
  statement: string;
  body?: string[];
  ground?: 'ivory' | 'paper' | 'sand' | 'ink';
  /** A portrait overlapping the statement, right-hand column at 900+. */
  portrait?: ImageMetadata;
  portraitAlt?: string;
  /** A credit line under the portrait — kept OUTSIDE the clipped frame. */
  caption?: string;
  /** A word set huge behind the section. */
  ghost?: string;
  ghostAt?: 'left' | 'right';
  id?: string;
  texture?: boolean;
}

const {
  kicker, statement, body = [], ground = 'ivory',
  portrait, portraitAlt, caption, ghost, ghostAt = 'left', id, texture = false,
} = Astro.props;

const headingId = id ?? `acst-${Math.abs(statement.length * 6151 % 9973)}`;
---

<section class={`ac-section ac--${ground} acst`} aria-labelledby={headingId}>
  {texture && <span class={ground === 'ink' ? 'ac-dots-bg' : 'ac-grid-bg'} aria-hidden="true"></span>}
  {ghost && <span class={`ac-ghost acst__ghost acst__ghost--${ghostAt}`} aria-hidden="true">{ghost}</span>}

  <div class="u-container acst__in">
    {kicker && <p class="ac-micro acst__k" data-reveal>{kicker}</p>}
    <h2 class="ac-poster acst__h" id={headingId} data-split set:html={statement} />

    {portrait && (
      <figure class="acst__art">
        {/* ⚠ THE CROP IS ON THIS SPAN, NOT THE <figure>. data-zoom scales the
            image and needs its own element to clip; clipping the figure took the
            caption with it and the credit line disappeared. */}
        <span class="ac-frame ac-frame--soft acst__frame" data-mask data-zoom data-zoom-to="1.14">
          <Picture
            src={portrait}
            alt={portraitAlt ?? ''}
            formats={['avif', 'webp']}
            widths={[320, 640]}
            sizes="(max-width: 900px) 58vw, 300px"
            loading="lazy"
            decoding="async"
          />
        </span>
        {caption && <figcaption class="ac-caption">{caption}</figcaption>}
      </figure>
    )}

    <div class="acst__copy">
      {body.map((p, i) => <p class="ac-body" data-reveal data-reveal-delay={160 + i * 70} set:html={p} />)}
      <slot />
    </div>
  </div>
</section>

<style>
  .acst__in { position: relative; z-index: 1; }

  .acst__ghost--left { left: -0.06em; bottom: -0.12em; }
  .acst__ghost--right { right: -0.06em; bottom: -0.12em; }

  .acst__art { margin: clamp(20px, 3vw, 32px) 0 0; width: min(58vw, 300px); }
  .acst__frame { display: block; aspect-ratio: 3 / 4; }
  .acst__copy { margin-top: clamp(20px, 2.8vw, 32px); }

  @media (min-width: 900px) {
    .acst__in {
      display: grid;
      grid-template-columns: minmax(0, 1fr) min(30vw, 300px);
      column-gap: clamp(32px, 4.6vw, 76px);
      align-items: start;
    }
    .acst__k { grid-column: 1 / -1; }
    .acst__h { grid-column: 1; }
    /* Rises into the statement's last line — the overlap is the point. */
    .acst__art {
      grid-column: 2;
      grid-row: 2 / span 2;
      width: 100%;
      margin-top: clamp(-96px, -8vw, -40px);
      align-self: start;
    }
    .acst__copy { grid-column: 1; max-width: 56ch; margin-top: clamp(22px, 3vw, 34px); }
  }

  @media (max-width: 899px) {
    .acst__art { margin-left: auto; }
  }
</style>

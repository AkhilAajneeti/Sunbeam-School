---
import '../../../styles/academics.css';
/**
 * AcSplit — copy on one side, one photograph on the other.
 *
 * The workhorse, and the one most at risk of turning forty-nine pages into one
 * page. It is therefore deliberately variable: `ground` picks the band colour,
 * `side` decides which half the photograph takes, `ratio` widens the copy, and
 * `inset` adds a second frame overlapping the first. Two pages using AcSplit
 * with different values do not read as the same section.
 *
 * ⚠ `side` FLIPS THE VISUAL ORDER, NOT THE DOM ORDER. The copy is always first
 * in the source, so a screen reader and a keyboard meet the heading before the
 * photograph regardless of which side it is drawn on.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Tracked label above the heading. Optional — not every section wants one. */
  kicker?: string;
  /** The heading. `<em>` inside it takes the accent colour. */
  heading: string;
  /** Paragraphs. HTML allowed — `<strong>` and `<em>` are styled. */
  body?: string[];
  photo: ImageMetadata;
  alt: string;
  /** A second, smaller frame overlapping the first. */
  inset?: ImageMetadata;
  insetAlt?: string;
  ground?: 'ivory' | 'paper' | 'sand' | 'ink';
  /** Which side the photograph is drawn on. */
  side?: 'right' | 'left';
  ratio?: 'even' | 'wide';
  /** Frame shape — the same primitive should not always be a rounded rectangle. */
  shape?: 'default' | 'soft' | 'leaf';
  /** Aspect of the main frame. */
  aspect?: string;
  id?: string;
  /** Draw the faint grid behind (light grounds) or the dot field (ink). */
  texture?: boolean;
}

const {
  kicker, heading, body = [], photo, alt, inset, insetAlt,
  ground = 'ivory', side = 'right', ratio = 'even',
  shape = 'default', aspect = '4 / 3', id, texture = false,
} = Astro.props;

const headingId = id ?? `ac-${Math.abs(heading.length * 7919 % 9973)}`;
const shapeClass = shape === 'default' ? '' : ` ac-frame--${shape}`;
---

<section class={`ac-section ac--${ground} acs`} aria-labelledby={headingId}>
  {texture && <span class={ground === 'ink' ? 'ac-dots-bg' : 'ac-grid-bg'} aria-hidden="true"></span>}

  <div class={`u-container ac-split${side === 'left' ? ' ac-split--flip' : ''}${ratio === 'wide' ? ' ac-split--wide' : ''}`}>
    <div class="acs__copy">
      {kicker && <p class="ac-micro" data-reveal>{kicker}</p>}
      <h2 class="ac-lede" id={headingId} data-split set:html={heading} />
      {body.map((p, i) => <p class="ac-body" data-reveal data-reveal-delay={140 + i * 80} set:html={p} />)}
      <slot name="under" />
    </div>

    <div class="acs__stage">
      <figure class={`ac-frame${shapeClass} acs__a`} style={`aspect-ratio: ${aspect};`} data-mask data-zoom>
        <Picture
          src={photo}
          alt={alt}
          formats={['webp']}
          widths={[520, 900]}
          sizes="(max-width: 900px) 92vw, 46vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      {inset && (
        <figure class="ac-frame ac-frame--soft ac-frame--mount acs__b" data-reveal data-reveal-delay="180" data-zoom data-zoom-to="1.16">
          <Picture
            src={inset}
            alt={insetAlt ?? ''}
            formats={['webp']}
            widths={[300, 620]}
            sizes="(max-width: 900px) 48vw, 22vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  .acs__stage { position: relative; }

  /* The inset overlaps the main frame's lower corner and steps outside the
     column — an overlap, not a second picture in a row. */
  .acs__b {
    position: relative;
    z-index: 2;
    width: 46%;
    margin: -16% auto 0 0;
    aspect-ratio: 3 / 4;
  }

  @media (min-width: 900px) {
    /* On a flipped split the inset moves to the opposite corner too, so the
       composition mirrors properly rather than half-mirroring. */
    :global(.ac-split--flip) .acs__b { margin-inline: auto 0; }
  }

  @media (max-width: 899px) {
    .acs__b { width: 52%; margin-top: -14%; }
  }
</style>

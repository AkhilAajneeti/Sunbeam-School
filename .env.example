# ═══════════════════════════════════════════════════════════════════════════
# SUNBEAM SCHOOL BALLIA — ROOT ENVIRONMENT TEMPLATE
#
# Copy to .env and fill in. .env is gitignored; this file is committed and must
# never contain a real secret.
#
#     cp .env.example .env
#
# ⚠ THERE ARE TWO .env FILES IN THIS REPO, ON PURPOSE.
#
#     .env           this one — docker-compose (creates the database) and the
#                    Astro build (reads from Strapi)
#     apps/cms/.env  Strapi's own — its secrets and its database connection
#
#   DATABASE_PASSWORD must be IDENTICAL in both. This file creates the Postgres
#   role; that one authenticates against it. Nothing warns you if they drift —
#   Strapi just fails to connect.
#
# ⚠ PRODUCTION USES DIFFERENT VALUES. Reusing a development secret in
#   production means anyone who has cloned the repo holds the key that signs the
#   school's admin sessions.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Postgres — consumed by docker-compose.yml ──────────────────────────────
# Generate a password with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DATABASE_NAME=sunbeam
DATABASE_USERNAME=sunbeam
DATABASE_PASSWORD=replace-me
DATABASE_PORT=5432

# ─── Astro → Strapi — consumed by apps/web at BUILD time ────────────────────
# Per decision D3 this is a build-time dependency only: visitors never reach
# Strapi, so this does not need to be public — only reachable from wherever the
# build runs.
STRAPI_URL=http://127.0.0.1:1337
# Read-only API token. Strapi admin → Settings → API Tokens → Create new,
# token type "Read-only". Paste the value here; it is shown once.
STRAPI_TOKEN=replace-me

---
/**
 * STUDENT COUNCIL — /beyond-academics/student-council/
 *
 * ⚠⚠ THE CONTENT IS THE SCHOOL'S OWN, transcribed from its printed
 * "COUNCIL MEMBERS 2026-27" board, supplied 22 September 2026. FORTY-FIVE
 * named students — 29 senior, 16 junior — and the board itself is shown whole
 * above the lists.
 *
 * ⚠ THIS REPLACED AN EARLIER 34-NAME LIST read off the school's website on
 * 16 Sep 2026, which names a different council entirely. Why the board is
 * treated as the newer record, and what it settled ("Prefect", not "Perfect";
 * "Goel", not "Goal"), is set out in full at the top of data/studentCouncil.ts.
 * Read that before changing anything here.
 *
 * ⚠ THE BANNER IS THE SCHOOL'S OWN INVESTITURE PHOTOGRAPH — banner7, the
 * office-bearers on the hall steps with the house flags, which is literally
 * this page's subject. It is also slide 8 of the homepage hero; a photograph
 * earning its place twice is not a duplicate.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import StudentCouncilPage from '../../components/beyond/council/StudentCouncilPage.astro';

import banner from '../../assets/banners/banner7.jpg';
---

<BaseLayout
  title="Student Council — Sunbeam School Ballia"
  description="The student office-bearers of Sunbeam School Ballia for 2026-27 — the senior and junior councils, the captains of Love, Joy and Hope House, and every post the school appoints."
>
  <PageHero
    title="Student Council"
    standfirst="The students who hold office, and the posts they hold."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Beyond Academics', href: '/beyond-academics/sports/' },
    ]}
    src={banner}
    alt="Student office-bearers of Sunbeam School Ballia on the hall steps with the house flags at the investiture ceremony."
    position="50% 40%"
  />

  <StudentCouncilPage />
</BaseLayout>

---
/**
 * ESSENTIAL INFORMATION · DOWNLOAD T.C.
 *
 * The transfer-certificate lookup runs on the school's own records system. This
 * page reproduces its form — same field name, `roll_search` — validates the
 * entry, and hands over to the school's page rather than mocking a result.
 * Point `tcEndpoint` in data/services.ts at the real handler and the same form
 * posts to it and renders whatever it returns.
 *
 * No eligibility rule, fee, processing time or privacy guarantee is stated: the
 * school publishes none of them.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import TcPage from '../components/services/TcPage.astro';

import banner from '../assets/photos/sunbeem-1.jpg';
---

<BaseLayout
  title="Download Transfer Certificate — Sunbeam School Ballia"
  description="Enter your enrolment number to check and download your Transfer Certificate from Sunbeam School Ballia."
>
  <PageHero
    title="Get Your Transfer Certificate"
    standfirst="Enter your enrolment number to check and download your Transfer Certificate."
    crumbs={[
      { label: 'Home', href: '/' },
      /* ⚠ THE MIDDLE CRUMB IS GONE ON PURPOSE. It read 'Essential
         Information' but pointed at /admissions/ — a label and a
         destination that never matched. There IS no
         /essential-information/ landing page; it is a menu heading only.
         Once /admissions/ became /admission-notice/, following that crumb
         would have dropped the reader on an admission notice from a page
         about something else, so the bogus level is dropped rather than
         repointed. Restore it the day the section gets a real page. */
    ]}
    src={banner}
    alt="The main building of Sunbeam School Ballia at Agarsanda, seen across its front lawn."
    position="50% 46%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <TcPage />
  </div>
</BaseLayout>

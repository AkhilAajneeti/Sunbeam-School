---
/**
 * TEACHING & LEARNING · STEM, ROBOTICS & ENRICHMENT — audit §2C.
 *
 * ⚠ COMBINED PAGE — three of the brief's fourteen bullets: STEM Education,
 * Robotics & Coding, and Mathematics & Science Enrichment. The three standalone
 * routes were an implementation experiment; their verified content is merged
 * here and the routes are retired.
 *
 * ⚠⚠ THE ROBOTICS LAB IS NOT PHOTOGRAPHED, AND NOTHING PRETENDS OTHERWISE.
 * The client's instruction stands: do not use Robotics-drones.jpg or dron.jpg —
 * both are stock, and neither is this school's room. So the Robotics section is
 * built as a TYPOGRAPHIC composition around the four things the school lists as
 * being in the room. It is designed so a real photograph can be dropped into the
 * AcSplit slot later without redesigning the section.
 * ASSET REQUIREMENT: photography of the Robotics Lab.
 *
 * ═══ SOURCE — verified in this repository ══════════════════════════════════
 *   Robotics Lab — "Drone · 3-D printer · telescope · embedded systems".
 *   Two computer laboratories, 40+ machines each.
 *   Mathematics laboratory — "mathematics as a practical subject".
 *   Physics, Chemistry, Biology — board practicals, Classes IX–XII.
 *   Vidyarthi Vigyan Manthan — the national science talent search, Classes VI–XI.
 *   National Children's Science Congress — project work presented and defended.
 *   Inspire Award MANAK — Department of Science & Technology, original ideas
 *     from school students, taken to national level.
 *   RoboWunder International Robotics Championship, Kuala Lumpur — Master Deepak
 *     Kumar, 2nd place, cash prize 1,500 USD, session 2025-26.
 *   National School Innovation Ranking & Awards (CBSE) — Rank 2, Uttar Pradesh.
 *
 * ⚠ SCOPE BOUNDARY — the results in full live on Student Success; the room
 * inventory lives on Laboratories & Academic Clubs; the panels and computer-room
 * teaching live on Smart Classrooms. This page is the science and engineering
 * work and where it is entered.
 *
 * ⚠ NOT CLAIMED: a coding curriculum, which classes take robotics, club hours,
 * or how students are selected for entry. None is published.
 *
 * Composition: split (ivory, photo LEFT) → statement (ink, TYPOGRAPHIC — the
 * Robotics Lab, no photograph) → a bespoke kit list (sand — the four items set
 * as type) → collage (paper, LEFT — the entered programmes and what came back)
 * → close. Five sections; the kit list is bespoke because the system has no
 * primitive for "an inventory with no photograph".
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import AcSplit from '../../../components/academics/system/AcSplit.astro';
import AcStatement from '../../../components/academics/system/AcStatement.astro';
import AcCollage from '../../../components/academics/system/AcCollage.astro';
import AcClose from '../../../components/academics/system/AcClose.astro';

import banner from '../../../assets/photos/sb-chem-lab.jpg';
import pBench from '../../../assets/photos/sb-chem-lab.jpg';
import pMaths from '../../../assets/photos/sb-maths-lab.jpg';
import pComputers from '../../../assets/computer lab/DSC_1207 copy.jpg';
import pComposite from '../../../assets/composite lab/DSC_1256 copy.jpg';
import pCohort from '../../../assets/photos/sunbeem-3.jpg';

const school = 'Sunbeam School Ballia';

/* The Robotics Lab's contents, set as type because there is no photograph of the
   room. Four items, from the school's own one-line inventory. */
const kit = [
  { n: '01', k: 'Drone', v: 'The machine behind the school’s only international placing.' },
  { n: '02', k: '3-D printer', v: 'A design that leaves the screen as an object.' },
  { n: '03', k: 'Telescope', v: 'The one instrument in the room pointed away from the building.' },
  { n: '04', k: 'Embedded systems', v: 'Where the code stops being a screen and starts being a thing that moves.' },
];
---

<BaseLayout
  title="STEM, Robotics & Enrichment — Sunbeam School Ballia"
  description="STEM at Sunbeam School Ballia: a Robotics Lab with a drone, 3-D printer and telescope, board practicals from Class IX, and three national science programmes the school actually enters."
>
  <PageHero
    title="STEM, Robotics & Enrichment"
    standfirst="Named rooms and entered programmes — and a drone that came second in Malaysia."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Teaching & Learning', href: '/academics/teaching-learning/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia working along the chemistry bench, test tubes held over the burners."
    position="50% 44%"
  />

  <div class="u-page-panel ac-panel">
    <AcSplit
      ground="ivory"
      side="left"
      aspect="3 / 2"
      kicker="Where the science happens"
      heading="Rooms built for<br /><em>one subject each</em>"
      body={[
        'Sunbeam’s STEM provision is a set of named rooms rather than a claim about a culture. Physics, Chemistry and Biology each have a laboratory of their own, carrying <strong>board practicals from Class IX to Class XII</strong> — a chemistry bench with gas taps and reagent shelves is a different object from a science room with a sink in it.',
        'The <strong>mathematics laboratory</strong> is the one most schools do without. Its purpose is to make mathematics a practical subject — something handled rather than only argued on paper — which is a harder room to justify and a more revealing one to have.',
      ]}
      photo={pBench}
      alt={`Students of ${school} working along the chemistry bench, test tubes held over the burners`}
      inset={pMaths}
      insetAlt={`The mathematics laboratory at ${school}, its models and charts set out on the working surfaces`}
    />

    {/* ⚠ TYPOGRAPHIC BY NECESSITY. No photograph of this room exists that is
        actually this room. The AcStatement below carries the argument and the
        list carries the inventory; when the school supplies photography it drops
        into a new AcSplit here without touching anything else. */}
    <AcStatement
      ground="ink"
      ghost="Robotics"
      ghostAt="right"
      texture={true}
      kicker="The Robotics Lab"
      statement="Four things<br /><em>in one room.</em>"
      body={[
        'The school’s description of its Robotics Lab is a single line of four items, and it is a more specific line than most schools manage: <strong>a drone, a 3-D printer, a telescope and embedded systems</strong>.',
        'Read it again and notice what it is not. There is no “state-of-the-art” and no “cutting-edge” — just four objects, each of which either exists in a room or does not. It is the kind of claim a parent can walk in and check.',
      ]}
    />

    <section class="ac-section ac--sand kit" aria-labelledby="kit-title">
      <div class="u-container">
        <p class="ac-micro" data-reveal>Set as type, not as a photograph</p>
        <h2 class="ac-lede" id="kit-title" data-split>What is <em>in the room</em></h2>
        <p class="ac-body" data-reveal data-reveal-delay="140">
          The school has published no photograph of this laboratory, and the stock drone image sitting
          in this repository is not it. Rather than illustrate the room with somebody else’s, the four
          items are set as type — and the slot for a real photograph is kept open above.
        </p>

        <ol class="kit__list">
          {kit.map((k, i) => (
            <li class="kit__item" data-reveal data-reveal-delay={160 + i * 90}>
              <p class="kit__n t-tabular" aria-hidden="true">{k.n}</p>
              <p class="kit__k">{k.k}</p>
              <p class="kit__v">{k.v}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <AcCollage
      ground="paper"
      side="left"
      kicker="Entered, not just offered"
      heading="Three papers,<br /><em>and what came back</em>"
      body={[
        'The distinction the school draws is between a programme it lists and one it actually enters. These three are entered — which is the point at which the work stops being marked by the people who set it and starts being measured against other schools.',
        'What came back is recorded on <strong>Student Success</strong> rather than repeated here, with one exception worth naming, because it came out of the Robotics Lab: <strong>Master Deepak Kumar took second place at the RoboWunder International Robotics Championship in Kuala Lumpur</strong>, with a 1,500 USD prize.',
      ]}
      ledger={[
        { k: 'Vidyarthi Vigyan Manthan', v: 'The national science talent search, for <strong>Classes VI to XI</strong>.' },
        { k: 'National Children’s Science Congress', v: 'Project work <strong>presented and defended</strong>, not answered on a paper.' },
        { k: 'Inspire Award MANAK', v: 'The Department of Science &amp; Technology’s scheme for original student ideas, taken to national level.' },
        { k: 'Computer laboratories', v: 'Two, junior and senior, 40+ machines each.' },
        { k: 'CBSE innovation ranking', v: '<strong>Rank 2 in Uttar Pradesh</strong> at the National School Innovation Ranking &amp; Awards.' },
      ]}
      lead={{ src: pComputers, alt: `The computer laboratory at ${school}, its machines set out along the benches` }}
      support={[
        { src: pComposite, alt: `The composite laboratory at ${school}, apparatus set out along the benches` },
        { src: pMaths, alt: `The mathematics laboratory at ${school}, its models and charts set out on the working surfaces` },
      ]}
    />

    <AcClose
      owed={true}
      statement="Second in the world,<br /><em>out of that room.</em>"
      body="The school names the rooms, their contents and the programmes it enters. It does not publish a coding curriculum, which classes take robotics, or club hours — and it has published no photograph of the Robotics Lab itself."
      photo={pCohort}
      alt={`Students and staff of ${school} gathered on the hall stage`}
      position="50% 42%"
    />
  </div>
</BaseLayout>

<style>
  /* ⚠ REQUIRED, AND EASY TO LOSE. Every other page in this section carries this
     one line; this page has a bespoke style block and it was dropped when that
     block was written, which left 120px of panel padding hanging between the
     last section and the footer at 1920. */
  div.ac-panel { padding-block: 0; }

  /* The kit list — a bespoke block because the system has no primitive for "an
     inventory with no photograph", and inventing one for a single page would be
     a worse trade than forty lines of CSS here. It borrows the system's own type
     scale and ground classes so it cannot drift from the rest of the page. */
  .kit__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr));
    gap: clamp(20px, 2.6vw, 38px);
    margin: clamp(34px, 4.5vw, 60px) 0 0;
    padding: 0;
    list-style: none;
  }

  .kit__item {
    position: relative;
    padding-top: clamp(16px, 2vw, 22px);
    border-top: 1px solid rgba(27, 21, 18, 0.16);
  }

  .kit__n {
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--sb-violet);
  }

  .kit__k {
    margin: clamp(8px, 1vw, 12px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(21px, 2.2vw, 30px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }

  .kit__v {
    margin: 8px 0 0;
    font-size: clamp(14px, 1vw, 15px);
    line-height: 1.66;
    color: var(--sb-text-secondary);
  }
</style>

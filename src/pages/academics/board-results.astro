---
/**
 * ACADEMICS · BOARD RESULTS.
 *
 * ⚠⚠ THIS PAGE USED TO SAY THE RESULTS WERE NOT PUBLISHED. They are, and they
 * always were — BRS.pdf, on the school's own letterhead, transcribed in
 * data/disclosure.ts → `boardResults`. The title, standfirst, meta description
 * and closing section ALL carried the false claim, and each one is corrected
 * here. See the component header for the full account.
 *
 * ⚠ IF YOU ARE CHANGING THE COPY ON THIS PAGE, CHANGE IT IN FOUR PLACES. The
 * standfirst and description live here; the body and the close live in the
 * component. That split is how two of them stayed wrong after the other two
 * were fixed.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import BoardResultsPage from '../../components/academics/assessment/BoardResultsPage.astro';

import banner from '../../assets/library/DSC_1226 copy.jpg';
---

<BaseLayout
  title="Board Results — Sunbeam School Ballia"
  description="CBSE Class X and Class XII board results for Sunbeam School Ballia — three years, as filed by the school on its own letterhead. Class X 100% in 2025; Class XII 98.90%. With CUET (UG) 2025 scores and named university placements."
>
  <PageHero
    title="Board Results"
    standfirst="Class X and Class XII, three years, as the school files them with CBSE on its own letterhead."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
    ]}
    src={banner}
    alt="The Nalanda Library at Sunbeam School Ballia, its shelves signed by subject."
    position="50% 50%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <BoardResultsPage />
  </div>
</BaseLayout>

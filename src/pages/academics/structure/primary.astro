---
/**
 * ACADEMIC STRUCTURE · PRIMARY — Classes I to V.
 *
 * ⚠ REBUILT ON EVIDENCE, NOT ON A SUMMARY. The first version of this page took
 * the parent overview's sentence about "reading, number and the first structured
 * subjects" and dressed it in a composition. That is a child page repeating its
 * parent, which is exactly what a child page must not be. Everything below is
 * now a specific, published thing that happened to a named class — the parent
 * page cannot say any of it, because the parent page is a summary.
 *
 * ═══ SOURCE OF TRUTH — all verified in this repository ═════════════════════
 *   PRECEPT — the school publishes its CBSE syllabus class by class, Nursery to
 *   Class XII, for session 2026-27. Primary is five of those documents.
 *
 *   Class I — Cohort Inter-Branch Attire Speak Competition: "a speaking
 *   competition across Sunbeam branches, entered by the school's six-year-olds."
 *
 *   Nursery to Class II — SOF Olympiad (Science Olympiad Foundation).
 *
 *   Classes III–V — SOF Zonal Excellence Award, "with a ₹500 voucher, for
 *   students in the primary years."
 *
 *   Classes III–V — Indian Folk Painting Competition, run under Impetus:
 *   "students showed the richness of Indian folk art in their own strokes."
 *
 *   Classes III–V — Heritage Week: "a week inside the culture and traditions of
 *   India — art, dance and music."
 *
 *   Impetus is the school's own activity programme for Classes III–V.
 *   The junior computer laboratory carries 40+ machines.
 *
 * ⚠ STILL NOT CLAIMED: subject lists, period allocations, assessment weightings,
 * or what any PRECEPT document contains. The school publishes that the documents
 * exist, not their contents.
 *
 * Composition: split (paper, photo LEFT) → collage (ivory, the record on
 * hairlines) → close. The middle section is now the evidence, not a restatement.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import AcSplit from '../../../components/academics/system/AcSplit.astro';
import AcCollage from '../../../components/academics/system/AcCollage.astro';
import AcClose from '../../../components/academics/system/AcClose.astro';

import banner from '../../../assets/school-event/Impetus—ClassesIII-V/Impetus—ClassesIII-V-02.jpg';
import pCanva from '../../../assets/school-event/Impetus—ClassesIII-V/Impetus—ClassesIII-V-02.jpg';
import pOwn from '../../../assets/School Activity in Uniform/School Activity in Uniform (5).jpeg';
import pLib from '../../../assets/library/DSC_1224 copy.jpg';
import pCohort from '../../../assets/photos/sunbeem-3.jpg';

const school = 'Sunbeam School Ballia';
---

<BaseLayout
  title="Primary — Sunbeam School Ballia"
  description="Primary at Sunbeam School Ballia, Classes I to V: a PRECEPT syllabus document for every class, the Impetus activity programme for Classes III–V, SOF Olympiad entries from Nursery, and a Class I speaking competition across Sunbeam branches."
>
  <PageHero
    title="Primary"
    standfirst="Classes I to V — where six-year-olds enter a speaking competition and Class III sits a national olympiad."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Academic Structure', href: '/academics/structure/' },
    ]}
    src={banner}
    alt="A class at Sunbeam School Ballia during a Canva Presentation activity in the Impetus programme, the interactive board in use behind them."
    position="50% 44%"
  />

  <div class="u-page-panel ac-panel">
    <AcSplit
      ground="paper"
      side="left"
      aspect="16 / 10"
      kicker="Classes I – V"
      heading="Five classes,<br /><em>five syllabus documents</em>"
      body={[
        'The curriculum is CBSE’s, and the school publishes it class by class as its <strong>PRECEPT</strong> syllabus — a separate document for every year from Nursery to Class XII, for session <strong>2026-27</strong>. Primary is five of them.',
        'Alongside the timetable, Classes III to V take <strong>Impetus</strong>, the school’s own activity programme. The Canva Presentation session above is one of its sittings — presentation software taught to nine-year-olds in the junior computer laboratory, which carries <strong>40+ machines</strong>.',
      ]}
      photo={pCanva}
      alt={`A class at ${school} during a Canva Presentation activity in the Impetus programme`}
      inset={pOwn}
      insetAlt={`Two students of ${school} sharing a desk, each working on her own drawing`}
    />

    <AcCollage
      ground="ivory"
      side="left"
      kicker="What the primary years actually did"
      heading="Entered, judged<br /><em>and brought home</em>"
      body={[
        'The clearest thing about this stage is not a description of it — it is the record. Every line below names the class that did it, and each is something the school published rather than something claimed on its behalf.',
      ]}
      ledger={[
        { k: 'Class I · Attire Speak', v: 'A speaking competition across Sunbeam branches — entered by the school’s six-year-olds.' },
        { k: 'Nursery – Class II · SOF Olympiad', v: 'The Science Olympiad Foundation olympiad, sat from the youngest years.' },
        { k: 'Classes III–V · SOF Zonal Excellence Award', v: 'The zonal award, with a ₹500 voucher, for students in the primary years.' },
        { k: 'Classes III–V · Indian Folk Painting', v: '“Students showed the richness of Indian folk art in their own strokes.”' },
        { k: 'Classes III–V · Heritage Week', v: 'A week inside the culture and traditions of India — art, dance and music.' },
      ]}
      lead={{ src: pCanva, alt: `A class at ${school} during an Impetus activity, the interactive board in use` }}
      support={[
        { src: pOwn, alt: `Two students of ${school} sharing a desk, each working on her own drawing` },
        { src: pLib, alt: `The Nalanda Library at ${school}, its shelves signed by subject` },
      ]}
    />

    <AcClose
      owed={true}
      statement="Six years old,<br /><em>and on the platform.</em>"
      body="The school publishes a syllabus document per class and a record of what each year group entered. Subject lists, period allocations and the contents of the PRECEPT documents are not published."
      photo={pCohort}
      alt={`Students and staff of ${school} gathered on the hall stage`}
      position="50% 42%"
    />
  </div>
</BaseLayout>

<style>
  div.ac-panel { padding-block: 0; }
</style>

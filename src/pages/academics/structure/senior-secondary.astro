---
/**
 * ACADEMIC STRUCTURE · SENIOR SECONDARY — Classes XI and XII.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION, NOT THE Ac* SYSTEM. Sourcing, the
 * photograph roster and the one section that deliberately uses cards are
 * documented in the component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import SeniorSecondaryPage from '../../../components/academics/structure/SeniorSecondaryPage.astro';

import banner from '../../../assets/photos/sb-phy-lab.jpg';
---

<BaseLayout
  title="Senior Secondary — Sunbeam School Ballia"
  description="Senior Secondary at Sunbeam School Ballia, Classes XI and XII: four streams taught to board level, a Class XII physics practical done properly, and an international innovation project run with Monash University, Australia."
>
  <PageHero
    title="Senior Secondary"
    standfirst="Classes XI and XII — four streams, a galvanometer measured properly, and a project run with Monash."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Academic Structure', href: '/academics/structure/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia working at benches in the physics laboratory, with portraits of Nikola Tesla and Michael Faraday on the wall."
    position="50% 48%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <SeniorSecondaryPage />
  </div>
</BaseLayout>

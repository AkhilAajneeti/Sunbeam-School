---
/**
 * ASSESSMENT & SUPPORT · REMEDIAL SUPPORT — audit 2.D5.
 *
 * ⚠ THE RICHEST ASSESSMENT PAGE THE SCHOOL MAKES POSSIBLE. Its /promotion-policy/
 * page carries more substance on assessment than anything else on its site, and
 * this page is built out of it: four dated rules and the exact classes each
 * applies to. The parent Assessment page has the six-step cycle; this one has
 * the rules that hang off step five.
 *
 * ═══ SOURCE — the school's own /promotion-policy/ page ═════════════════════
 *   A retest sits no sooner than TEN DAYS after results are announced.
 *   TWO CLEAR DAYS between retests where a student sits more than one.
 *   Results published within TWO AND A HALF WEEKS of the main examination.
 *   On a medical certificate the retest still has to be sat — a promotion is not
 *     given on the half-yearly alone.
 *   Applies in Classes VIII and IX for a single subject below the threshold, and
 *     in Class XI where one subject is failed.
 *
 * ⚠ THE THRESHOLD ITSELF IS NOT PUBLISHED. The policy says "below the
 * threshold"; it does not give the mark. No percentage appears on this page.
 *
 * ⚠ THE PHOTOGRAPH IS A REAL ONE OF STUDENTS WORKING — assets/photos/sb-chem-lab
 * shows a chemistry bench in use, unlike the empty-room laboratory set. It is
 * captioned as what it is.
 *
 * Composition: split (paper, photo RIGHT) → path (sand, the rules in the order
 * they happen) → close.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import AcSplit from '../../../components/academics/system/AcSplit.astro';
import AcPath from '../../../components/academics/system/AcPath.astro';
import AcClose from '../../../components/academics/system/AcClose.astro';

import banner from '../../../assets/photos/sb-chem-lab.jpg';
import pBench from '../../../assets/photos/sb-chem-lab.jpg';
import pLib from '../../../assets/photos/sb-library.jpg';
import pCohort from '../../../assets/photos/sunbeem-3.jpg';

const school = 'Sunbeam School Ballia';
---

<BaseLayout
  title="Remedial Support — Sunbeam School Ballia"
  description="How a retest works at Sunbeam School Ballia: no sooner than ten days after results, two clear days between retests, results within two and a half weeks, and a retest still required after a medical absence."
>
  <PageHero
    title="Remedial Support"
    standfirst="A retest with dates attached — ten days, two clear days, two and a half weeks."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Assessment & Support', href: '/academics/assessment/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia working along the chemistry bench, test tubes held over the burners."
    position="50% 44%"
  />

  <div class="u-page-panel ac-panel">
    <AcSplit
      ground="paper"
      side="right"
      ratio="wide"
      aspect="3 / 2"
      kicker="Where it applies"
      heading="One subject,<br /><em>not the whole year</em>"
      body={[
        'Remedial support at Sunbeam is attached to a subject, not to a student. It runs where a result in <strong>Classes VIII and IX</strong> falls below the threshold in a single subject, and in <strong>Class XI</strong> where one subject is failed — additional teaching in that subject, followed by a retest.',
        'The threshold mark itself is not published, and no percentage is quoted here. What <em>is</em> published, unusually, is the timetable the retest has to obey — and that turns out to be the part a family can actually use.',
      ]}
      photo={pBench}
      alt={`Students of ${school} working along the chemistry bench, test tubes held over the burners`}
      inset={pLib}
      insetAlt={`Students of ${school} reading at the long tables of the library, a member of staff at the head of the row`}
    />

    <AcPath
      ground="sand"
      kicker="The rules, in the order they happen"
      heading="A second chance<br /><em>with dates on it</em>"
      body={[
        'Most schools promise extra help. Few publish the calendar it has to run to. These four rules are the school’s own, and each exists to stop a retest becoming a formality: enough time for the teaching to happen, enough space between papers to prepare for them, and a results window short enough to be useful.',
      ]}
      beats={[
        { k: 'Ten days', body: 'The earliest a retest may sit after results are announced — long enough for the additional teaching to actually have happened.' },
        { k: 'Two clear days', body: 'Between retests where a student sits more than one, so they are never taken back to back.' },
        { k: 'Two and a half weeks', body: 'The window inside which results are published after the main examination.' },
        { k: 'Even on a certificate', body: 'A medical absence does not waive the retest — a promotion is not given on the half-yearly alone.' },
      ]}
    />

    <AcClose
      owed={true}
      statement="Not a second sitting<br /><em>of the same paper.</em>"
      body="The school publishes the retest calendar, the classes it applies to and the medical provision. It does not publish the pass threshold, the form the additional teaching takes, or who delivers it."
      photo={pCohort}
      alt={`Students and staff of ${school} gathered on the hall stage`}
      position="50% 42%"
    />
  </div>
</BaseLayout>

<style>
  div.ac-panel { padding-block: 0; }
</style>

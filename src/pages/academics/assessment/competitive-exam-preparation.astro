---
/**
 * ASSESSMENT & SUPPORT · COMPETITIVE EXAMINATION PREPARATION — audit 2.D7.
 *
 * ⚠ THIS PAGE AND OLYMPIAD ACHIEVEMENTS MUST NOT BE THE SAME PAGE. They cover
 * the same four programmes from opposite ends, and the split is deliberate:
 *
 *     this page          — what each programme ASKS OF A STUDENT
 *     olympiad-achievements — what has COME BACK from them
 *
 * No result is repeated here, so there is one record of what students have won
 * rather than two that can disagree.
 *
 * ═══ SOURCE — verified in this repository ══════════════════════════════════
 *   Vidyarthi Vigyan Manthan — the national science talent search, Classes VI–XI.
 *   National Children's Science Congress — project-based science, presented and
 *     defended.
 *   Inspire Award MANAK — Department of Science & Technology; original ideas
 *     from school students, taken to national level.
 *   Science Olympiad Foundation — entered from the primary years upward.
 *   CUET (UG) — the school published 2025 results across PCM, Commerce and
 *     Humanities; the destinations are on University Counselling.
 *
 * ⚠ NOT CLAIMED: a coaching timetable, an entry fee, a selection process for who
 * is entered, or preparation classes. The school names the programmes it enters;
 * it does not describe how it prepares students for them.
 *
 * Composition: split (ivory, photo LEFT) → collage (paper, RIGHT, the four
 * programmes on hairlines) → close.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import AcSplit from '../../../components/academics/system/AcSplit.astro';
import AcCollage from '../../../components/academics/system/AcCollage.astro';
import AcClose from '../../../components/academics/system/AcClose.astro';

import banner from '../../../assets/photos/sb-chem-lab.jpg';
import pBench from '../../../assets/photos/sb-chem-lab.jpg';
import pComposite from '../../../assets/composite lab/DSC_1257 copy.jpg';
import pActivity from '../../../assets/activity learning lab/DSC_1216 copy.jpg';
import pLib from '../../../assets/photos/sb-library.jpg';
import pCohort from '../../../assets/photos/sunbeem-3.jpg';

const school = 'Sunbeam School Ballia';
---

<BaseLayout
  title="Competitive Examination Preparation — Sunbeam School Ballia"
  description="The national programmes Sunbeam School Ballia enters: Vidyarthi Vigyan Manthan for Classes VI to XI, the National Children's Science Congress, Inspire Award MANAK and the SOF olympiads."
>
  <PageHero
    title="Competitive Examination Preparation"
    standfirst="Four national programmes, named — because an entry can be checked and an abstraction cannot."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Assessment & Support', href: '/academics/assessment/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia working along the chemistry bench, test tubes held over the burners."
    position="50% 44%"
  />

  <div class="u-page-panel ac-panel">
    <AcSplit
      ground="ivory"
      side="left"
      aspect="3 / 2"
      kicker="Beyond the board syllabus"
      heading="Four papers<br /><em>nobody has to sit</em>"
      body={[
        'None of the programmes below is compulsory, and none of them counts towards a board result. That is what makes entering them a decision — and the school names which ones it enters rather than describing a culture of enrichment in the abstract.',
        'What each asks for is different in kind, which is the useful part for a family reading this: one is a written talent search, one is a defended project, one is an original idea, and one is a paper sat from the primary years.',
        'What has come back from them — the national qualifications and the placings — is recorded on <strong>Olympiad Achievements</strong> rather than repeated here.',
      ]}
      photo={pBench}
      alt={`Students of ${school} working along the chemistry bench, test tubes held over the burners`}
      inset={pComposite}
      insetAlt={`The composite laboratory at ${school}, apparatus set out along the benches`}
    />

    <AcCollage
      ground="paper"
      side="right"
      kicker="What each one asks"
      heading="A search, a defence,<br /><em>an idea, a paper</em>"
      body={[
        'Read side by side, the four programmes ask for four different things — and between them they cover most of what a science education is supposed to produce. A student who can sit a talent search may not be the one who can defend a project in front of a panel.',
      ]}
      ledger={[
        { k: 'Vidyarthi Vigyan Manthan', v: 'The national science talent search, for students of <strong>Classes VI to XI</strong>. A written search, sat against a national field.' },
        { k: 'National Children’s Science Congress', v: 'Project-based science — work <strong>presented and defended</strong>, not answered on a paper.' },
        { k: 'Inspire Award MANAK', v: 'The Department of Science &amp; Technology’s scheme for <strong>original ideas</strong> from school students, taken to national level.' },
        { k: 'Science Olympiad Foundation', v: 'The olympiad, entered <strong>from the primary years upward</strong> — the earliest external paper a Sunbeam child sits.' },
        { k: 'CUET (UG)', v: 'The senior-school entrance examination; the school published 2025 results across PCM, Commerce and Humanities.' },
      ]}
      lead={{ src: pActivity, alt: `The activity learning laboratory at ${school}, its worktables set out for group work` }}
      support={[
        { src: pLib, alt: `Students of ${school} reading at the long tables of the library` },
        { src: pComposite, alt: `The composite laboratory at ${school}, apparatus set out along the benches` },
      ]}
    />

    <AcClose
      owed={true}
      statement="Named,<br /><em>so it can be checked.</em>"
      body="The school names the programmes it enters and the classes eligible for them. It does not publish a coaching timetable, how students are selected for entry, or whether preparation runs inside or outside the school day."
      photo={pCohort}
      alt={`Students and staff of ${school} gathered on the hall stage`}
      position="50% 42%"
    />
  </div>
</BaseLayout>

<style>
  div.ac-panel { padding-block: 0; }
</style>

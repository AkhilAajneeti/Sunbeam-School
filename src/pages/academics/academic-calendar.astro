---
/**
 * ACADEMICS · ACADEMIC CALENDAR.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION, and its archive is data-driven from
 * data/academicCalendar.ts — three published documents, each card's size taken
 * from the file it links to. Why the page still prints no term date, given that
 * it now serves the calendars themselves, is set out in both of those headers:
 * they are group publications whose dated lines are tagged by campus.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import AcademicCalendarPage from '../../components/academics/assessment/AcademicCalendarPage.astro';

import banner from '../../assets/corridor and stairs/DSC_1211 copy.jpg';
---

<BaseLayout
  title="Academic Calendar — Sunbeam School Ballia"
  description="Download the academic calendars Sunbeam School Ballia publishes — the Calendar & Monthly Planner 2026-27, the Sunbeam Calendar 2025 and the seven sheets of 2024 — covering terms, holidays, examination dates and parent–teacher meetings."
>
  <PageHero
    title="Academic Calendar"
    standfirst="The academic calendar shows how we plan the year for your child and for you."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Assessment & Support', href: '/academics/assessment/' },
    ]}
    src={banner}
    alt="A corridor and stairwell at Sunbeam School Ballia, its landings running the length of the block."
    position="50% 50%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <AcademicCalendarPage />
  </div>
</BaseLayout>

---
/**
 * ACADEMICS → 04 · ASSESSMENT & SUPPORT.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION. The zig-zag JourneyRoad this page used to
 * carry ran the six steps down five screens to say six words; the cycle is now a
 * radial diagram and a compact rail, both readable inside two scrolls. Sourcing
 * and the four things this page refuses to claim are in the component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED — PageHero takes the same props
 * as every other Academics page.
 *
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE, NOT A SCOPED RULE. A scoped
 * rule depends on the build hashing the same class into both the HTML and the
 * stylesheet; when that skewed, the panel got its default 120px back and a white
 * band opened between the close section and the footer. Inline cannot skew.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import AssessmentPage from '../../components/academics/assessment/AssessmentPage.astro';

import banner from '../../assets/photos/sunbeem-students.jpg';
---

<BaseLayout
  title="Assessment & Support — Sunbeam School Ballia"
  description="How an academic year runs at Sunbeam School Ballia: taught content, activities, internal assessment, CBSE board examinations at Class X and XII, and the remedial support, mentoring and parent–teacher meetings around them."
>
  <PageHero
    title="Assessment & Support"
    standfirst="Six steps, repeating — content taught, practised, assessed and fed back, with the support named rather than assumed."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia working at the bench during a science practical."
    position="50% 42%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <AssessmentPage />
  </div>
</BaseLayout>

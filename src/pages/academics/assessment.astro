---
/**
 * ACADEMICS → 04 · ASSESSMENT & SUPPORT
 *
 * LAYOUT: the six steps on components/academics/JourneyRoad.astro — the same
 * zigzag path, badges and dotted arcs the History & Legacy page uses. This page
 * has no photographs at all: the subject is a cycle, and a cycle is a diagram,
 * not a gallery.
 *
 * ⚠ IT WAS HALF A DESIGN BEFORE. The steps alternated left and right of a
 * vertical rule, but the rule sat at the far LEFT rather than between them — so
 * the left-hand steps had a short connector stub and the right-hand ones had no
 * visible connection to the sequence at all, across a gutter of empty page. Half
 * of every row was blank. The zigzag is the shape that arrangement was reaching
 * for, and it already existed a page away.
 *
 * THE ROAD IS SHARED, not copied. Extracting it is also the fix for a real
 * problem: this site had grown three unrelated sequence treatments, and the
 * connector on one of them was a 40×2px hairline while this was sitting in
 * about/history-legacy.astro as page-local CSS.
 *
 * The six-step cycle describes how a CBSE year is structured — taught content,
 * internal assessment, boards at X and XII, and the support around them. It does
 * not claim a proprietary Sunbeam method, because the school has not published
 * one. Asset request A10.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import JourneyRoad from '../../components/academics/JourneyRoad.astro';
import { cycle, supports, assessmentTopics } from '../../data/academics';

/* Students at the bench during a practical — assessment is a thing that happens
   in a room, not an abstraction. */
import banner from '../../assets/photos/sunbeem-students.jpg';
---

<BaseLayout
  title="Assessment & Support — Sunbeam School Ballia"
  description="How an academic year runs at Sunbeam School Ballia: taught content, activities, internal assessment, CBSE board examinations at Class X and XII, and the mentoring and remedial support around them."
>
  <PageHero
    title="Assessment & Support"
    standfirst="Six steps, repeating — content taught, practised, assessed and fed back, with the support named rather than assumed."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia working at the bench during a science practical."
    position="50% 42%"
  />

  {/* ⚠ THE PANEL IS REQUIRED, NOT DECORATION. PageHero is position: sticky and
      is covered by this panel as the page scrolls; without it the banner hangs
      under the footer. */}
  <div class="u-page-panel as4-panel">
  {/* ══ HERO — minimal, numbers-led, no photograph ══════════════════════════ */}
  <section class="ahero4" aria-labelledby="ahero4-title">
    <div class="u-container">
      <div class="ahero4__grid">
        <div>
          <p class="ahero4__n t-tabular" aria-hidden="true">Chapter 04</p>
          <h2 class="ahero4__title" id="ahero4-title" data-split>
            How a year actually <span class="t-squiggle">runs</span>
          </h2>
        </div>

        <p class="ahero4__stand">
          Six steps, repeating. Content is taught, practised, assessed and fed back — and where a
          subject needs more, the support is named rather than assumed.
        </p>
      </div>

      {/* The step names as a single ticker line, so the whole cycle is legible
          before the reader scrolls into it. */}
      <ol class="ticker" aria-label="The assessment cycle">
        {cycle.map((c, i) => (
          <li>
            <span class="ticker__i t-tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            {c.step}
            {i < cycle.length - 1 && <span class="ticker__arrow" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ══ THE CYCLE, AS A JOURNEY ═══════════════════════════════════════════ */}
  <section class="flow" id="system" aria-labelledby="flow-title">
    <div class="u-container">
      <h2 class="u-visually-hidden" id="flow-title">The assessment cycle</h2>

      <JourneyRoad
        items={cycle.map((c) => ({ title: c.step, body: c.body }))}
        label="The assessment cycle, six steps"
        loop="And round again, every term."
      />
    </div>
  </section>



  {/* ══ SUPPORT ════════════════════════════════════════════════════════════ */}
  <section class="sup2" id="support" aria-labelledby="sup2-title">
    <div class="u-container">
      <div class="sup2__head" data-reveal>
        <p class="sup2__pill"><span class="pill pill--glass">Support</span></p>
        <h2 class="sup2__title t-h2-sans" id="sup2-title" data-split>
          Six things a parent can <span class="t-squiggle">rely on</span>
        </h2>
      </div>

      <ul class="sup2__list">
        {supports.map((s, i) => {
          const Tag = s.href ? 'a' : 'div';
          return (
            <li class="srow" data-reveal data-reveal-delay={(i % 3) * 70}>
              <Tag class="srow__in" {...(s.href ? { href: s.href } : {})}>
                <span class="srow__i t-tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span class="srow__t">{s.label}</span>
                <span class="srow__b">{s.body}</span>
                {s.href && (
                  <span class="srow__go" aria-hidden="true">
                    <svg width="15" height="10" viewBox="0 0 14 10" fill="none">
                      <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.7" />
                    </svg>
                  </span>
                )}
              </Tag>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  </div>

  {/* ⚠ NO CHAPTER NAVIGATION — removed at the client's instruction. It was the
      dark "Chapter 04 of 06 · Academics overview" band with Previous / Next
      cards to Teaching & Learning and Student Success.

      `ChapterNav.astro` is untouched and the other five academics pages still
      carry it, so restoring this one is a single tag. Worth knowing what went:
      this page now has no onward route to the rest of the Academics chapters
      except the main navigation, and it is the only one of the six without
      that band — the sequence reads as broken at chapter four. */}
</BaseLayout>

<style>
  /* ══════════ HERO ════════════════════════════════════════════════════════ */
  .ahero4 {
    background: var(--sb-ivory);
    padding-block: clamp(110px, 15vh, 176px) var(--sb-section-y-major);
  }

  .ahero4__crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-3);
    list-style: none;
    margin: 0 0 var(--sb-8);
    padding: 0;
    font-size: var(--sb-caption);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ahero4__crumbs li + li::before {
    content: '/';
    margin-right: var(--sb-3);
    color: var(--sb-text-muted);
  }

  .ahero4__crumbs a { color: var(--sb-text-secondary); }
  .ahero4__crumbs a:hover { color: var(--sb-violet); }
  .ahero4__crumbs [aria-current] { color: var(--sb-charcoal); font-weight: 600; }

  .ahero4__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(28px, 5vw, 76px);
    align-items: end;
  }

  .ahero4__n {
    font-size: var(--sb-caption);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sb-violet);
    margin-bottom: var(--sb-5);
  }

  .ahero4__title {
    font-family: var(--sb-font-display);
    font-weight: 800;
    font-size: clamp(34px, 5.2vw, 74px);
    line-height: 1.05;
    letter-spacing: -0.038em;
    color: var(--sb-charcoal);
  }

  .ahero4__stand {
    font-size: var(--sb-body);
    line-height: 1.72;
    color: var(--sb-text-secondary);
  }

  /* --- Ticker ---------------------------------------------------------------
     Wraps rather than scrolls. A marquee here would move information the reader
     is trying to read, and there is no pause control worth adding for six
     words. */
  .ticker {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sb-3) var(--sb-5);
    list-style: none;
    margin: clamp(36px, 5vh, 64px) 0 0;
    padding-top: var(--sb-7);
    border-top: var(--sb-hairline);
  }

  .ticker li {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sb-3);
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(16px, 1.5vw, 21px);
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }

  .ticker__i {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sb-violet);
  }

  .ticker__arrow {
    margin-left: var(--sb-2, 8px);
    color: var(--sb-text-muted);
    font-weight: 400;
  }

  /* ══════════ THE SPINE ═══════════════════════════════════════════════════ */
  .flow {
    background: var(--sb-sand);
    padding-block: var(--sb-section-y-major);
  }

  /* The road itself lives in components/academics/JourneyRoad.astro — badges,
     arcs, the title roll and the stacked fallback all travel with it. */

  /* ══════════ SUPPORT ═════════════════════════════════════════════════════
      Rows, not a card grid. Six equal tiles is the pattern this rebuild removes;
      a numbered list with a hairline between each reads as a reference, which is
      what this is. */
  .sup2 {
    background: var(--sb-ink);
    padding-block: var(--sb-section-y-major);
  }

  .sup2__head { margin-bottom: var(--sb-9); max-width: 34ch; }
  .sup2__pill { margin-bottom: var(--sb-5); }
  .sup2__title { color: #fff; }

  .sup2__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }

  .srow { border-bottom: 1px solid rgba(255, 255, 255, 0.16); }

  .srow__in {
    display: grid;
    grid-template-columns: auto minmax(0, 4fr) minmax(0, 7fr) auto;
    align-items: center;
    gap: var(--sb-6);
    padding: var(--sb-7) var(--sb-5);
    margin-inline: calc(var(--sb-5) * -1);
    transition: background-color var(--sb-dur-link) ease;
  }

  a.srow__in:hover { background: rgba(255, 255, 255, 0.06); }

  .srow__i {
    font-size: var(--sb-caption);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--sb-lime);
  }

  .srow__t {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(18px, 1.8vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: #fff;
  }

  .srow__b {
    font-size: var(--sb-body-sm);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  .srow__go {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--sb-r-full);
    border: 1px solid rgba(255, 255, 255, 0.32);
    color: #fff;
    transition: background-color var(--sb-dur-btn) ease, border-color var(--sb-dur-btn) ease,
      transform var(--sb-dur-btn) var(--sb-ease);
  }

  a.srow__in:hover .srow__go {
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    transform: translateX(3px);
  }

  /* ══════════ REDUCED MOTION ══════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .srow__in,
    .srow__go { transition: none; }
    a.srow__in:hover .srow__go { transform: none; }
  }

  /* ══════════ TABLET ══════════════════════════════════════════════════════ */
  @media (max-width: 1023px) {
    .ahero4__grid { grid-template-columns: minmax(0, 1fr); align-items: start; gap: var(--sb-6); }

    .srow__in {
      grid-template-columns: auto minmax(0, 1fr) auto;
      row-gap: var(--sb-3);
    }

    /* The description drops under the label and spans the text columns rather
       than being squeezed into a third of the row. */
    .srow__b { grid-column: 2 / 4; }
  }

  /* ══════════ MOBILE ══════════════════════════════════════════════════════
      The spine goes fully left-hand: alternating sides needs two usable columns
      and 390px does not have them. */
  @media (max-width: 767px) {
  }

  @media (max-width: 639px) {
    .ahero4 { padding-block: clamp(92px, 13vh, 130px) var(--sb-section-y); }
    .flow,
    .sup2 { padding-block: var(--sb-section-y); }

    .srow__in { grid-template-columns: auto minmax(0, 1fr); padding-block: var(--sb-6); }
    .srow__b { grid-column: 1 / 3; }
    .srow__go { display: none; } /* the whole row is the tap target */
  }
</style>

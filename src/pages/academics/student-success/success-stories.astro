---
/**
 * STUDENT SUCCESS · STUDENT SUCCESS STORIES.
 *
 * No aggregate anywhere on this page. Sourcing — the three award graphics the
 * school made artwork for, the four named individual placings, and why the
 * brief's optional second slider was not built — is in the component header.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import SuccessStoriesPage from '../../../components/academics/assessment/SuccessStoriesPage.astro';

import banner from '../../../assets/competition/chaturang-chess-championship/chaturang-chess-championship-04.jpg';
---

<BaseLayout
  title="Student Success Stories — Sunbeam School Ballia"
  description="Named results at Sunbeam School Ballia: second place at an international robotics championship in Kuala Lumpur, rank 2 in Uttar Pradesh at the CBSE innovation awards, and CBSE Cluster-V Kho-Kho gold."
>
  <PageHero
    title="Student Success Stories"
    standfirst="No totals, because the school publishes none. Names, places and prize money, because it publishes those."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Student Success', href: '/academics/student-success/' },
    ]}
    src={banner}
    alt="Students of Sunbeam School Ballia mid-game at the boards during the Chaturang chess championship."
    position="50% 50%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <SuccessStoriesPage />
  </div>
</BaseLayout>

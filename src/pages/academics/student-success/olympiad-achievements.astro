---
/**
 * STUDENT SUCCESS · OLYMPIAD ACHIEVEMENTS.
 *
 * No award total. The school publishes none, and "100+ Olympiad awards" was in
 * the original brief. What it does publish — which programmes, from which class,
 * and a small number of named results — is in the component header, along with
 * the photograph the repository does not hold.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import OlympiadPage from '../../../components/academics/assessment/OlympiadPage.astro';

import banner from '../../../assets/composite lab/DSC_1255 copy.jpg';
---

<BaseLayout
  title="Olympiad Achievements — Sunbeam School Ballia"
  description="Sunbeam School Ballia enters the Science Olympiad Foundation olympiads from Nursery, holds an SOF Zonal Excellence Award for Classes III to V, and has qualified students to the national level of Vidyarthi Vigyan Manthan."
>
  <PageHero
    title="Olympiad Achievements"
    standfirst="The school's answer to “from what age do they sit these?” is Nursery."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Student Success', href: '/academics/student-success/' },
    ]}
    src={banner}
    alt="The composite laboratory at Sunbeam School Ballia, its benches and apparatus laid out along the room."
    position="50% 50%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <OlympiadPage />
  </div>
</BaseLayout>

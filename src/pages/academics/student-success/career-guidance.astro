---
/**
 * STUDENT SUCCESS · CAREER GUIDANCE.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION, and its slider is data-driven from
 * data/studentSuccess.ts — eight frames today, unlimited tomorrow. Sourcing,
 * and the one thing this page refuses to guess (the speaker's name), are in the
 * component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import CareerGuidancePage from '../../../components/academics/assessment/CareerGuidancePage.astro';

import banner from '../../../assets/school-activities/career-counselling/03.jpg';
---

<BaseLayout
  title="Career Guidance — Sunbeam School Ballia"
  description="Career guidance at Sunbeam School Ballia: a hall session for the senior school followed by one-to-one counselling for Classes X and XI, and career-guidance talks by named officers for Classes IX to XII."
>
  <PageHero
    title="Career Guidance"
    standfirst="A day that starts in the hall and ends at a table, with one student on the other side of it."
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Academics', href: '/academics/' },
      { label: 'Student Success', href: '/academics/student-success/' },
    ]}
    src={banner}
    alt="A student of Sunbeam School Ballia in a one-to-one career counselling session, the counsellor working from a laptop across the table."
    position="50% 46%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <CareerGuidancePage />
  </div>
</BaseLayout>

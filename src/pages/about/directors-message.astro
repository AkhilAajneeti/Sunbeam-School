---
/**
 * ABOUT → DIRECTOR'S MESSAGE — audit 1.9
 *
 * COPY — supplied by the school, used as given. Two notes:
 *
 * 1. This resolves the placeholder that stood here, and corrects our records:
 *    docs/01 § 5 held only "Sunbeam Group Director: Mrs. Amrita Burman", which
 *    is a different person in a different role from the Director of the Ballia
 *    school. Nothing was ever printed under that name — which is exactly why
 *    this page needed no retraction.
 *
 * 2. THE PULL QUOTE IS PARAGRAPH 3'S SECOND SENTENCE, MOVED — not copied. It
 *    read "…city of Ballia. Sunbeam Ballia is committed to make Ballia a name to
 *    reckon with for education and to provide world-class quality education."
 *    Setting that line as a quote while leaving it in the body would print it
 *    twice, so the body keeps the first sentence and the quote takes the second.
 *    Every word the school supplied is still on the page, exactly once.
 *
 * 3. Three spellings are corrected from the copy as supplied: "privileges'" →
 *    "privilege of", "Program form IIM Calcutta" → "from", and "gear with" →
 *    "is geared with". Audit 1.12 asks for precisely this proofreading on the
 *    leadership pages. Nothing else is altered — the wording, the order and the
 *    emphasis are the school's own.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import LeaderMessage from '../../components/about/LeaderMessage.astro';
import banner from '../../assets/photos/sunbeem-2.jpg';
import portrait from '../../assets/photos/directorImage.jpeg';

const paragraphs = [
  'Sunbeam School Ballia has successfully fulfilled the need of a school which propagates education to inculcate the confidence in students to be global citizens yet be rooted to their culture and traditions.',
  'Sunbeam Ballia is geared with the best of infrastructure and has achieved new benchmarks in school education in the district.',
  'The school has been providing well-rounded holistic education to the students residing in and around the city of Ballia.',
  'Sunbeam Ballia has the proud privilege of providing a unique platform to young sportsmen by conducting Zonal and State Championships from time to time. Our students have grabbed prestigious positions in the state and have participated at the National level as well.',
  'I welcome you all to Sunbeam Ballia.',
];

const credentials = [
  'M.Sc. (Chemistry), Ph.D.',
  'EdLEAP: Education Leader Program from IIM Calcutta',
  'B.Ed. & P.G.D.C.A.',
];
---

<BaseLayout
  title="Director's Message — Sunbeam School Ballia"
  description="A message from Dr. Kunwar Arun Singh, Director of Sunbeam School Ballia, on the school's commitment to world-class education rooted in culture and tradition."
>
  <PageHero
    title="Director's Message"
    crumbs={[{ label: 'Home', href: '/' }, { label: 'About', href: '/about/' }]}
    src={banner}
    alt="Students and staff gathered at the entrance to Sunbeam School Ballia."
    position="50% 42%"
  />

  <div class="u-page-panel">
    <LeaderMessage
      eyebrow="Director Speak"
      heading="A word from our Director"
      name="Dr. Kunwar Arun Singh"
      role="Director, Sunbeam School Ballia"
      portrait={portrait}
      portraitAlt="Dr. Kunwar Arun Singh, Director of Sunbeam School Ballia."
      portraitBrief="Director portrait"
      pullQuote="Sunbeam Ballia is committed to make Ballia a name to reckon with for education and to provide world-class quality education."
      paragraphs={paragraphs}
      credentials={credentials}
    />
  </div>
</BaseLayout>

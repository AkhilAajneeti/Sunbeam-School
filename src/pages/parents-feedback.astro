---
/**
 * PARENTS' FEEDBACK.
 *
 * ⚠ THE BANNER IS STOCK PageHero, EXACTLY AS EVERY OTHER INTERNAL PAGE USES IT
 * — centred crumb, title and standfirst, no rule, no extra paragraph. An
 * earlier pass matched the reference's left-aligned banner instead, which
 * needed an `align` prop on PageHero and a block of page-level overrides; both
 * are gone and PageHero is back to its original file. If the left-aligned
 * treatment is ever wanted again it belongs in PageHero as a variant, not as a
 * page reaching into a component's scoped styles.
 *
 * ⚠ THE BANNER IS A FRAME LIFTED FROM THE SCHOOL'S OWN DRONE FOOTAGE, saved to
 * src/assets/photos/campus-entrance-wall.jpg. It is the shot in the reference —
 * the school's name carved into the brick wall, the palms behind it and the row
 * of potted plants along the drive. Neither clip's poster frame carried it
 * (hero-1 is the campus from above, hero-2 opens on the entrance arch), so it
 * was extracted at 13s from banner-2.MP4 rather than substituting a different
 * photograph. Re-cut it from that master if a cleaner frame is wanted.
 *
 * ⚠ THE TESTIMONIAL CAROUSEL SHIPS EMPTY. See data/parentsFeedback.ts; the
 * school has published no individual parent testimonial and none is invented.
 *
 * The navbar and footer are untouched.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import ParentsFeedbackPage from '../components/academics/partnership/ParentsFeedbackPage.astro';

import banner from '../assets/photos/campus-entrance-wall.jpg';
---

<BaseLayout
  title="Parents’ Feedback — Sunbeam School Ballia"
  description="Voices from the Sunbeam School Ballia community, and the documented channels through which parents take part — the Parents’ Forum, the Child–Parent–Teacher Dialogue, Art Integrated Learning and Parent Orientation."
>
  <PageHero
    title="Parents’ Feedback"
    standfirst="Voices from our school community"
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Parent Partnership', href: '/academics/parent-partnership/' },
    ]}
    src={banner}
    alt="The drive inside Sunbeam School Ballia at Agarsanda, the school’s name carved into the brick wall with palms and potted plants along it."
    position="46% 58%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <ParentsFeedbackPage />
  </div>
</BaseLayout>

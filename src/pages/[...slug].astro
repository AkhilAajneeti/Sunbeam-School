---
/**
 * EVERY NAVIGATION DESTINATION THAT HAS NO PAGE YET.
 *
 * ═══ WHY A GENERATED ROUTE AND NOT SIXTEEN FILES ═══════════════════════════
 *
 * Client: "if a page is not created, by default the user shouldn't see an error
 * screen and black screen." Sixteen links in the navigation pointed at nothing
 * and returned the framework's raw 404.
 *
 * ⚠ THE LIST IS DERIVED, NEVER TYPED. It is every internal href in
 * `data/navigation.ts` minus every route that already has a file in
 * `src/pages`. Both halves are computed at build time, which means:
 *
 *   · adding a nav link with no page behind it gets a proper page for free;
 *   · WRITING the real page silently retires the placeholder — the route
 *     disappears from this list the moment `src/pages/<path>.astro` exists,
 *     because a static route always wins over a rest route, and the glob
 *     below stops emitting it anyway.
 *
 * A hand-kept list would drift the first time either side changed, and the
 * failure would be silent: either a 404 nobody noticed, or a placeholder
 * shadowing a page somebody had just written.
 *
 * ⚠ ANCHOR-ONLY LINKS ARE NOT ROUTES. `/about/history-legacy/#leadership`
 * points into a page that exists; treating the fragment as part of the path
 * would mint a placeholder for a section that is already written. Hrefs are
 * cut at `#` before comparison.
 *
 * ⚠ EXTERNAL LINKS ARE NOT ROUTES EITHER. The results portal, the application
 * portals and the social channels all live on other domains and several are
 * stored as absolute URLs; only same-origin paths are considered.
 */
import PageSoon from '../components/ui/PageSoon.astro';
// Nav data is imported inside getStaticPaths, which is where it is used.

export async function getStaticPaths() {
  const { mainNav, utilityLinks, footerUtility } = await import('../data/navigation');

  /** "/a/b" and "/a/b/" are the same route; compare one shape only. */
  const norm = (href: string) => {
    const path = href.split('#')[0].split('?')[0];
    if (!path.startsWith('/')) return null; // external or mailto/tel
    return path.endsWith('/') ? path : `${path}/`;
  };

  /* Every internal destination the navigation offers, with the label the
     navigation gives it — so a placeholder is headed the same as the link the
     reader followed, rather than a slug turned back into words. */
  const wanted = new Map<string, { title: string; section?: { label: string; href: string } }>();

  const add = (href: string, title: string, section?: { label: string; href: string }) => {
    const path = norm(href);
    if (!path || path === '/') return;
    if (!wanted.has(path)) wanted.set(path, { title, section });
  };

  /* ⚠ `columns` IS NavChild[][] — an array of COLUMNS, each an array of links —
     and each link may carry its own `children`. An earlier version read
     `col.links`, which is undefined on an array, so not one child destination
     was ever collected and only the eight top-level items got pages. Walk both
     levels, recursively, or the deep links stay 404 while the build reports a
     healthy page count. */
  const walk = (links: readonly any[], section: { label: string; href: string }) => {
    for (const child of links) {
      if (!child.external) add(child.href, child.label, section);
      if (child.children?.length) walk(child.children, section);
    }
  };

  for (const item of mainNav) {
    const section = { label: item.label, href: item.href };
    add(item.href, item.label);
    for (const column of item.columns ?? []) walk(column, section);
    if (item.feature?.href) add(item.feature.href, item.feature.title, section);
  }

  /* ⚠ AFTER mainNav, NOT BEFORE — `add()` keeps the FIRST entry for a path, and
     the utility and footer rows carry a label but no parent section. Collected
     first, they won every shared destination and every breadcrumb read
     "Home › Uniform Catalogue" instead of "Home › Admissions ›". The nav is the
     richer source, so it goes first and these fill only the gaps. */
  for (const link of [...utilityLinks, ...footerUtility]) {
    if (!('external' in link && link.external)) add(link.href, link.label);
  }

  /* ═══ AND EVERY LINK THE COMPONENTS THEMSELVES WRITE ══════════════════════
   *
   * The navigation data is not the whole story, and assuming it was left ELEVEN
   * dead links behind after the first pass — `/academics/board-results/`,
   * `/campus/shooting-range/`, `/admissions/campus-visit/` and eight more, all
   * hard-coded in the footer and in homepage sections rather than in
   * `navigation.ts`. They only surfaced by crawling the built site.
   *
   * So the sources are read too. `?raw` gives the text at build time; comments
   * are stripped first, because `/about/achievements/` is commented out in two
   * files and a naive scan mints a page for a link that does not exist.
   *
   * ⚠ `.ts` AS WELL AS `.astro`, and leaving it out cost five more dead links.
   * Globbing only components still missed `/campus/shooting-range/`,
   * `/campus/auditorium/` and three others, because those hrefs live in
   * `data/home.ts` and are handed to a component as props — there is no literal
   * URL anywhere in the markup to find.
   *
   * The title falls back to the slug turned back into words — worse than the
   * navigation's own label, which is why this runs LAST and only fills gaps.
   */
  const sources = import.meta.glob(['../**/*.astro', '../data/**/*.ts'], {
    query: '?raw',
    import: 'default',
    eager: true,
  });

  const titleFromPath = (path: string) =>
    (path.split('/').filter(Boolean).pop() ?? '')
      .split('-')
      .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
      .join(' ');

  /* ⚠ THE DOT IS IN THE CHARACTER CLASS TO CATCH FILES, NOT TO ACCEPT THEM.
     An earlier pass stopped the capture at the first dot, so BaseLayout's font
     preloads — `href="/fonts/bricolage-grotesque-latin-wght-normal.woff2"` —
     were captured as `/fonts/bricolage-grotesque-latin-wght-normal`, a path with
     no extension left to recognise. Three "this section is being prepared"
     pages were built for three font files. Matching the extension is what makes
     it rejectable. */
  const isFile = (path: string) => (path.split('/').pop() ?? '').includes('.');

  for (const src of Object.values(sources) as string[]) {
    const clean = src.replace(/\/\*[\s\S]*?\*\//g, '').replace(/^\s*\/\/.*$/gm, '');
    for (const m of clean.matchAll(/href\s*[=:]\s*["'`{]?\s*["'`]?(\/[a-z0-9\-/.]*)/gi)) {
      if (isFile(m[1])) continue;
      add(m[1], titleFromPath(m[1]));
    }
  }

  /* Routes that already have a file. `/pages/a/b.astro` → `/a/b/`, and
     `index.astro` → the directory itself. */
  const built = new Set(
    Object.keys(import.meta.glob('./**/*.astro'))
      .filter((f) => !f.includes('[')) // this file, and any other rest route
      .map((f) => {
        const route = f.replace(/^\.\//, '/').replace(/\.astro$/, '').replace(/\/index$/, '/');
        return route.endsWith('/') ? route : `${route}/`;
      }),
  );

  return [...wanted.entries()]
    .filter(([path]) => !built.has(path))
    .map(([path, meta]) => ({
      /* Astro's rest param wants the path WITHOUT its leading and trailing
         slash — `/alumni/registration/` is the param "alumni/registration". */
      params: { slug: path.slice(1, -1) },
      props: meta,
    }));
}

interface Props {
  title: string;
  section?: { label: string; href: string };
}

const { title, section } = Astro.props;
---

<PageSoon title={title} section={section ?? null} />

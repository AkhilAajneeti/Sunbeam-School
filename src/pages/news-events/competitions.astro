---
/**
 * COMPETITIONS — News & Events sub-page.
 *
 * Content: the school's own /event-chronicles/, verbatim as to placings, names
 * and dates. See data/newsPages.ts.
 *
 * ⚠ THE SPORT HERE IS THE HOSTING, NOT THE SEASON. Fixtures, records and the
 * house system live on /beyond-academics/sports/ and are not duplicated. What
 * appears under "Hosted at Sunbeam" is there because the school RAN the
 * championship — a different claim, and one the sports page does not make.
 */
import ChronicleShell from '../../components/news/ChronicleShell.astro';
import { competitions } from '../../data/newsPages';

/* ⚠ THE HERO MUST BE A VERIFIED SUNBEAM BALLIA PHOTOGRAPH — this page was
   first built with `photos/sunbeem-students-3.jpg` and the client identified it
   as ANOTHER SCHOOL's: different crest, different uniform, "CITY" on the
   trophy. See docs/07 on why an unverifiable photograph is worse than no
   photograph — a school page that shows someone else's students is a false
   claim about the school, not a styling error.
                                       ↓
   This frame is the school's own JOSH ground, with "JOSH Sunbeam School" on the
   boundary wall, and it is the volleyball court the District Junior Volleyball
   Championship below was actually played on. The sports page hero comes from
   the same client-supplied set. */
import photo from '../../assets/JOSH GROUND/DSC_1283 copy.jpg';
---

<ChronicleShell
  page={competitions}
  photo={photo}
  alt="The JOSH ground at Sunbeam School Ballia, the volleyball court marked out and the school's name on the boundary wall"
  position="50% 55%"
/>

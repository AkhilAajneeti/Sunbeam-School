---
/**
 * ONE COMPETITION — routing only. The page is components/news/DetailPage.
 *
 * Same component as the workshops and school-events detail routes; only `page`
 * and `base` differ.
 */
import DetailPage from '../../../components/news/DetailPage.astro';
import { competitions, type ChronicleItem } from '../../../data/newsPages';

/* The index's own banner, so a page with no photographs of its own still opens
   on the school's ground rather than on a generic hall. See DetailPage's
   `fallbackHero`. */
import heroPhoto from '../../../assets/JOSH GROUND/DSC_1283 copy.jpg';

export async function getStaticPaths() {
  const { competitions: c } = await import('../../../data/newsPages');
  return c.groups.flatMap((g) =>
    g.items
      .filter((i) => i.slug)
      .map((item) => ({
        params: { slug: item.slug! },
        props: { item, group: g.label },
      })),
  );
}

interface Props {
  item: ChronicleItem;
  group: string;
}

const { item, group } = Astro.props;
---

<DetailPage
  item={item}
  group={group}
  page={competitions}
  base="/news-events/competitions/"
  fallbackHero={heroPhoto}
  fallbackAlt="The JOSH ground at Sunbeam School Ballia, the volleyball court marked out and the school's name on the boundary wall"
  metaLabel="Who took part"
  resultLabel="Result"
/>

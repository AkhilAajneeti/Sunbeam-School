---
/**
 * PAGER — numbered paging for a chronicle index.
 *
 * ⚠ THE FIRST PAGE IS THE BARE ROUTE, NOT `/page/1/`. Two URLs serving identical
 * content is the commonest way a site competes with itself in search, and it is
 * the school's own activities index that would be duplicated. `href()` below is
 * the single place that rule is expressed, so no caller can get it wrong.
 *
 * ⚠ IT RENDERS NOTHING WHEN THERE IS ONE PAGE. A paging control with a single
 * disabled "1" is an interface element that exists only to say there is nothing
 * to do.
 *
 * ⚠ <nav> WITH A LABEL, AND THE CURRENT PAGE MARKED `aria-current="page"`. A row
 * of bare number links is unnavigable by screen reader: no way to tell what the
 * numbers do, and no way to tell which one you are on.
 */
interface Props {
  /** 1-based. */
  current: number;
  total: number;
  /** Route prefix with trailing slash, e.g. '/beyond-academics/school-activities/'. */
  base: string;
  /** What is being paged, for the assistive-tech label. */
  label?: string;
}

const { current, total, base, label = 'pages' } = Astro.props;

const href = (n: number) => (n === 1 ? base : `${base}page/${n}/`);
const pages = Array.from({ length: total }, (_, i) => i + 1);
---

{
  total > 1 && (
    <nav class="pager" aria-label={`More ${label}`}>
      <div class="u-container pager__in">
        {/* ⚠ THE ARROWS ARE OMITTED AT THE ENDS, NOT DISABLED. A greyed-out
            control still takes a tab stop and still invites a click; absent, the
            row simply starts at "1". */}
        {current > 1 && (
          <a class="pager__step" href={href(current - 1)} rel="prev">
            <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M5 1L1 5l4 4M1 5h13" stroke="currentColor" stroke-width="1.7" />
            </svg>
            Previous
          </a>
        )}

        <ol class="pager__list">
          {pages.map((n) => (
            <li>
              {n === current ? (
                <span class="pager__n pager__n--now" aria-current="page">
                  {/* The count is announced because "3" alone tells a screen
                      reader nothing about where it sits in the set. */}
                  <span class="u-visually-hidden">Page </span>
                  {n}
                  <span class="u-visually-hidden"> of {total}, current page</span>
                </span>
              ) : (
                <a class="pager__n" href={href(n)}>
                  <span class="u-visually-hidden">Page </span>
                  {n}
                  <span class="u-visually-hidden"> of {total}</span>
                </a>
              )}
            </li>
          ))}
        </ol>

        {current < total && (
          <a class="pager__step" href={href(current + 1)} rel="next">
            Next
            <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.7" />
            </svg>
          </a>
        )}
      </div>
    </nav>
  )
}

<style>
  .pager {
    /* ⚠⚠ position + z-index ARE LOAD BEARING; THIS IS NOT DECORATION. PageHero
       is pinned (position: sticky, z-index: 0) and the page scrolls OVER it —
       .u-page-panel covers it by being `relative; z-index: 1` with an opaque
       ground. The pager renders as a SIBLING AFTER that panel, so it is not
       part of the covering layer, and a static box paints BELOW a positioned
       one with z-index: 0 no matter how late it comes in the DOM.

       Without these two lines the pinned banner shows through as a full-bleed
       strip of photograph directly above the page numbers, with the pills
       sitting half on top of it. The ivory background below is not enough on
       its own — it paints in the wrong layer.

       Matching the panel's z-index: 1 is the whole fix: the pager already wears
       the panel's ivory and is meant to read as a continuation of it. */
    position: relative;
    z-index: 1;
    background: var(--sb-ivory);
    padding-block: clamp(28px, 4vw, 52px);
  }

  .pager__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 1.4vw, 16px);
  }

  .pager__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* 44px square — comfortably past the 24×24 floor SC 2.5.8 sets, and these are
     the only controls in the band. */
  .pager__n {
    display: grid;
    place-items: center;
    min-width: 44px;
    height: 44px;
    padding-inline: 12px;
    border: 1px solid var(--sb-border);
    border-radius: 12px;
    background: #fff;
    font-family: var(--sb-font-display);
    font-size: 15px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--sb-charcoal);
    text-decoration: none;
    transition:
      background var(--sb-dur-link) ease,
      border-color var(--sb-dur-link) ease,
      color var(--sb-dur-link) ease;
  }

  .pager__n:hover {
    border-color: var(--sb-violet);
    background: var(--sb-violet-wash);
    color: var(--sb-violet-dark);
  }

  .pager__n:focus-visible { outline: 2px solid var(--sb-focus); outline-offset: 3px; }

  /* ⚠ THE CURRENT PAGE IS A <span>, NOT A LINK. A link to the page you are
     already on is a control that does nothing, and it costs a tab stop. */
  .pager__n--now {
    border-color: var(--sb-violet);
    background: var(--sb-violet);
    color: #fff; /* 5.08:1 */
    cursor: default;
  }

  .pager__step {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 44px;
    padding-inline: 18px;
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-full);
    background: #fff;
    font-size: 14px;
    font-weight: 700;
    color: var(--sb-charcoal);
    text-decoration: none;
    transition: background var(--sb-dur-link) ease, border-color var(--sb-dur-link) ease;
  }

  .pager__step:hover { border-color: var(--sb-violet); background: var(--sb-violet-wash); }
  .pager__step:focus-visible { outline: 2px solid var(--sb-focus); outline-offset: 3px; }

  @media (prefers-reduced-motion: reduce) {
    .pager__n,
    .pager__step { transition-duration: 1ms; }
  }
</style>

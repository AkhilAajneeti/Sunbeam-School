---
/**
 * SAFETY ICONS — one inline stroke set for the whole Safety & Security page.
 *
 * Inline, not an icon font or a sprite request: there are ~20 of them at 24px
 * and they must inherit `currentColor` so the same icon reads correctly on the
 * ivory timeline and on the ink surveillance band without a second asset.
 *
 * Every path is drawn on a 24-grid with a 1.5 stroke, so weights match the arrow
 * glyphs already used in the mega-menu and the tertiary links.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;

/** Stroke paths, 24×24. Keys are referenced by label in the section data. */
const paths: Record<string, string[]> = {
  shield: ['M12 3l7 3v5.5c0 4.2-2.9 7.6-7 8.5-4.1-.9-7-4.3-7-8.5V6l7-3Z'],
  camera: ['M3 8.5h3l1.4-2h8.2L17 8.5h4v10H3v-10Z', 'M12 16a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z'],
  gate: ['M3 20V8l9-4 9 4v12', 'M3 20h18', 'M9 20v-7h6v7', 'M12 4v4'],
  flame: ['M12 21c3.3 0 6-2.4 6-5.6 0-3.9-3.4-5.9-4.2-9.4-2 1.4-2.6 3.3-2.3 5-1-.6-1.6-1.6-1.7-2.8C8 9.6 6 12 6 15.4 6 18.6 8.7 21 12 21Z'],
  hose: ['M12 3v4', 'M7 21a5 5 0 0 1 10 0', 'M12 7a7 7 0 0 0-7 7v7h14v-7a7 7 0 0 0-7-7Z'],
  exit: ['M14 4h5v16h-5', 'M10 12H3', 'M6.5 8.5 3 12l3.5 3.5'],
  hand: ['M9 11V5.5a1.5 1.5 0 0 1 3 0V11', 'M12 10.5V4.8a1.5 1.5 0 0 1 3 0V11', 'M15 11V7.5a1.5 1.5 0 0 1 3 0V15a6 6 0 0 1-6 6h-1a6 6 0 0 1-6-6v-3a1.5 1.5 0 0 1 3 0'],
  lift: ['M5 3h14v18H5V3Z', 'M12 3v18', 'M8.5 9 10 7l1.5 2', 'M8.5 15 10 17l1.5-2'],
  walk: ['M13 4.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z', 'M11 22l1.5-6L10 13V9l4-1.5 3 3 2.5 1', 'M9 22l2-5'],
  gps: ['M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z', 'M12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z'],
  speed: ['M4 18a9 9 0 1 1 16 0', 'M12 14l4-4'],
  route: ['M6.5 7.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z', 'M17.5 21.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z', 'M6.5 7.5v5a4 4 0 0 0 4 4h7'],
  badge: ['M12 3l7 3v5.5c0 4.2-2.9 7.6-7 8.5-4.1-.9-7-4.3-7-8.5V6l7-3Z', 'm8.8 11.8 2.2 2.2 4.2-4.2'],
  person: ['M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z', 'M4.5 21a7.5 7.5 0 0 1 15 0'],
  message: ['M21 15a3 3 0 0 1-3 3H8l-5 3V6a3 3 0 0 1 3-3h12a3 3 0 0 1 3 3v9Z'],
  heart: ['M12 20.5S3.5 15 3.5 9.4A4.4 4.4 0 0 1 12 7.6a4.4 4.4 0 0 1 8.5 1.8c0 5.6-8.5 11.1-8.5 11.1Z'],
  cross: ['M4 6.5h16v13H4v-13Z', 'M9 3.5h6v3H9v-3Z', 'M12 10v6', 'M9 13h6'],
  droplet: ['M12 3s6 6.4 6 10a6 6 0 0 1-12 0c0-3.6 6-10 6-10Z'],
  eye: ['M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6-10-6-10-6Z', 'M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z'],
  log: ['M5 3h11l3 3v15H5V3Z', 'M9 9h6', 'M9 13h6', 'M9 17h4'],
  alert: ['M12 3 2 20h20L12 3Z', 'M12 9v5', 'M12 17.2v.1'],
  assemble: ['M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z', 'M9 10.5h6'],
  roll: ['M5 3h14v18H5V3Z', 'M9 8h6', 'M9 12h6', 'M9 16h3'],
  lock: ['M6 10.5h12V21H6V10.5Z', 'M8.5 10.5V7a3.5 3.5 0 1 1 7 0v3.5'],
};

const d = paths[name] ?? paths.shield;
---

<svg
  class:list={['sfi', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {d.map((p) => <path d={p} />)}
</svg>

<style>
  .sfi {
    display: block;
    flex-shrink: 0;
  }
</style>

---
/**
 * THE TRIPS — the original page's block structure.
 *
 * ═══ WHY THIS IS THE THIRD ATTEMPT ══════════════════════════════════════════
 *
 * Build one alternated tinted panels left and right. Build two tiered the page —
 * a flagship, five standard, a compact tier. Build three made every trip a
 * full-bleed editorial band. All three were wrong for the same reason: THE
 * CLIENT KEPT ASKING FOR THEIR OWN PAGE'S STRUCTURE and I kept designing over
 * the top of it.
 *
 * Their structure is: a heading, the account of the trip, and that trip's own
 * photographs, repeated for each trip. That is what a reader wants and it is
 * what this now does — deliberately IDENTICAL to Record.astro on the Sports
 * page, which the client approved, so the two pages finally read as one site.
 *
 * The styling is ours: their type, spacing and 150×150 thumbnails are what the
 * audit objects to, not their information design.
 *
 * ⚠ ONE SCRIPT, MANY RAILS. There is a gallery per trip. The script binds PER
 * RAIL inside a loop — `document.querySelector` would wire the first and leave
 * the rest looking enabled but inert.
 */
import { Picture } from 'astro:assets';
import { trips, photo } from '../../../data/excursions';
import SectionHead from '../../academics/SectionHead.astro';
---

<section class="trip" id="trips" aria-labelledby="trip-title">
  <div class="u-container">
    <SectionHead
      id="trip-title"
      eyebrow="Where the classroom goes"
      heading="The trips"
      stand="Seven journeys the school has published, each with its own account and its own photographs."
      align="start"
      measure={18}
    />
  </div>

  {trips.map((t, i) => (
    <article class="tblk" id={t.id}>
      <div class="u-container tblk__head">
        <p class="tblk__kicker t-label">
          <svg width="12" height="15" viewBox="0 0 12 15" fill="none" aria-hidden="true">
            <path d="M6 14s5-5.2 5-8.4A5 5 0 1 0 1 5.6C1 8.8 6 14 6 14Z" stroke="currentColor" stroke-width="1.5" />
            <circle cx="6" cy="5.5" r="1.8" fill="currentColor" />
          </svg>
          {t.place}
          <span class="tblk__dot" aria-hidden="true"></span>
          <span class="t-tabular">{t.year}</span>
          <span class="tblk__dot" aria-hidden="true"></span>
          {t.who}
        </p>

        <h3 class="tblk__h">{t.title}</h3>

        <p class="tblk__b">{t.body}</p>

        {/* Only where the school published a result. A block without one simply
            ends — inventing an outcome to square the layout is the exact failure
            this page has been rebuilt away from. */}
        {t.outcome && <p class="tblk__outcome">{t.outcome}</p>}
      </div>

      {/* The gallery bleeds off the right edge: a row cut by the viewport is the
          clearest signal that there is more of it. */}
      <div class="tblk__rail-wrap">
        <div
          class="tblk__rail"
          data-trip-rail
          tabindex="0"
          role="region"
          aria-label={`Photographs — ${t.title}. Scroll sideways for more.`}
        >
          <ul class="tblk__track">
            {t.shots.map((s, si) => (
              <li class="tblk__frame">
                <Picture
                  src={photo[s]}
                  alt={si === 0 ? t.alt : ''}
                  formats={['webp']}
                  widths={[420, 840]}
                  sizes="(max-width: 700px) 78vw, 380px"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </li>
            ))}
            {/* A real element: Chrome omits a flex container's end padding from
                scrollWidth, so the last frame could never reach the margin. */}
            <li class="tblk__tail" aria-hidden="true"></li>
          </ul>
        </div>

        {t.shots.length > 2 && (
          <div class="tblk__btns" data-trip-btns hidden>
            <button class="tblk__btn" type="button" data-trip-prev aria-label={`Previous photographs from ${t.title}`}>
              <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M5 1L1 5l4 4M1 5h13" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </button>
            <button class="tblk__btn" type="button" data-trip-next aria-label={`More photographs from ${t.title}`}>
              <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </button>
          </div>
        )}
      </div>
    </article>
  ))}
</section>

<style>
  .trip {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
  }

  .tblk { padding-top: clamp(40px, 6vh, 76px); }

  /* A hairline between blocks — seven of them need a boundary, and a rule is
     quieter than seven boxes. */
  .tblk + .tblk .tblk__head::before {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: clamp(32px, 5vh, 60px);
    background: var(--sb-border);
  }

  .tblk__kicker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sb-3);
    color: var(--sb-violet);
  }

  .tblk__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }

  .tblk__h {
    margin-top: var(--sb-4);
    max-width: 22ch;
    font-family: var(--sb-font-display);
    font-size: clamp(23px, 2.6vw, 38px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.033em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .tblk__b {
    margin-top: var(--sb-5);
    max-width: 62ch;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.68;
    color: var(--sb-text-secondary);
  }

  .tblk__outcome {
    margin-top: var(--sb-6);
    max-width: 62ch;
    padding-left: var(--sb-6);
    border-left: 2px solid var(--sb-violet);
    font-size: var(--sb-body-sm);
    font-weight: 600;
    line-height: 1.6;
    color: var(--sb-charcoal);
  }

  /* --- The gallery ---------------------------------------------------------- */

  .tblk__rail-wrap {
    position: relative;
    margin-top: clamp(22px, 3vh, 36px);
  }

  .tblk__rail {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    /* Must match the track's left padding, or frame one can only satisfy its own
       snap by resting part-scrolled — which leaves the rail loading at an offset
       and "previous" enabled before anyone has scrolled. */
    scroll-padding-inline: max(var(--sb-margin), calc(50vw - var(--sb-max-content) / 2));
    scrollbar-width: none;
  }

  .tblk__rail::-webkit-scrollbar { display: none; }

  .tblk__rail:focus-visible { outline: 2px solid var(--sb-focus); outline-offset: -3px; }

  .tblk__track {
    display: flex;
    gap: clamp(10px, 1vw, 15px);
    list-style: none;
    margin: 0;
    /* Lines frame one up with the paragraph above it. */
    padding-left: max(var(--sb-margin), calc(50vw - var(--sb-max-content) / 2));
    padding-right: 0;
  }

  .tblk__frame {
    flex: 0 0 clamp(230px, 27vw, 380px);
    scroll-snap-align: start;
    border-radius: 14px;
    overflow: hidden;
    background: var(--sb-sand);
  }

  /* `height: auto` with an aspect-ratio, NOT the source's height. Astro's
     <Picture> emits width/height attributes — presentational hints that map to
     the CSS width and height properties — and base.css resets `max-width`
     WITHOUT `height: auto`, so without this every frame renders at its source
     height and the row runs to thousands of pixels. */
  .tblk__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 700ms var(--sb-ease);
  }

  .tblk__frame:hover :global(img) { transform: scale(1.05); }

  .tblk__tail {
    flex: 0 0 calc(
      max(var(--sb-margin), calc(50vw - var(--sb-max-content) / 2)) - clamp(10px, 1vw, 15px)
    );
  }

  .tblk__btns {
    position: absolute;
    right: max(var(--sb-margin), calc(50vw - var(--sb-max-content) / 2));
    top: calc(-1 * clamp(22px, 3vh, 36px) - 44px);
    display: flex;
    gap: var(--sb-3);
  }

  /* `display: flex` would beat the `hidden` attribute's UA rule, which is a
     classic way to ship a control that cannot work. */
  .tblk__btns[hidden] { display: none; }

  .tblk__btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--sb-border-strong);
    border-radius: 50%;
    background: var(--sb-paper);
    color: var(--sb-charcoal);
    cursor: pointer;
    transition: background var(--sb-dur-btn) ease, border-color var(--sb-dur-btn) ease, transform var(--sb-dur-btn) var(--sb-ease);
  }

  .tblk__btn:hover:not(:disabled) {
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    color: #fff;
    transform: translateY(-2px);
  }

  .tblk__btn:disabled { opacity: 0.32; cursor: default; }

  @media (max-width: 900px) {
    /* The arrows would sit on the heading at this width, and the rail drags
       perfectly well with a finger. */
    .tblk__btns { display: none; }
  }

  @media (max-width: 700px) {
    .tblk__frame { flex: 0 0 78vw; }
  }
</style>

<script>
  /**
   * The galleries' arrow buttons — one binding per rail, in a loop.
   * Identical to the implementation on the Sports page's record section; see the
   * note there on why `document.querySelector` is the wrong shape here.
   *
   * Everything is an enhancement: each rail is a real overflow scroller with
   * scroll-snap, so flick, trackpad, shift-wheel, arrow keys and screen-reader
   * scrolling already work without any of this.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-trip-rail]').forEach((rail) => {
    const btns = rail.parentElement?.querySelector<HTMLElement>('[data-trip-btns]');
    if (!btns) return;

    const prev = btns.querySelector<HTMLButtonElement>('[data-trip-prev]')!;
    const next = btns.querySelector<HTMLButtonElement>('[data-trip-next]')!;
    btns.hidden = false;

    /* A step is ONE FRAME, measured from the DOM: the frame basis and the gap
       are both clamp()s, so a hard-coded number would be wrong at most widths. */
    const pitch = () => {
      const f = rail.querySelectorAll<HTMLElement>('.tblk__frame');
      if (f.length < 2) return rail.clientWidth * 0.8;
      return f[1].getBoundingClientRect().left - f[0].getBoundingClientRect().left;
    };

    /* The 2px slack absorbs fractional scroll positions, which otherwise leave
       "next" enabled for ever at the right-hand end on non-integer DPRs. */
    const sync = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      prev.disabled = rail.scrollLeft <= 2;
      next.disabled = rail.scrollLeft >= max - 2;
    };

    prev.addEventListener('click', () =>
      rail.scrollBy({ left: -pitch(), behavior: reduced.matches ? 'auto' : 'smooth' }));
    next.addEventListener('click', () =>
      rail.scrollBy({ left: pitch(), behavior: reduced.matches ? 'auto' : 'smooth' }));
    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });
</script>

---
/**
 * NCC, SCOUTS & GUIDES — the body of /beyond-academics/ncc-scouts-guides/.
 *
 * ⚠⚠ READ data/uniformedGroups.ts FIRST. Three verified facts exist for NCC and
 * ZERO for Scouts & Guides. Nothing on this page may be added that is not in
 * that file, and nothing may be added to that file that the school has not
 * published. See the long note at the top of it.
 *
 * ⚠ THE TWO GROUPS DELIBERATELY LOOK DIFFERENT. NCC is a real affiliation and
 * reads as one — solid card, facts listed. Scouts & Guides has no record at all
 * and reads as unfinished — flat, dashed edge, no facts. A parent should be able
 * to tell which is which without reading a word.
 *
 * ⚠ "What the school has not published" IS A FEATURE OF THIS PAGE, NOT AN
 * APOLOGY. It appears under BOTH groups, including the one that has facts.
 */
import { groups } from '../../../data/uniformedGroups';
import { school } from '../../../data/site';
import PendingBlock from '../../ui/PendingBlock.astro';
import { Picture } from 'astro:assets';
---

<div class="ung">
  <span class="ung__blob ung__blob--a" aria-hidden="true"></span>
  <span class="ung__blob ung__blob--b" aria-hidden="true"></span>

  <div class="u-container ung__wrap">
    {groups.map((g, gi) => (
      <section
        class:list={['ung__grp', g.facts.length === 0 && 'ung__grp--pending']}
        id={g.id}
        aria-labelledby={`${g.id}-t`}
        data-reveal
        data-reveal-delay={gi * 90}
      >
        <div class="ung__head">
          <span class="ung__icon" aria-hidden="true">
            {g.icon === 'badge' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="9" r="4.6" /><path d="m8.4 13.4-1.4 7 5-2.6 5 2.6-1.4-7" />
              </svg>
            )}
            {g.icon === 'compass' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="8.6" /><path d="m15 9-2.2 4.8L8 16l2.2-4.8Z" />
              </svg>
            )}
          </span>
          <div>
            <h2 class="ung__h" id={`${g.id}-t`}>{g.title}</h2>
            <p class="ung__stand">{g.standfirst}</p>
          </div>
        </div>

        {g.facts.length > 0 ? (
          <ul class="ung__facts">
            {g.facts.map((f) => (
              <li class="ung__fact">
                <span class="ung__fact-k">{f.label}</span>
                <span class="ung__fact-v">{f.detail}</span>
              </li>
            ))}
          </ul>
        ) : (
          <div class="ung__pending">
            {/* Real text, first in reading order — same rule as PendingBlock. */}
            <p class="ung__stamp">Information pending</p>
            <p class="ung__pending-b">{g.pending}</p>
          </div>
        )}

        {/* ── Officers, as the school names them ─────────────────────────── */}
        {g.officers && g.officers.length > 0 && (
          <div class="ung__block">
            <p class="ung__block-k">Officers</p>
            <ul class="ung__officers">
              {g.officers.map((o) => (
                <li>
                  <span class="ung__officer-n">{o.name}</span>
                  <span class="ung__officer-r">{o.role}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* ── What the school has published happening ─────────────────────── */}
        {g.record && g.record.length > 0 && (
          <div class="ung__block">
            <p class="ung__block-k">On the record</p>
            <ul class="ung__record">
              {g.record.map((r) => (
                <li>
                  <span class="ung__rec-t">{r.title}</span>
                  <span class="ung__rec-d">{r.detail}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* ⚠ REAL PHOTOGRAPHS OF THIS SCHOOL'S OWN CADETS. Every caption
            describes what is in the frame and stops — see the data file. */}
        {g.photos && g.photos.length > 0 && (
          <ul class="ung__shots">
            {g.photos.map((ph, pi) => (
              <li data-reveal data-reveal-delay={pi * 70}>
                <figure>
                  <Picture
                    src={ph.src}
                    alt={ph.alt}
                    formats={['avif', 'webp']}
                    widths={[360, 640, 960]}
                    sizes="(max-width: 599px) 90vw, (max-width: 1023px) 44vw, 23vw"
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{ph.caption}</figcaption>
                </figure>
              </li>
            ))}
          </ul>
        )}

        {/* ⚠ PLACEHOLDER SUB-SECTIONS — structurally complete, factually empty.
            See the note on `placeholders` in data/uniformedGroups.ts. */}
        {g.placeholders && g.placeholders.length > 0 && (
          <div class="ung__ph">
            {g.placeholders.map((ph) => (
              <PendingBlock title={ph.title} body={ph.body} needs={ph.needs} icon={ph.icon} ref="A13" />
            ))}
          </div>
        )}

        {/* ⚠ PRINTED FOR BOTH GROUPS, including the one that has facts. */}
        <div class="ung__missing">
          <p class="ung__missing-k">What the school has not published</p>
          <ul>
            {g.missing.map((m) => <li>{m}</li>)}
          </ul>
        </div>
      </section>
    ))}

    <p class="ung__foot" data-reveal>
      Anything not stated here has not been published by the school. For NCC enrolment or a
      Scouts and Guides enquiry, call
      <a href={`tel:${school.phone.office}`}>{school.phone.officeDisplay}</a>
      or write to <a href={`mailto:${school.email}`}>{school.email}</a>.
    </p>
  </div>
</div>

<style>
  .ung {
    position: relative;
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
    overflow: hidden;
    isolation: isolate;
  }

  .ung__wrap { position: relative; }

  .ung__blob {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    filter: blur(70px);
    pointer-events: none;
  }

  .ung__blob--a { top: -140px; left: -170px; width: 440px; height: 380px; background: rgba(255, 138, 99, 0.18); }
  .ung__blob--b { bottom: -160px; right: -170px; width: 430px; height: 380px; background: rgba(255, 176, 120, 0.14); }

  .ung__grp {
    padding: clamp(20px, 2.6vw, 34px);
    background: var(--sb-paper);
    border: 1px solid rgba(18, 16, 15, 0.07);
    border-radius: var(--sb-r-0);
    box-shadow: 0 1px 3px rgba(28, 14, 8, 0.04), 0 10px 26px -14px rgba(28, 14, 8, 0.18);
  }

  .ung__grp + .ung__grp { margin-top: var(--sb-6); }

  /* ⚠ THE GROUP WITH NO RECORD READS AS UNFINISHED ON PURPOSE. */
  .ung__grp--pending {
    background: transparent;
    border: 1px dashed rgba(18, 16, 15, 0.2);
    box-shadow: none;
  }

  .ung__head { display: flex; gap: var(--sb-5); align-items: flex-start; }

  .ung__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--sb-lime-wash);
    color: var(--sb-violet);
  }

  .ung__grp--pending .ung__icon { background: rgba(18, 16, 15, 0.05); color: var(--sb-text-muted); }
  .ung__icon svg { width: 22px; height: 22px; }

  .ung__h {
    margin: 0;
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(19px, 2vw, 26px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--sb-ink);
  }

  .ung__stand {
    max-width: 62ch;
    margin: 6px 0 0;
    font-size: var(--sb-body-sm);
    line-height: 1.6;
    color: var(--sb-text-muted);
  }

  .ung__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sb-5);
    margin: var(--sb-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .ung__fact {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: var(--sb-5);
    background: var(--sb-ivory);
    border-radius: var(--sb-r-0);
  }

  .ung__fact-k { font-weight: 700; font-size: var(--sb-body-sm); line-height: 1.3; color: var(--sb-ink); }
  .ung__fact-v { font-size: var(--sb-caption); line-height: 1.55; color: var(--sb-text-muted); }

  .ung__pending { margin: var(--sb-6) 0 0; }

  .ung__ph {
    display: grid;
    gap: var(--sb-5);
    margin-top: var(--sb-6);
  }

  @media (min-width: 900px) {
    .ung__ph { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .ung__stamp {
    margin: 0 0 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }

  .ung__pending-b {
    max-width: 72ch;
    margin: 0;
    font-size: var(--sb-body-sm);
    line-height: 1.65;
    color: var(--sb-text-muted);
  }

  /* --- Officers and the published record ---------------------------------- */
  .ung__block { margin-top: var(--sb-6); }

  .ung__block-k {
    margin: 0 0 9px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }

  .ung__officers {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ung__officers li {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px var(--sb-5);
    background: var(--sb-ivory);
    border-radius: var(--sb-r-0);
  }

  .ung__officer-n { font-weight: 700; font-size: var(--sb-body-sm); color: var(--sb-ink); }
  .ung__officer-r { font-size: var(--sb-caption); color: var(--sb-text-muted); }

  .ung__record { display: grid; gap: var(--sb-4); margin: 0; padding: 0; list-style: none; }

  .ung__record li {
    display: grid;
    gap: 3px;
    padding-left: var(--sb-5);
    border-left: 2px solid var(--sb-lime-wash);
  }

  .ung__rec-t { font-weight: 700; font-size: var(--sb-body-sm); line-height: 1.3; color: var(--sb-ink); }
  .ung__rec-d { font-size: var(--sb-caption); line-height: 1.55; color: var(--sb-text-muted); }

  /* --- Photographs ---------------------------------------------------------- */
  .ung__shots {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sb-5);
    margin: var(--sb-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .ung__shots figure { margin: 0; }

  /* ⚠⚠ :global(img), AND WITHOUT IT THIS RULE MATCHES NOTHING. The <img> is
     rendered by <Picture>, a CHILD COMPONENT — so it never receives this
     component's data-astro-cid attribute, and a plain `.ung__shots img`
     compiles to `.ung__shots img[data-astro-cid-…]`, which selects no element
     on the page. Measured before the fix: the frames came out 1066px tall at a
     291px column, because `aspect-ratio` was never applied at all.

     ⚠ THE :global() IS ANCHORED ON .ung__shots, WHICH THIS COMPONENT DOES
     RENDER. That is what keeps it scoped to this section instead of restyling
     every image on the site. Never write a bare :global(img). */
  .ung__shots :global(img) {
    display: block;
    width: 100%;
    /* ⚠⚠ height:auto IS LOAD-BEARING, NOT TIDINESS. <Picture> emits width and
       height ATTRIBUTES on the <img>, and those are presentational hints that
       map to CSS height. A definite height makes the box ignore aspect-ratio
       entirely — measured, the frames came out 1066px tall in a 291px column
       with `aspect-ratio: 4 / 3` computing correctly and doing nothing.
       Setting height:auto releases the hint so the ratio can size the box. */
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--sb-r-0);
  }

  .ung__shots figcaption {
    margin-top: 7px;
    font-size: var(--sb-caption);
    line-height: 1.45;
    color: var(--sb-text-muted);
  }

  @media (max-width: 1023px) {
    .ung__shots { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 599px) {
    .ung__shots { grid-template-columns: minmax(0, 1fr); }
  }

  .ung__missing {
    margin-top: var(--sb-6);
    padding-top: var(--sb-5);
    border-top: 1px solid rgba(18, 16, 15, 0.09);
  }

  .ung__missing-k {
    margin: 0 0 8px;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }

  .ung__missing ul {
    display: flex;
    flex-wrap: wrap;
    gap: 7px 9px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ung__missing li {
    padding: 4px 11px;
    border-radius: 999px;
    border: 1px dashed rgba(18, 16, 15, 0.22);
    font-size: var(--sb-caption);
    line-height: 1.4;
    color: var(--sb-text-muted);
  }

  .ung__foot {
    max-width: 68ch;
    margin: var(--sb-8) auto 0;
    text-align: center;
    font-size: var(--sb-body-sm);
    line-height: 1.6;
    color: var(--sb-text-muted);
  }

  .ung__foot a { color: var(--sb-violet); border-bottom: 1px solid currentColor; }

  @media (max-width: 899px) {
    .ung__facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 599px) {
    .ung__facts { grid-template-columns: minmax(0, 1fr); }
  }
</style>

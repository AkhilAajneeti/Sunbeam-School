---
/**
 * C02 · MASTHEAD — docs/06 §02
 *
 * Crest + wordmark left, Apply Online right, and the navigation on its own
 * full-width row beneath. Sticky; condenses 96 → 68px on scroll.
 *
 * IMPLEMENTATION NOTE — TWO ROWS, and the desktop threshold is 1280px.
 *
 * The client requires all eleven audit sections on the main menu. Named
 * verbatim they measure 1117px of link text at 14px — "School Planner &
 * Academic Calendar" (§8) is 253px on its own, "Latest News & Events" (§11)
 * 148px — and the container caps at 1280px. Beside the brand lockup (242px) and
 * the Apply button (151px) a single row leaves roughly 810px, so eleven items
 * cannot share a line with the brand at any type size worth reading. Giving the
 * nav its own row hands it the full container and is what makes eleven possible.
 *
 * Measured slack in Chromium, one row at every width: 81px at 1280, 95px at
 * 1360, 52px at 1440 and above (the floor — the container stops growing while
 * the gap clamp does not). Below 1280 the drawer takes over.
 */
import { mainNav } from '../../data/navigation';
import MegaMenu from './MegaMenu.astro';
---

<header class="masthead" data-masthead>
  <div class="masthead__inner u-container">
    <a class="brand" href="/" aria-label="Sunbeam School Ballia — home">
      <img
        class="brand__emblem"
        src="/brand/sunbeam-emblem.png"
        alt=""
        width="191"
        height="150"
        decoding="async"
      />
      <img
        class="brand__wordmark"
        src="/brand/sunbeam-wordmark.png"
        alt="Sunbeam School Ballia"
        width="588"
        height="178"
        decoding="async"
      />
    </a>

    <nav class="mainnav" aria-label="Main">
      <ul class="mainnav__list">
        {mainNav.map((item) => (
          <li class:list={['mainnav__item', item.columns && 'mainnav__item--has-mega']}>
            <a class="mainnav__link" href={item.href}>{item.label}</a>
            {item.columns && <MegaMenu item={item} />}
          </li>
        ))}
      </ul>
    </nav>

    <div class="masthead__actions">
      <a class="btn btn--primary masthead__apply" href="/admissions/">Apply Online</a>
      <button
        class="masthead__toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="masthead__toggle-bars" aria-hidden="true"><i></i><i></i></span>
        <span class="masthead__toggle-text">Menu</span>
      </button>
    </div>
  </div>

</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--sb-paper);
    border-bottom: var(--sb-hairline);
    transition: box-shadow var(--sb-dur-nav) ease;
  }

  .masthead.is-scrolled {
    box-shadow: var(--sb-shadow-header);
  }

  /* Tucked away once the footer reaches the top of the viewport. A sticky header
     will always sit on whatever lands beneath it, and at the end of the page
     that was slicing the top off the footer's wordmark at shorter viewport
     heights. Scrolling up brings it straight back. */
  .masthead.is-tucked {
    transform: translateY(-100%);
  }

  .masthead {
    transition: box-shadow var(--sb-dur-nav) ease,
      transform var(--sb-dur-nav) var(--sb-ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead { transition: none; }
  }

  .masthead__inner {
    height: var(--sb-masthead-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Capped, not clamp(20px, 2vw, 40px): the container stops growing at 1280
       but vw does not, so the old gap widened on big screens while the space it
       had to fit into stayed fixed — 1920 overflowed harder than 1440 did. */
    gap: clamp(12px, 1.1vw, 16px);
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  /* --- Brand ------------------------------------------------------------- */

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  /* 52/48 rather than 60/56: the doc's verbatim labels cost the nav ~120px over
     the short ones, and the lockup is where that comes back from. 279 → 242px. */
  .brand__emblem {
    height: 52px;
    width: auto;
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  .brand__wordmark {
    height: 48px;
    width: auto;
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  /* Shrinks on scroll so the sticky bar stays shallow — same ratio as above. */
  .masthead.is-scrolled .brand__emblem { height: 52px; }
  .masthead.is-scrolled .brand__wordmark { height: 48px; }

  /* --- Main navigation --------------------------------------------------- */

  .mainnav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .mainnav__list {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Wraps rather than overflows: if a longer label is ever added the row drops
       to a second line instead of pushing a horizontal scrollbar onto every
       page — `body` is overflow-x:hidden, so that bug shows up as the whole
       document sliding sideways, not as a broken header. */
    flex-wrap: wrap;
    gap: 0 clamp(9px, 0.95vw, 13px);
  }

  /* relative — the multi-level panel is narrow and hangs off its own trigger,
     so the item is the containing block. (The 920px glass panel that briefly
     lived here had to centre on the nav instead; this one does not.) */
  .mainnav__item {
    position: relative;
  }

  .mainnav__link {
    position: relative;
    display: inline-block;
    padding: 11px 2px;
    /* Fluid, and the cap is set by measurement rather than taste: the nine
       labels plus the Apply button and the brand lockup need every pixel the
       1280px container has. At 13.5px the row wrapped at 1280, 1600 and 1920. */
    font-size: clamp(12px, 0.92vw, 13px);
    font-weight: 600;
    color: var(--sb-charcoal);
    white-space: nowrap;
    transition: color var(--sb-dur-link) ease;
  }

  /* Active/hover indicator: 2px maroon rule, wipes in from the left. */
  .mainnav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--sb-violet);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--sb-dur-link) var(--sb-ease);
  }

  .mainnav__item:hover .mainnav__link,
  .mainnav__item:focus-within .mainnav__link {
    color: var(--sb-violet);
  }

  .mainnav__item:hover .mainnav__link::after,
  .mainnav__item:focus-within .mainnav__link::after {
    transform: scaleX(1);
  }

  /* CSS-first mega-menu reveal. */
  .mainnav__item--has-mega:hover :global(.mega),
  .mainnav__item--has-mega:focus-within :global(.mega) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity var(--sb-dur-menu) ease,
      transform var(--sb-dur-menu) var(--sb-ease);
  }

  /* ONE PANEL AT A TIME. Hover and focus both open a menu, so a keyboard user
     who has tabbed into one and then moves the pointer over another had two
     open together. That was survivable when each panel hung off its own item —
     they sat side by side. Now every panel is centred on the nav, so two open
     panels stack directly on top of each other and the menu reads as corrupt.
     Whenever the pointer is over the bar, hover wins and any focus-held panel
     that is not also hovered is suppressed. */
  .mainnav:hover .mainnav__item--has-mega:not(:hover) :global(.mega) {
    opacity: 0;
    visibility: hidden;
    transition-delay: 0ms;
  }

  .masthead.is-mega-suppressed :global(.mega) {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* --- Actions ----------------------------------------------------------- */

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: var(--sb-5);
    flex-shrink: 0;
  }

  .masthead__toggle {
    display: none;
    align-items: center;
    gap: var(--sb-3);
    min-height: 48px;
    padding: 0 var(--sb-2);
    font-size: var(--sb-body-sm);
    font-weight: 600;
    color: var(--sb-charcoal);
  }

  .masthead__toggle-bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 22px;
    height: 14px;
  }

  .masthead__toggle-bars i {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--sb-charcoal);
    border-radius: 2px;
    transition: transform 320ms var(--sb-ease);
  }

  /* --- Hamburger → cross ---------------------------------------------------
     The maths, so the X is actually centred rather than approximately so: two
     2px bars with a 5px gap occupy 9px inside a 14px box, so their centres sit
     at 3.5px and 10.5px while the box centre is 7px. Each bar therefore travels
     exactly 3.5px inward before rotating, and the two strokes cross dead centre.

     Driven off `aria-expanded`, not a class — the attribute has to be correct
     for assistive tech anyway, so keying the visual to it means the two can
     never disagree. */
  .masthead__toggle[aria-expanded='true'] .masthead__toggle-bars i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .masthead__toggle[aria-expanded='true'] .masthead__toggle-bars i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ABOVE THE DRAWER WHILE IT IS OPEN. The drawer sits at z-index 100 and this
     header at 50, so the toggle was behind the scrim and unclickable — a
     hamburger that morphs into a cross is pointless if the cross cannot be
     pressed. Raised only while open, so the resting stack is unchanged. */
  .masthead.is-nav-open {
    z-index: 120;
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead__toggle-bars i { transition: none; }
  }

  /* --- Below 1360: drawer takes over --------------------------------------
     THE BUG THIS PREVENTS IS A HORIZONTAL SCROLLBAR ON EVERY PAGE. Because
     `body` is `overflow-x: hidden` an over-wide header never shows as a broken
     header — it shows as the whole document scrolling sideways, which on a
     full-bleed layout looks like every band stopping short of the right edge.

     Moving the nav onto its own row bought back everything the brand lockup and
     the Apply button used to take, which is what makes eleven items possible at
     all. The threshold is set from the measured width of the eleven links; see
     the figures recorded in the header comment above. Below it the drawer takes
     over, which is honest, rather than a nav squeezed past legibility.

     ⚠ RE-MEASURE IF A TWELFTH ITEM OR A LONGER LABEL IS ADDED. The list wraps
     rather than overflowing, so the failure mode is a second row appearing, not
     a sideways-scrolling page. */

  @media (max-width: 1279px) {
    .mainnav { display: none; }
    .masthead__toggle { display: inline-flex; }
  }

  /* 1280–1439 is where the row is tightest: the container is still growing but
     has not reached its 1280 cap, so the nav has less room than it does at 1440
     while carrying exactly the same labels. The lockup steps down one notch
     there rather than the type shrinking further. */
  @media (max-width: 1439px) {
    .brand__emblem,
    .masthead.is-scrolled .brand__emblem { height: 44px; }
    .brand__wordmark,
    .masthead.is-scrolled .brand__wordmark { height: 40px; }
  }

  @media (max-width: 1023px) {
    .brand__emblem { height: 44px; }
    .brand__wordmark { height: 40px; }
    .masthead.is-scrolled .brand__emblem { height: 38px; }
    .masthead.is-scrolled .brand__wordmark { height: 34px; }
  }

  @media (max-width: 767px) {
    .brand { gap: 10px; }
    .brand__emblem { height: 38px; }
    .brand__wordmark { height: 34px; }
    .masthead.is-scrolled .brand__emblem { height: 32px; }
    .masthead.is-scrolled .brand__wordmark { height: 28px; }
    .masthead__apply { display: none; } /* Apply is pinned in the drawer instead */
    .masthead__toggle-text { display: none; }
  }
</style>

<script>
  // Sticky condense + Escape-to-close. Everything else is CSS.
  const masthead = document.querySelector<HTMLElement>('[data-masthead]');
  const utility = document.querySelector<HTMLElement>('[data-utility-bar]');
  const footer = document.querySelector<HTMLElement>('footer');

  if (masthead) {
    let lastY = window.scrollY;
    let ticking = false;

    const onScroll = () => {
      const y = window.scrollY;
      masthead.classList.toggle('is-scrolled', y > 8);

      // Tuck the header out of the way once the footer reaches it, so the
      // footer's wordmark is never sliced in half at the end of the page.
      if (footer) {
        masthead.classList.toggle(
          'is-tucked',
          footer.getBoundingClientRect().top <= masthead.offsetHeight + 4
        );
      }

      // Utility bar hides on scroll-down, returns on scroll-up (docs/06 §01).
      if (utility) {
        const goingDown = y > lastY && y > 120;
        utility.classList.toggle('is-hidden', goingDown);
      }

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(onScroll);
        }
      },
      { passive: true }
    );

    // Escape closes an open mega-menu and returns focus to its trigger.
    masthead.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const openItem = masthead
        .querySelector('.mainnav__item--has-mega:focus-within');
      if (!openItem) return;

      const trigger = openItem.querySelector<HTMLAnchorElement>('.mainnav__link');
      masthead.classList.add('is-mega-suppressed');
      trigger?.focus();
      // Release the suppression once focus moves on, so hover still works.
      const release = () => {
        masthead.classList.remove('is-mega-suppressed');
        masthead.removeEventListener('focusout', release);
        masthead.removeEventListener('mouseleave', release);
      };
      masthead.addEventListener('focusout', release);
      masthead.addEventListener('mouseleave', release);
    });
  }
</script>

---
/**
 * C02 · MASTHEAD — docs/06 §02
 *
 * Crest + wordmark left, nav centre-right, Apply Online always visible.
 * Sticky; condenses 96 → 68px on scroll.
 *
 * IMPLEMENTATION NOTE — desktop nav threshold is 1360px, not the 1024px implied
 * by docs/05 § L. The audit mandates 8 top-level items (Career §6.1 and Alumni
 * §12.1 are both required at top level) and names them verbatim, which is what
 * sets the width: "Latest News & Events" (§11) is 159px on its own and "Campus
 * Tour" (§3) 92px. Measured in Chromium the eight links need 814px beside the
 * brand lockup and the Apply button, and the container caps at 1280px. Below
 * 1360 the drawer is the honest answer rather than a cramped, shrunken nav.
 */
import { mainNav } from '../../data/navigation';
import MegaMenu from './MegaMenu.astro';
---

<header class="masthead" data-masthead>
  <div class="masthead__inner u-container">
    <a class="brand" href="/" aria-label="Sunbeam School Ballia — home">
      <img
        class="brand__emblem"
        src="/brand/sunbeam-emblem.png"
        alt=""
        width="191"
        height="150"
        decoding="async"
      />
      <img
        class="brand__wordmark"
        src="/brand/sunbeam-wordmark.png"
        alt="Sunbeam School Ballia"
        width="588"
        height="178"
        decoding="async"
      />
    </a>

    <nav class="mainnav" aria-label="Main">
      <ul class="mainnav__list">
        {mainNav.map((item) => (
          <li class:list={['mainnav__item', item.columns && 'mainnav__item--has-mega']}>
            <a class="mainnav__link" href={item.href}>{item.label}</a>
            {item.columns && <MegaMenu item={item} />}
          </li>
        ))}
      </ul>
    </nav>

    <div class="masthead__actions">
      <a class="btn btn--primary masthead__apply" href="/admissions/">Apply Online</a>
      <button
        class="masthead__toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="masthead__toggle-bars" aria-hidden="true"><i></i><i></i></span>
        <span class="masthead__toggle-text">Menu</span>
      </button>
    </div>
  </div>
</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--sb-paper);
    border-bottom: var(--sb-hairline);
    transition: box-shadow var(--sb-dur-nav) ease;
  }

  .masthead.is-scrolled {
    box-shadow: var(--sb-shadow-header);
  }

  /* Tucked away once the footer reaches the top of the viewport. A sticky header
     will always sit on whatever lands beneath it, and at the end of the page
     that was slicing the top off the footer's wordmark at shorter viewport
     heights. Scrolling up brings it straight back. */
  .masthead.is-tucked {
    transform: translateY(-100%);
  }

  .masthead {
    transition: box-shadow var(--sb-dur-nav) ease,
      transform var(--sb-dur-nav) var(--sb-ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead { transition: none; }
  }

  .masthead__inner {
    height: var(--sb-masthead-h);
    display: flex;
    align-items: center;
    /* Capped, not clamp(20px, 2vw, 40px): the container stops growing at 1280
       but vw does not, so the old gap widened on big screens while the space it
       had to fit into stayed fixed — 1920 overflowed harder than 1440 did. */
    gap: clamp(16px, 1.6vw, 24px);
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  /* --- Brand ------------------------------------------------------------- */

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  /* 52/48 rather than 60/56: the doc's verbatim labels cost the nav ~120px over
     the short ones, and the lockup is where that comes back from. 279 → 242px. */
  .brand__emblem {
    height: 52px;
    width: auto;
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  .brand__wordmark {
    height: 48px;
    width: auto;
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  /* Shrinks on scroll so the sticky bar stays shallow — same ratio as above. */
  .masthead.is-scrolled .brand__emblem { height: 52px; }
  .masthead.is-scrolled .brand__wordmark { height: 48px; }

  /* --- Main navigation --------------------------------------------------- */

  .mainnav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .mainnav__list {
    display: flex;
    align-items: center;
    gap: clamp(10px, 0.9vw, 16px);
  }

  /* static so the mega panel's containing block is the header, not the item */
  .mainnav__item {
    position: static;
  }

  .mainnav__link {
    position: relative;
    display: inline-block;
    padding: 12px 2px;
    font-size: 14px;
    font-weight: 600;
    color: var(--sb-charcoal);
    white-space: nowrap;
    transition: color var(--sb-dur-link) ease;
  }

  /* Active/hover indicator: 2px maroon rule, wipes in from the left. */
  .mainnav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--sb-violet);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--sb-dur-link) var(--sb-ease);
  }

  .mainnav__item:hover .mainnav__link,
  .mainnav__item:focus-within .mainnav__link {
    color: var(--sb-violet);
  }

  .mainnav__item:hover .mainnav__link::after,
  .mainnav__item:focus-within .mainnav__link::after {
    transform: scaleX(1);
  }

  /* CSS-first mega-menu reveal. */
  .mainnav__item--has-mega:hover :global(.mega),
  .mainnav__item--has-mega:focus-within :global(.mega) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity var(--sb-dur-menu) ease,
      transform var(--sb-dur-menu) var(--sb-ease);
  }

  .masthead.is-mega-suppressed :global(.mega) {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* --- Actions ----------------------------------------------------------- */

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: var(--sb-5);
    flex-shrink: 0;
  }

  .masthead__toggle {
    display: none;
    align-items: center;
    gap: var(--sb-3);
    min-height: 48px;
    padding: 0 var(--sb-2);
    font-size: var(--sb-body-sm);
    font-weight: 600;
    color: var(--sb-charcoal);
  }

  .masthead__toggle-bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 22px;
    height: 14px;
  }

  .masthead__toggle-bars i {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--sb-charcoal);
  }

  /* --- Below 1360: drawer takes over --------------------------------------
     THE BUG THIS PREVENTS IS A HORIZONTAL SCROLLBAR ON EVERY PAGE. Because
     `body` is `overflow-x: hidden` an over-wide header never shows as a broken
     header — it shows as the whole document scrolling sideways, which on a
     full-bleed layout looks like every band stopping short of the right edge.

     The previous 1240 threshold held only while the nav used short labels. The
     audit's verbatim names cost ~120px, so the row no longer fits at 1240 (735px
     of room against 799px of links) and tightening gaps alone cannot close it.
     1240–1359 therefore gets the drawer, which is honest, rather than a nav
     squeezed past legibility.

     Measured slack in Chromium against the 1280px container cap: 39px at 1360,
     48px at 1440, 25px at 1920 (the floor — gaps are still the widest there).
     ⚠ RE-MEASURE IF A NINTH ITEM OR A LONGER LABEL IS ADDED. 25px is half the
     narrowest link on the bar, so there is room for no more. */

  @media (max-width: 1359px) {
    .mainnav { display: none; }
    .masthead__toggle { display: inline-flex; }
    .masthead__inner { justify-content: space-between; }
  }

  @media (max-width: 1023px) {
    .brand__emblem { height: 44px; }
    .brand__wordmark { height: 40px; }
    .masthead.is-scrolled .brand__emblem { height: 38px; }
    .masthead.is-scrolled .brand__wordmark { height: 34px; }
  }

  @media (max-width: 767px) {
    .brand { gap: 10px; }
    .brand__emblem { height: 38px; }
    .brand__wordmark { height: 34px; }
    .masthead.is-scrolled .brand__emblem { height: 32px; }
    .masthead.is-scrolled .brand__wordmark { height: 28px; }
    .masthead__apply { display: none; } /* Apply is pinned in the drawer instead */
    .masthead__toggle-text { display: none; }
  }
</style>

<script>
  // Sticky condense + Escape-to-close. Everything else is CSS.
  const masthead = document.querySelector<HTMLElement>('[data-masthead]');
  const utility = document.querySelector<HTMLElement>('[data-utility-bar]');
  const footer = document.querySelector<HTMLElement>('footer');

  if (masthead) {
    let lastY = window.scrollY;
    let ticking = false;

    const onScroll = () => {
      const y = window.scrollY;
      masthead.classList.toggle('is-scrolled', y > 8);

      // Tuck the header out of the way once the footer reaches it, so the
      // footer's wordmark is never sliced in half at the end of the page.
      if (footer) {
        masthead.classList.toggle(
          'is-tucked',
          footer.getBoundingClientRect().top <= masthead.offsetHeight + 4
        );
      }

      // Utility bar hides on scroll-down, returns on scroll-up (docs/06 §01).
      if (utility) {
        const goingDown = y > lastY && y > 120;
        utility.classList.toggle('is-hidden', goingDown);
      }

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(onScroll);
        }
      },
      { passive: true }
    );

    // Escape closes an open mega-menu and returns focus to its trigger.
    masthead.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const openItem = masthead
        .querySelector('.mainnav__item--has-mega:focus-within');
      if (!openItem) return;

      const trigger = openItem.querySelector<HTMLAnchorElement>('.mainnav__link');
      masthead.classList.add('is-mega-suppressed');
      trigger?.focus();
      // Release the suppression once focus moves on, so hover still works.
      const release = () => {
        masthead.classList.remove('is-mega-suppressed');
        masthead.removeEventListener('focusout', release);
        masthead.removeEventListener('mouseleave', release);
      };
      masthead.addEventListener('focusout', release);
      masthead.addEventListener('mouseleave', release);
    });
  }
</script>

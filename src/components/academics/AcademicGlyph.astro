---
/**
 * ACADEMIC GLYPH — the line-art mark set used across the Academics section.
 *
 * ONE SPECIFICATION, MANY SUBJECTS: a 24-unit box, 1.6 stroke, round caps and
 * joins, `currentColor`, no fill. Drawn to the same rules as the feature-card
 * icons on Academic Philosophy and to the same hand-inked family as bulb.png and
 * rocketpaper.png, so a room in a list and a commitment on a card read as marks
 * from the same hand.
 *
 * INLINE SVG, NOT RASTER. These recolour with their row (charcoal → brand on
 * hover), sit at 20–24px where a PNG would be soft on a 3× screen, and cost no
 * request. A raster set could do none of the three.
 *
 * THEY ARE ALWAYS DECORATION. Every glyph sits beside a text label that already
 * names the thing, so the SVG is `aria-hidden` and adds nothing to the accessible
 * name — an icon that repeats its own label just makes a screen reader say
 * everything twice. An unknown `name` renders nothing rather than a fallback
 * box: a missing mark, never a broken row.
 */
interface Props {
  name: string;
  /** Rendered size in px. The stroke is scaled to hold its weight. */
  size?: number;
  class?: string;
}

const { name, size = 22, class: className = '' } = Astro.props;

/**
 * Paths only — the shared attributes live on the <svg>. Keys are subjects rather
 * than shapes ('chemistry', not 'flask') so a caller asks for what a room IS and
 * the drawing can change without every call site changing with it.
 */
const glyphs: Record<string, string> = {
  physics: `<circle cx="12" cy="12" r="2.4"/><path d="M12 3.2c4.6 0 8.4 3.9 8.4 8.8S16.6 20.8 12 20.8 3.6 16.9 3.6 12 7.4 3.2 12 3.2Z" stroke-dasharray="2.6 3.4"/><path d="M5.6 5.6c1.6-1.6 5.6.4 8.9 3.7s5.3 7.3 3.7 8.9-5.6-.4-8.9-3.7-5.3-7.3-3.7-8.9Z"/>`,
  chemistry: `<path d="M9.6 3.4h4.8M10.6 3.4v5.2L6.9 17a2 2 0 0 0 1.8 2.8h6.6a2 2 0 0 0 1.8-2.8l-3.7-8.4V3.4"/><path d="M8.2 14.4h7.6"/><circle cx="10.8" cy="16.8" r=".9"/><circle cx="13.4" cy="18.4" r=".7"/>`,
  biology: `<path d="M19.4 4.6c1 6.9-2.2 11.7-7.5 12.4-3 .4-5.4-1-6-3.4-.7-2.9 1.3-5.3 4.6-6"/><path d="M4.6 20.2c1.6-4.6 5.4-8.6 9.8-10.8"/>`,
  mathematics: `<path d="M12 3.6 5.2 19.6M12 3.6l6.8 16"/><circle cx="12" cy="4.4" r="1.5"/><path d="M8.3 13.6h7.4"/>`,
  language: `<path d="M20.4 13.4a2.6 2.6 0 0 1-2.6 2.6H8.6L4.2 19.6V6.4a2.6 2.6 0 0 1 2.6-2.6h11a2.6 2.6 0 0 1 2.6 2.6Z"/><path d="M8.4 9.2h7.2M8.4 12.4h4.6"/>`,
  computing: `<rect x="3" y="4.6" width="18" height="11.4" rx="1.8"/><path d="M8.4 20h7.2M12 16v4"/><path d="M9.4 9.2 7.6 11l1.8 1.8M14.6 9.2 16.4 11l-1.8 1.8"/>`,
  robotics: `<rect x="7.4" y="8.6" width="9.2" height="8.2" rx="2"/><path d="M12 4.4v4.2M9.4 20.2v-3.4M14.6 20.2v-3.4M3.6 12.4h3.8M16.6 12.4h3.8"/><circle cx="12" cy="3.6" r="1.2"/><circle cx="10.2" cy="12.4" r=".9"/><circle cx="13.8" cy="12.4" r=".9"/>`,
  science: `<path d="M8.6 20.4h7.6"/><path d="M12.4 16.6v3.8"/><path d="m9 3.6 5.6 3.2-4 6.9-5.6-3.2z"/><path d="m14.6 6.8 2.6 1.5-4 6.9-2.6-1.5"/>`,
  making: `<path d="M14.6 4.4a4 4 0 0 1 5.1 5.1l-9.4 9.4-5.1-5.1Z"/><path d="m12.6 6.4 5.1 5.1"/><path d="M5.2 13.8 3.6 20.4l6.6-1.6"/>`,
  debate: `<circle cx="12" cy="12" r="8.6"/><path d="M3.6 12h16.8"/><path d="M12 3.4c2.2 2.4 3.4 5.4 3.4 8.6S14.2 18.2 12 20.6c-2.2-2.4-3.4-5.4-3.4-8.6S9.8 5.8 12 3.4Z"/>`,
  geography: `<path d="m3.6 6.6 5.6-2.2 5.6 2.2 5.6-2.2v13l-5.6 2.2-5.6-2.2-5.6 2.2Z"/><path d="M9.2 4.4v13M14.8 6.6v13"/>`,
  inquiry: `<path d="M9.6 9.2a2.6 2.6 0 1 1 3.7 2.4c-1 .5-1.6 1.2-1.6 2.3"/><path d="M11.7 17.6h.02"/><circle cx="12" cy="12" r="8.6" stroke-dasharray="2.4 3.2"/>`,
  library: `<path d="M4 5.2h4.4v14.2H4zM9.8 5.2h3.8v14.2H9.8z"/><path d="m15.4 6.6 3.6-1 3 12.4-3.6 1z"/><path d="M4 9.4h4.4M9.8 9.4h3.8"/>`,
  reading: `<path d="M12 7.4c-2-1.6-4.4-2.3-7-2.2a1 1 0 0 0-.9 1v11a1 1 0 0 0 1 1c2.4 0 4.6.7 6.9 2.2 2.3-1.5 4.5-2.2 6.9-2.2a1 1 0 0 0 1-1v-11a1 1 0 0 0-.9-1c-2.6-.1-5 .6-7 2.2Z"/><path d="M12 7.4v13"/>`,
  rocket: `<path d="M13.6 3.8c3.4 2 5.4 5.8 5.2 9.8l-3.6 3.4-5.6-5.6 3.4-3.6c.2-1.4.4-2.7.6-4Z"/><path d="M9.6 11.4 6 12.6l-1.6-1.6 3.4-3.4 2.4.6"/><path d="m12.6 14.4 1.2 3.6-1.6 1.6-3.4-3.4.6-2.4"/><path d="M7.4 16.6 4.2 19.8"/>`,
};

const path = glyphs[name];
---

{
  path && (
    <svg
      class:list={['glyph', className]}
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={path}
    />
  )
}

<style>
  .glyph {
    display: block;
    flex-shrink: 0;
    /* The caller owns the colour; the mark only ever inherits it. */
    color: inherit;
  }
</style>

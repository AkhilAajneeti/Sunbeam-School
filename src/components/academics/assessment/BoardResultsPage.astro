---
/**
 * ACADEMICS · BOARD RESULTS — five sections.
 *
 * ⚠⚠ THIS PAGE ONCE SAID THE RESULTS WERE NOT PUBLISHED. THEY ARE, AND THEY
 * ALWAYS WERE. The school files "Last Three Years Board Result" (BRS.pdf) on its
 * own letterhead as part of the CBSE mandatory public disclosure, and those
 * figures have been transcribed in data/disclosure.ts → `boardResults` since
 * that file was written. /general-info/ has been rendering them the whole time
 * while THIS page — the one a parent searching for results actually lands on —
 * told them no results existed. The site contradicted itself in public.
 *
 * ⚠⚠ NO RESULT IS ESTIMATED, INFERRED OR ILLUSTRATED. Every figure below comes
 * from `boardResults`, which comes from the school's letterhead. The original
 * client brief asked for a "98% Board Results" counter; what is here instead is
 * the school's own 98.90% for Class XII 2025, with the registered and passed
 * counts beside it so it can be read rather than trusted.
 *
 * ⚠ THE ABSENCE PANEL NOW CARRIES ONLY WHAT IS STILL ABSENT. It used to list
 * four absences; two of them — "no pass percentage" and "no year-on-year data" —
 * were false the day they were written. What remains genuinely unpublished is
 * the individual detail: toppers, rank holders, and the number who APPEARED
 * (BRS.pdf gives Registered and Passed only, which are not the same thing).
 * Do not add an "appeared" figure by subtraction or assumption.
 *
 * ═══ WHAT THE SCHOOL DOES PUBLISH ABOUT OUTCOMES ═══════════════════════════
 *   CUET (UG) 2025 — result cards per student, with NTA scores and subject
 *     percentiles, across PCM, Commerce and Humanities.
 *   "Vision To Reality" placement board, session 2024-25 — eighteen named
 *     leavers with course and institution; ten at University of Delhi colleges,
 *     three at BHU.
 * Neither is a board result, and neither is presented as one. A parent who came
 * here for evidence of where students end up should not leave empty-handed.
 *
 * ═══ COMPOSITION — five sections, five different builds ════════════════════
 *   01 · IVORY  50/50. Copy left; the right column is a full layered
 *               composition — ghost %, two photographs, the absence panel, a
 *               board card, ghost XII and X, orange connector lines and dots.
 *   02 · PAPER  the layered collage crosses LEFT, copy right.
 *   03 · CREAM  a four-item information strip on thin vertical rules.
 *   04 · PHOTO  the cinematic close.
 */
import { Picture } from 'astro:assets';
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsClose from './AsClose.astro';
import PendingBlock from '../../ui/PendingBlock.astro';
import { boardResults, disclosureSource } from '../../../data/disclosure';

import pExam from '../../../assets/photos/sunbeem-students.jpg';
import pCampus from '../../../assets/photos/sunbeem-1.jpg';
import pLib from '../../../assets/photos/sb-library.jpg';
import pBench from '../../../assets/photos/sb-chem-lab.jpg';
import pCohort from '../../../assets/photos/sunbeem-5.jpg';

const S = 'Sunbeam School Ballia';

const UNIVERSITY = '/academics/student-success/university-counselling/';
const CONTACT = '/contact-us/';
const ASSESSMENT = '/academics/assessment/';

/* ── SECTION 01 — the four absences. Every line is a true statement about the
   record, checked one at a time. ────────────────────────────────────────── */
/* ⚠ WAS FOUR LINES, TWO OF THEM UNTRUE. "No pass percentage" and "No
   year-on-year data" were both contradicted by the school's own BRS.pdf. These
   three are what is genuinely still unpublished — checked one at a time. */
const absent = [
  { mark: 'medal', k: 'No toppers list' },
  { mark: 'ribbon', k: 'No rank holders' },
  { mark: 'person', k: 'No appeared count' },
] as const;

/* The newest year, for the headline pair. The table below shows all three. */
const latest = boardResults[0];

/* ── SECTION 03 — the information strip ─────────────────────────────────── */
/* ⚠ ALL FOUR OF THESE USED TO ANNOUNCE AN ABSENCE, AND THREE OF THE FOUR WERE
   WRONG. They now say what the record holds and where it came from. */
const strip = [
  { n: '01', mark: 'calendar', k: 'Three years, on letterhead', v: 'Class X and Class XII for ' + boardResults.map((r) => r.year).join(', ') + ', as filed by the school with CBSE.' },
  { n: '02', mark: 'chart', k: 'Registered and passed', v: 'Each year gives the number registered, the number passed and the pass percentage.' },
  { n: '03', mark: 'person', k: 'No individual ranks', v: 'No toppers, no merit list, no rank holders — the filing carries none.' },
  { n: '04', mark: 'doc', k: 'The source document', v: 'BRS.pdf, "Last Three Years Board Result", published with the mandatory public disclosure.' },
] as const;
---

{/* ══ 01 · NO PASS RATE. NO TOPPERS. ═════════════════════════════════════════
    Ground: warm ivory over a fine grid.

    ⚠ THE RIGHT COLUMN IS A COMPOSITION, NOT A GAP. The brief's first note is
    that this section must not have an empty right side, and it is right: a page
    whose subject is an absence looks unfinished if it is also visually empty.
    The layers below are ghost %, a photograph, a second photograph, the absence
    panel, a board card, ghost XII and X, connector lines and a dot field. */}
<section class="as-sec as-sec--ivory as-pad br-open" aria-labelledby="br-open-t">
  <span class="as-warm" aria-hidden="true"></span>
  <span class="as-grid" aria-hidden="true"></span>

  <div class="u-container br-open__grid">
    <div class="br-open__copy">
      <span class="br-open__tick" aria-hidden="true"></span>

      <p class="as-kicker" data-reveal>What is published</p>
      <h2 class="as-h as-h--xl br-open__h" id="br-open-t">
        <span data-clip data-clip-delay="0">Three years,</span>
        <span data-clip data-clip-delay="150"><em>on letterhead.</em></span>
      </h2>

      <p class="as-body" data-reveal data-reveal-delay="200">
        Sunbeam School Ballia files <strong>“Last Three Years Board Result”</strong> with CBSE as part
        of its mandatory public disclosure, on its own letterhead. Class X and Class XII, for
        {' '}{boardResults.map((r) => r.year).join(', ')}. Every figure on this page is read off that
        document — none is estimated, rounded or illustrated.
      </p>
      <p class="as-body" data-reveal data-reveal-delay="260">
        It would be easy to improve these numbers. A pass percentage is the most expected figure on a
        school website and almost nobody checks one. That is exactly why each one here is printed
        beside the counts it comes from: <strong>registered</strong> and <strong>passed</strong>, so
        the percentage can be read rather than trusted.
      </p>
      <p class="as-body" data-reveal data-reveal-delay="320">
        What the filing does not carry is individual detail — no toppers, no merit list, no rank
        holders, and no count of how many <em>appeared</em> as distinct from how many registered.
        Those are not inferred here.
      </p>

      {/* ⚠ THE THREE-YEAR TABLE. Static markup, no tabs — /general-info/ already
          carries the tabbed version of the same array, and a second interactive
          copy of one dataset is two things to keep in step. */}
      <div class="br-table" data-reveal data-reveal-delay="380">
        <table>
          <caption class="u-visually-hidden">
            CBSE Class X and Class XII board results for {boardResults.map((r) => r.year).join(', ')},
            showing students registered, students passed and the pass percentage.
          </caption>
          <thead>
            <tr>
              <th scope="col">Year</th>
              <th scope="col">Class</th>
              <th scope="col" class="br-table__num">Registered</th>
              <th scope="col" class="br-table__num">Passed</th>
              <th scope="col" class="br-table__num">Pass&nbsp;%</th>
            </tr>
          </thead>
          <tbody>
            {boardResults.map((r) => (
              <>
                <tr>
                  <th scope="rowgroup" rowspan="2" class="br-table__yr t-tabular">{r.year}</th>
                  <th scope="row">Class X</th>
                  <td class="br-table__num t-tabular">{r.x.registered}</td>
                  <td class="br-table__num t-tabular">{r.x.passed}</td>
                  <td class="br-table__num t-tabular"><strong>{r.x.percentage}%</strong></td>
                </tr>
                <tr>
                  <th scope="row">Class XII</th>
                  <td class="br-table__num t-tabular">{r.xii.registered}</td>
                  <td class="br-table__num t-tabular">{r.xii.passed}</td>
                  <td class="br-table__num t-tabular"><strong>{r.xii.percentage}%</strong></td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
        <p class="br-table__src">
          Source: BRS.pdf, filed with the
          {' '}<a class="as-link" href="/mandatory-public-disclosure/">mandatory public disclosure</a>.
          {' '}{disclosureSource.covers}.
        </p>
      </div>

      {/* ⚠ THE INDIVIDUAL DETAIL, AS A PLACEHOLDER — NOT AS A NUMBER. The filing
          gives Registered and Passed only. "Appeared" is NOT derivable from
          those two and must never be computed here; a student can register and
          not appear. Client instruction, 17 Sep 2026. */}
      <div class="br-pending" data-reveal data-reveal-delay="430">
        <PendingBlock
          icon="star"
          title="Topper and rank-holder information"
          body="Topper details, rank holders and the number of students who appeared will be published when officially provided by the school. The filing behind the table above carries registered and passed figures only, so none of this is calculated or estimated here."
          needs={[
            'toppers, with marks',
            'written consent to publish named students',
            'rank holders / merit list',
            'students appeared, per class per year',
          ]}
          ref="A1"
        />
      </div>
    </div>

    {/* ⚠ EVERY LAYER IS DECORATION OR A TRUE STATEMENT. No element in this
        composition carries a figure the school has not printed. */}
    <div class="br-stage" aria-hidden="false">
      <span class="br-stage__pc" aria-hidden="true" data-drift>%</span>
      <span class="br-stage__xii" aria-hidden="true" data-drift>XII</span>
      <span class="br-stage__x" aria-hidden="true" data-drift>X</span>
      <span class="as-dots br-stage__dots" aria-hidden="true"></span>

      <svg class="br-stage__wires" viewBox="0 0 100 100" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <g stroke="currentColor" stroke-width="0.3" stroke-linecap="round">
          <path d="M2 26h30a3 3 0 0 1 3 3v10" stroke-dasharray="1.4 2.2" />
          <path d="M98 18H72a3 3 0 0 0-3 3v22" stroke-dasharray="1.4 2.2" />
          <path d="M8 78h22a3 3 0 0 0 3-3V62" stroke-dasharray="1.4 2.2" />
        </g>
        <circle cx="35" cy="40" r="0.9" fill="currentColor" />
        <circle cx="69" cy="44" r="0.9" fill="currentColor" />
        <circle cx="33" cy="61" r="0.9" fill="currentColor" />
      </svg>

      <div class="br-stage__lead as-frame as-fill" data-pop>
        <Picture
          src={pExam}
          alt={`Students of ${S} working at the bench during a science practical`}
          formats={['avif', 'webp']}
          widths={[420, 760]}
          sizes="(max-width: 1023px) 60vw, 26vw"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="br-stage__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="140">
        <Picture
          src={pCampus}
          alt={`The campus of ${S} at Agarsanda, its main block behind the lawns`}
          formats={['avif', 'webp']}
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 20vw"
          loading="lazy"
          decoding="async"
        />
      </div>

      {/* The absence panel. Four lines, each of them checkable. */}
      <div class="br-panel" data-pop data-pop-delay="240">
        <p class="br-panel__k">Not published</p>
        <ul class="br-panel__list">
          {absent.map((a) => (
            <li>
              <span class="br-panel__m" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[a.mark]} />
                </svg>
              </span>
              {a.k}
            </li>
          ))}
        </ul>
      </div>

      <div class="br-board" data-pop data-pop-delay="340">
        <span class="br-board__m" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.cap} />
          </svg>
        </span>
        <span class="br-board__t">
          <span class="br-board__lab">CBSE {latest.year}</span>
          <span class="br-board__k t-tabular">{latest.x.percentage}% · {latest.xii.percentage}%</span>
          <span class="br-board__v">Class X &amp; XII pass rate</span>
        </span>
      </div>
    </div>
  </div>
</section>

{/* ══ 02 · WHAT THE SCHOOL DOES PUBLISH ══════════════════════════════════════
    Ground: white. The layered collage crosses LEFT, the copy right. */}
<section class="as-sec as-sec--paper as-pad br-does" aria-labelledby="br-does-t">
  <div class="u-container br-does__grid">
    <figure class="br-does__stage">
      <span class="as-dots br-does__dots" aria-hidden="true"></span>
      <div class="br-does__lead as-frame as-fill" data-zoom data-zoom-to="1.04">
        <Picture
          src={pLib}
          alt={`Students of ${S} reading and working at the long tables of the Nalanda Library, a member of staff at the head of the row`}
          formats={['avif', 'webp']}
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="br-does__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="200">
        <Picture
          src={pBench}
          alt={`Students of ${S} working along the chemistry bench, test tubes held over the burners`}
          formats={['avif', 'webp']}
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 19vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <div class="br-does__copy">
      <p class="as-kicker" data-reveal>What the school does publish</p>
      <h2 class="as-h as-h--lg" id="br-does-t">
        <span data-clip data-clip-delay="0">What the school</span>
        <span data-clip data-clip-delay="150"><em>does publish</em></span>
      </h2>
      <p class="as-body" data-reveal data-reveal-delay="200">
        A parent looking for board results is really asking a broader question:
        <em> where do students go from here, and what are they doing now?</em>
      </p>
      <p class="as-body" data-reveal data-reveal-delay="260">
        Sunbeam School Ballia publishes more than most schools in the district — just not in the form
        of a percentage. It publishes <strong>CUET (UG) 2025 results card by card</strong>, with the
        NTA score and every subject percentile, across PCM, Commerce and Humanities. And it prints a
        placement board, <strong>“Vision To Reality”</strong>, naming <strong>eighteen leavers of
        session 2024-25</strong> with their course and institution — ten of them at University of
        Delhi colleges and three at Banaras Hindu University.
      </p>
      <p class="as-body" data-reveal data-reveal-delay="320">
        Neither is a board result, and neither is presented as one. Both are set out in full on
        {' '}<a class="as-link" href={UNIVERSITY}>University Counselling</a>.
      </p>
    </div>
  </div>
</section>

{/* ══ 03 · THE INFORMATION STRIP ═════════════════════════════════════════════ */}
<section class="as-sec as-sec--cream as-pad--sm br-strip" aria-label="What is and is not published">
  <div class="u-container">
    <ol class="br-strip__band">
      {strip.map((s, i) => (
        <li class="br-scell" data-reveal data-reveal-delay={120 + i * 90}>
          <span class="br-scell__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[s.mark]} />
            </svg>
          </span>
          <p class="br-scell__n t-tabular">{s.n}</p>
          <h3 class="br-scell__k">{s.k}</h3>
          <p class="br-scell__v">{s.v}</p>
        </li>
      ))}
    </ol>
    <p class="as-note br-strip__foot" data-reveal data-reveal-delay="440">
      The assessment cycle these examinations sit inside is on
      {' '}<a class="as-link" href={ASSESSMENT}>Assessment &amp; Support</a>; for a particular year,
      the {' '}<a class="as-link" href={CONTACT}>school office</a> can answer.
    </p>
  </div>
</section>

<AsClose
  id="br-close-t"
  kicker="Filed, and printed here"
  lead="Measured,"
  accent="not estimated."
  body="Every figure on this page is read off the school's own filing — registered, passed, and the percentage that follows from the two. What the filing does not carry is individual detail: no toppers, no rank holders, and no count of who appeared as distinct from who registered. None of that is inferred here, and the office can answer for a particular year."
  photo={pCohort}
  position="50% 38%"
/>

<style>
  /* ═══ 01 · NO PASS RATE. NO TOPPERS. ══════════════════════════════════════ */
  .br-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .br-open__copy { position: relative; padding-left: clamp(14px, 1.8vw, 26px); }
  /* The thin orange tick the reference runs down the copy's left edge. */
  .br-open__tick {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--sb-violet) 40%, transparent) 12%, color-mix(in srgb, var(--sb-violet) 40%, transparent) 88%, transparent);
  }
  .br-open__tick::before,
  .br-open__tick::after {
    content: '';
    position: absolute;
    left: -2.5px;
    width: 6px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-orange-bright);
  }
  .br-open__tick::before { top: 8%; }
  .br-open__tick::after { bottom: 8%; }
  .br-open__h { max-width: 12ch; }

  /* ── THE LAYERED COMPOSITION ────────────────────────────────────────────
     ⚠ EVERY PIECE IS PLACED IN PERCENTAGES OF ONE STAGE, so the whole thing
     scales as a unit and nothing has to be re-tuned per breakpoint. */
  .br-stage {
    position: relative;
    aspect-ratio: 1 / 0.92;
    color: rgba(201, 60, 10, 0.4);
  }
  .br-stage__wires { position: absolute; inset: 0; width: 100%; height: 100%; }
  .br-stage__dots { top: 30%; left: -2%; width: clamp(70px, 8vw, 120px); }

  .br-stage__pc,
  .br-stage__xii,
  .br-stage__x {
    position: absolute;
    font-family: var(--sb-font-display);
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: -0.06em;
    pointer-events: none;
    user-select: none;
  }
  .br-stage__pc { top: 2%; left: 6%; font-size: clamp(96px, 13vw, 210px); color: rgba(255, 138, 92, 0.3); }
  .br-stage__xii { top: 6%; right: 2%; font-size: clamp(42px, 5.4vw, 86px); color: rgba(255, 138, 92, 0.36); }
  .br-stage__x { bottom: 6%; right: 8%; font-size: clamp(38px, 4.8vw, 78px); color: rgba(255, 138, 92, 0.32); }

  .br-stage__lead {
    position: absolute;
    top: 16%;
    left: 26%;
    width: 46%;
    aspect-ratio: 4 / 3;
  }
  .br-stage__sm {
    position: absolute;
    top: 46%;
    left: 6%;
    width: 42%;
    aspect-ratio: 16 / 11;
    border: 5px solid #f7f0ea;
  }

  .br-panel {
    position: absolute;
    top: 26%;
    right: 0;
    width: 52%;
    padding: clamp(12px, 1.4vw, 18px) clamp(13px, 1.5vw, 19px) clamp(13px, 1.6vw, 20px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: var(--sb-shadow-card-hover);
  }
  .br-panel__k {
    margin: 0 0 clamp(8px, 1vw, 12px);
    padding-bottom: clamp(7px, 0.9vw, 11px);
    border-bottom: 1px solid var(--sb-border);
    font-family: var(--sb-font-display);
    font-size: clamp(12px, 0.98vw, 15.5px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--sb-violet);
  }
  .br-panel__list { display: grid; gap: clamp(6px, 0.8vw, 10px); margin: 0; padding: 0; list-style: none; }
  .br-panel__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(7px, 0.9vw, 11px);
    align-items: center;
    font-size: clamp(9.5px, 0.72vw, 11.4px);
    line-height: 1.5;
    color: var(--sb-text-secondary);
  }
  .br-panel__m {
    display: grid;
    place-items: center;
    width: clamp(20px, 1.9vw, 26px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-violet-wash);
    color: var(--sb-violet);
  }
  .br-panel__m svg { width: 56%; height: auto; }

  .br-board {
    position: absolute;
    right: 12%;
    bottom: 12%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(9px, 1.1vw, 13px);
    align-items: center;
    padding: clamp(10px, 1.2vw, 14px) clamp(13px, 1.5vw, 18px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: var(--sb-shadow-card);
  }
  .br-board__m {
    display: grid;
    place-items: center;
    width: clamp(28px, 2.6vw, 36px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-violet-wash);
    color: var(--sb-violet);
  }
  .br-board__m svg { width: 54%; height: auto; }
  .br-board__t { display: grid; gap: 1px; }
  .br-board__lab { font-size: clamp(8px, 0.6vw, 9.5px); font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--sb-text-muted); }
  .br-board__k {
    font-family: var(--sb-font-display);
    font-size: clamp(13px, 1.05vw, 17px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--sb-charcoal);
  }
  .br-board__v { font-size: clamp(9px, 0.66vw, 10.5px); color: var(--sb-text-muted); }

  /* ═══ 02 · WHAT THE SCHOOL DOES PUBLISH ═══════════════════════════════════ */
  .br-does__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .br-does__stage { position: relative; margin: 0; padding-bottom: clamp(28px, 3.2vw, 50px); }
  .br-does__dots { bottom: 0; left: 12%; }
  .br-does__lead { width: 84%; aspect-ratio: 16 / 11; }
  .br-does__sm {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 46%;
    aspect-ratio: 4 / 3;
    border: 5px solid var(--sb-paper);
  }

  /* ═══ 03 · THE INFORMATION STRIP ══════════════════════════════════════════ */
  .br-strip__band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ═══ LAYOUT ══════════════════════════════════════════════════════════════
     ⚠ MOBILE IS RE-COMPOSED, NOT STACKED. The diagonal pair in §02 comes out of
     its overlap and the connector goes with it — a dashed line between two
     frames that are no longer diagonal is a line to nowhere. The constellation
     keeps its geometry because it is angular rather than columnar, but its
     radius and node size shrink together so the ring never collides with the
     core. */
  @media (min-width: 900px) {
    .tp-one__in { grid-template-columns: minmax(0,1.02fr) minmax(0,.98fr); }
    .tp-two__in { grid-template-columns: minmax(0,.95fr) minmax(0,1.05fr); }
    .tp-five__in { grid-template-columns: minmax(0,1.05fr) minmax(0,.95fr); }
  }

  @media (max-width: 899px) {

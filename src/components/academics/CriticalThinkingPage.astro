---
/**
 * CRITICAL THINKING & CREATIVITY — four sections under the shared banner.
 *
 * ═══ SOURCE OF TRUTH ═══════════════════════════════════════════════════════
 *
 *   sunbeamballia.edu.in — Principal Speak (homepage)
 *     "think critically, acts responsibly, and dreams fearlessly"
 *     "nurturing character, inspiring creativity"
 *     "classrooms are places of curiosity and collaboration"
 *     "lead with empathy and vision"
 *
 *   sunbeamballia.edu.in — SUNBEAM INNOVX
 *     "SUNBEAM INNOVX – Hackathon & Coding Contest 2026"
 *     "a two-day celebration of young innovators solving real-world problems
 *      through code, creativity, and collaboration"
 *     7 schools in the preliminary round; the finals took the top 3 on cut-off
 *     merit — Sunbeam School Ballia, Columbus International School and PM Shri
 *     Kendriya Vidyalaya
 *
 *   sunbeamballia.edu.in — Event Chronicles
 *     "our students participated in CMSMUN—an experience that went beyond the
 *      classroom"
 *     "Where ideas take the stage and voices find their power – TED talk begins
 *      at Sunbeam Ballia!"  (guest: Mr. Kartik Bajoria)
 *
 *   Repository, already verified for this project
 *     Critical Thinking — a STAFF workshop, Prof. Pradeep Mishra of Lovely
 *     Professional University, "teaching critical thinking in the classroom"
 *     Impetus — Classes III to V; the Canva Presentation activity is visible in
 *     the school's own photograph
 *     MUN Lab — a room the school lists among its inquiry rooms
 *
 * ⚠ FOUR NAMES IN THE BRIEF ARE NOT ON THIS PAGE. "Pratidhwani", "Maths Arena",
 * a science-innovation award, and Sudoku / "Maths Around Me" / character
 * enactment as named activities: searched the homepage, the Principal's Message,
 * both Event Chronicles pages and School Activities, and none of them appears.
 * The MUN here is CMSMUN, which the school does name. Nothing is claimed that
 * the school has not published.
 *
 * ⚠ THE CRITICAL THINKING WORKSHOP TRAINED TEACHERS, NOT STUDENTS. It is a
 * faculty session with a named trainer and institution, and §01 says so. Calling
 * it a student programme would be the same fabrication this project has already
 * had to undo twice.
 *
 * ⚠ THE MONASH FRAME IS A STUDENT AT AN OUTREACH SESSION, not a student's
 * innovation being exhibited. The caption says what the photograph shows.
 *
 * ═══ COMPOSITION ═══════════════════════════════════════════════════════════
 *
 *   MINDSET  poster type carrying the hero's job, then whitespace and one
 *            portrait overlapping the statement — ivory, calm
 *   VOICE    two frames on a diagonal with six verbs set bare around them —
 *            paper. Ideas moving between people
 *   IMPACT   dark, oversized IMPACT behind a photograph, a drawn arc from idea
 *            to solved, the INNOVX result stated — the loudest section
 *   CREATE   a collage on sand: one dominant, one small, one cropped fragment,
 *            CREATE. across it, and the closing line
 *
 * Ground rhythm: ivory → paper → ink → sand. Deliberately a different order
 * from Experiential (ivory → paper → sand → ink) so the two do not scroll alike.
 *
 * ⚠ MOTION IS THE SITE'S OWN CONTRACT — data-split, data-reveal(+delay),
 * data-mask, data-parallax(+y), data-zoom(+to) — handled by
 * scripts/motion-gsap.ts, already gated on prefers-reduced-motion and Save-Data.
 */
import { Image, Picture } from 'astro:assets';
import { school } from '../../data/site';

/* ─── Photography — seven frames, each opened and looked at before placing ─── */
import pTrainer from '../../assets/workshops/CriticalThinking/CriticalThinking2.jpg';
import pDelegation from '../../assets/excursions/imun-1.jpg';
import pCertificates from '../../assets/excursions/imun-3.jpg';
import pMonash from '../../assets/school-event/Monash-Innovation/Monash-Innovation-01.jpg';
import pCanva from '../../assets/school-event/Impetus—ClassesIII-V/Impetus—ClassesIII-V-02.jpg';
import pMaking from '../../assets/School Activity in Uniform/Embriodery.jpg';
import pRocket from '../../assets/school-activities/summer-camp/05.jpg';

/* ─── Ornament ─────────────────────────────────────────────────────────────── */
import dQuestion from '../../assets/icons/questions.png';
import dBulb from '../../assets/icons/bulb.png';
import dFocus from '../../assets/icons/focus.png';
import dStar from '../../assets/icons/star.png';
import dTwoStars from '../../assets/icons/two-stars.png';
import dShape from '../../assets/icons/shape-2.png';

/** §02's six verbs. Typography as composition — never a card, never a list. */
const verbs = ['Question', 'Argue', 'Reason', 'Present', 'Listen', 'Decide'];

/** §03's arc. Four words the INNOVX description itself supports. */
const arc = ['Idea', 'Think', 'Build', 'Solve'];
---

<div class="ct">
  {/* ═══ 01 · THE MINDSET ════════════════════════════════════════════════════
      Poster type does the hero's work here, on ivory rather than over a
      photograph — calm and intelligent, with the portrait overlapping the
      statement's last line instead of sitting beside it. */}
  <section class="ct-mind" aria-labelledby="ct-mind-h">
    <span class="ct__grid" aria-hidden="true"></span>
    <img class="ct__bg-shape" src={dShape.src} alt="" aria-hidden="true" data-parallax data-parallax-y="-54" />

    <div class="u-container ct-mind__in">
      <p class="ct__k t-label" data-reveal>Critical Thinking &amp; Creativity</p>

      <h2 class="ct-mind__h" id="ct-mind-h" data-split>
        Think critically.<br /><em>Dream fearlessly.</em>
      </h2>

      <figure class="ct-mind__art">
        <span class="ct-mind__frame" data-mask data-zoom data-zoom-to="1.14">
          <Picture
          src={pTrainer}
          alt={`Prof. Pradeep Mishra of Lovely Professional University speaking at the Critical Thinking workshop for teachers at ${school.name}`}
          formats={['avif', 'webp']}
          widths={[320, 600]}
          sizes="(max-width: 900px) 58vw, 300px"
            loading="eager"
            fetchpriority="high"
          />
        </span>
        <figcaption>Prof. Pradeep Mishra · Lovely Professional University</figcaption>
      </figure>

      <div class="ct-mind__copy">
        <p class="ct__p" data-reveal data-reveal-delay="160">
          The words are the Principal's. She describes a Sunbeam education as
          <em>“nurturing character, inspiring creativity”</em>, and the student it is meant to
          produce as one who <strong>“thinks critically, acts responsibly, and dreams
          fearlessly.”</strong>
        </p>
        <p class="ct__p" data-reveal data-reveal-delay="230">
          Beyond knowing the answer is a teachable thing, so the school treated it as one: it
          brought in a workshop on <strong>teaching critical thinking in the classroom</strong> and
          put its own staff through it. The training went to the teachers first.
        </p>
      </div>
    </div>
  </section>

  {/* ═══ 02 · IDEAS NEED A VOICE ═════════════════════════════════════════════
      ⚠ ONE STORY, NOT THREE CARDS. Two frames on a diagonal and six verbs set
      bare on the paper around them — the verbs ARE the composition, so there is
      nothing here to put in a box. */}
  <section class="ct-voice" aria-labelledby="ct-voice-h">
    <div class="u-container ct-voice__in">
      <div class="ct-voice__lede">
        <p class="ct__k t-label" data-reveal>Ideas need a voice</p>
        <h2 class="ct-voice__h" id="ct-voice-h" data-split>
          A position you<br />have to <em>defend aloud</em>
        </h2>
        <p class="ct__p" data-reveal data-reveal-delay="150">
          Sunbeam's students went to <strong>CMSMUN</strong> — which the school records as
          <em>“an experience that went beyond the classroom.”</em> A Model United Nations committee
          is the one room where a thought is no use until it has been said out loud, to people who
          may disagree.
        </p>
        <p class="ct__p" data-reveal data-reveal-delay="220">
          The school keeps a <strong>Model United Nations Lab</strong> among its inquiry rooms, so
          the committee is not only something the delegation meets once a year at somebody else's
          conference.
        </p>
      </div>

      <div class="ct-voice__stage">
        <ul class="ct-voice__verbs" aria-hidden="true">
          {verbs.map((v, i) => (
            <li class={`ct-verb ct-verb--${i + 1}`} data-reveal data-reveal-delay={i * 90}>{v}</li>
          ))}
        </ul>

        <figure class="ct-voice__a" data-mask data-zoom>
          <Picture
            src={pDelegation}
            alt={`The ${school.name} delegation holding the school flag at the MU20 Model United Nations conference`}
            formats={['avif', 'webp']}
            widths={[420, 900]}
            sizes="(max-width: 900px) 88vw, 40vw"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="ct-voice__b" data-reveal data-reveal-delay="180" data-zoom data-zoom-to="1.16">
          <Picture
            src={pCertificates}
            alt={`Four delegates from ${school.name} holding their Model United Nations certificates in front of the national flags`}
            formats={['avif', 'webp']}
            widths={[300, 620]}
            sizes="(max-width: 900px) 52vw, 22vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>

    <img class="ct__f ct__f--q" src={dQuestion.src} alt="" aria-hidden="true" data-parallax data-parallax-y="40" />
  </section>

  {/* ═══ 03 · IDEAS INTO IMPACT ══════════════════════════════════════════════
      The loudest section. IMPACT set behind the photograph at poster scale, a
      drawn arc carrying idea → solved, and the result stated as the school
      published it. */}
  <section class="ct-impact" aria-labelledby="ct-impact-h">
    <span class="ct__dots" aria-hidden="true"></span>
    <span class="ct-impact__word" aria-hidden="true">Impact</span>

    <div class="u-container ct-impact__in">
      <div class="ct-impact__copy">
        <p class="ct__k ct__k--onink t-label" data-reveal>Ideas into impact</p>
        <h2 class="ct-impact__h" id="ct-impact-h" data-split>
          Two days, seven schools,<br /><em>one working answer</em>
        </h2>
        <p class="ct__p ct__p--onink" data-reveal data-reveal-delay="150">
          <strong>SUNBEAM INNOVX — Hackathon &amp; Coding Contest 2026</strong> is the school's own
          description of <em>“a two-day celebration of young innovators solving real-world problems
          through code, creativity, and collaboration.”</em>
        </p>
        <p class="ct__p ct__p--onink" data-reveal data-reveal-delay="220">
          Seven schools entered the preliminary round. The finals took the top three on cut-off
          merit — Sunbeam School Ballia, Columbus International School and PM Shri Kendriya
          Vidyalaya.
        </p>

        <ol class="ct-arc" data-reveal data-reveal-delay="300">
          {arc.map((a, i) => (
            <li class="ct-arc__step">
              <span class="ct-arc__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="ct-arc__k">{a}</span>
            </li>
          ))}
        </ol>
      </div>

      <figure class="ct-impact__art" data-mask data-mask-from="left" data-zoom data-zoom-to="1.12">
        <Picture
          src={pMonash}
          alt={`A student of ${school.name} beside the Monash University Innovation Guarantee banner at an outreach session`}
          formats={['avif', 'webp']}
          widths={[380, 760]}
          sizes="(max-width: 900px) 76vw, 32vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <img class="ct__f ct__f--focus" src={dFocus.src} alt="" aria-hidden="true" />
  </section>

  {/* ═══ 04 · CREATE ═════════════════════════════════════════════════════════
      A collage on sand — one dominant frame, one small, one cropped to a
      fragment — with CREATE. across it and the closing line under. */}
  <section class="ct-create" aria-labelledby="ct-create-h">
    <div class="u-container ct-create__in">
      <div class="ct-create__collage">
        <figure class="ct-create__a" data-mask data-zoom>
          <Picture
            src={pCanva}
            alt={`A Canva Presentation activity in progress with a class at ${school.name} during Impetus, Classes III to V`}
            formats={['avif', 'webp']}
            widths={[420, 900]}
            sizes="(max-width: 900px) 88vw, 42vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="ct-create__b" data-reveal data-reveal-delay="150" data-zoom data-zoom-to="1.16">
          <Picture
            src={pMaking}
            alt={`Students of ${school.name} working on embroidery together from one shared basket of thread`}
            formats={['avif', 'webp']}
            widths={[300, 620]}
            sizes="(max-width: 900px) 48vw, 22vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="ct-create__c" data-reveal data-reveal-delay="230" data-zoom data-zoom-to="1.2">
          <Picture
            src={pRocket}
            alt={`A young student of ${school.name} holding a hand-made rocket cut-out at the Star Gazing session`}
            formats={['avif', 'webp']}
            widths={[260, 520]}
            sizes="(max-width: 900px) 40vw, 16vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>

      <div class="ct-create__copy">
        <h2 class="ct-create__h" id="ct-create-h" data-split>Create.</h2>
        <p class="ct-create__p" data-reveal data-reveal-delay="150">
          Because ideas become powerful when students have the freedom to express them — on a
          stage, in a presentation, or with their hands. The school's own TED Talk put it best:
          <em>“Where ideas take the stage and voices find their power.”</em>
        </p>
        <p class="ct-create__end" data-reveal data-reveal-delay="240">Think deeply. Create boldly.</p>
      </div>
    </div>

    <img class="ct__f ct__f--stars" src={dTwoStars.src} alt="" aria-hidden="true" />
    <img class="ct__f ct__f--star" src={dStar.src} alt="" aria-hidden="true" />
  </section>
</div>

<style>
  .ct { position: relative; }

  .ct__k { color: var(--sb-violet-dark); }
  .ct__k--onink { color: var(--sb-lime); }

  .ct__p {
    max-width: 50ch;
    margin-top: clamp(14px, 1.8vw, 20px);
    font-size: clamp(15px, 1.1vw, 17px);
    line-height: 1.76;
    color: var(--sb-text-secondary);
  }
  .ct__p strong { font-weight: 700; color: var(--sb-charcoal); }
  .ct__p em { font-style: italic; color: var(--sb-charcoal); }
  .ct__p--onink { color: rgba(255, 255, 255, 0.82); }
  .ct__p--onink strong,
  .ct__p--onink em { color: #fff; }

  .ct__f { position: absolute; z-index: 3; pointer-events: none; user-select: none; }

  /* ⚠ EVERY FRAME STRETCHES ITS <picture>, NOT JUST ITS <img>. astro:assets emits
     <picture><img></picture> and <picture> is an INLINE box, so an img's
     `height: 100%` resolves against its intrinsic height rather than the figure. */
  .ct :global(figure > picture) { display: block; width: 100%; height: 100%; }

  /* ═══ 01 · MINDSET ═════════════════════════════════════════════════════════ */
  .ct-mind {
    position: relative;
    overflow: hidden;
    padding-block: clamp(58px, 9vw, 128px);
    background: var(--sb-ivory);
  }

  .ct__grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(27, 21, 18, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(27, 21, 18, 0.045) 1px, transparent 1px);
    background-size: 78px 78px;
    -webkit-mask-image: radial-gradient(70% 62% at 24% 30%, #000, transparent 74%);
    mask-image: radial-gradient(70% 62% at 24% 30%, #000, transparent 74%);
  }

  /* A background wash, not a floating ornament — it lies UNDER the statement at
     low opacity, so it is held to a contrast rule rather than a clearance one. */
  .ct__bg-shape {
    position: absolute;
    top: -8%;
    right: -8%;
    z-index: 0;
    width: clamp(190px, 32vw, 470px);
    opacity: 0.12;
    pointer-events: none;
  }

  .ct-mind__in { position: relative; z-index: 1; }

  .ct-mind__h {
    margin: clamp(14px, 1.8vw, 26px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(38px, 8vw, 118px);
    font-weight: 700;
    line-height: 0.92;
    letter-spacing: -0.05em;
    color: var(--sb-charcoal);
  }
  .ct-mind__h em { font-style: normal; color: var(--sb-violet); }

  .ct-mind__art {
    width: min(58vw, 300px);
    margin: clamp(20px, 3vw, 32px) 0 0;
  }

  /* ⚠ THE CROP IS ON THIS SPAN, NOT ON THE <figure>. data-zoom scales the image
     and needs its own element to clip; clipping the figure took the figcaption
     with it and the credit line disappeared. */
  .ct-mind__frame {
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: var(--sb-r-2);
    box-shadow: 0 36px 70px -40px rgba(27, 21, 18, 0.55);
  }
  .ct-mind__frame :global(picture) { display: block; width: 100%; height: 100%; }
  .ct-mind__frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ct-mind__art figcaption {
    margin-top: 10px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sb-violet-dark);
  }

  .ct-mind__copy { margin-top: clamp(22px, 3vw, 34px); }

  /* ═══ 02 · VOICE ═══════════════════════════════════════════════════════════ */
  .ct-voice {
    position: relative;
    overflow: hidden;
    padding-block: clamp(58px, 9vw, 128px);
    background: var(--sb-paper);
  }

  .ct-voice__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(32px, 4.6vw, 68px);
    align-items: center;
  }

  .ct-voice__h {
    margin-top: var(--sb-3);
    font-family: var(--sb-font-display);
    font-size: clamp(28px, 4.4vw, 58px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.042em;
    color: var(--sb-charcoal);
  }
  .ct-voice__h em { font-style: normal; color: var(--sb-violet); }

  .ct-voice__stage { position: relative; }

  .ct-voice__a,
  .ct-voice__b { margin: 0; overflow: hidden; }
  .ct-voice__a :global(img),
  .ct-voice__b :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .ct-voice__a {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 3;
    border-radius: var(--sb-r-3);
    box-shadow: 0 44px 84px -46px rgba(27, 21, 18, 0.55);
  }

  .ct-voice__b {
    position: relative;
    z-index: 3;
    width: 52%;
    margin: -18% 0 0 auto;
    aspect-ratio: 4 / 3;
    border: 8px solid var(--sb-paper);
    border-radius: var(--sb-r-2);
    box-shadow: 0 34px 64px -34px rgba(27, 21, 18, 0.5);
  }

  /* The verbs. Set bare on the paper — no chip, no border, no plate. In flow on
     a phone; scattered around the frames from 900 up. */
  .ct-voice__verbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    margin: 0 0 clamp(16px, 2.4vw, 24px);
    padding: 0;
    list-style: none;
  }
  .ct-verb {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sb-violet-dark);
  }
  .ct-verb::before { content: '— '; color: var(--sb-border-strong); }

  .ct__f--q { top: 6%; right: 4%; width: clamp(34px, 4vw, 60px); opacity: 0.85; }

  /* ═══ 03 · IMPACT ══════════════════════════════════════════════════════════ */
  .ct-impact {
    position: relative;
    overflow: hidden;
    padding-block: clamp(58px, 9vw, 128px);
    background: var(--sb-violet-ink);
  }

  .ct__dots {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1px, transparent 1px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(80% 70% at 60% 40%, #000 25%, transparent 80%);
    mask-image: radial-gradient(80% 70% at 60% 40%, #000 25%, transparent 80%);
  }

  /* Poster scale, bled off the right edge, almost the ground's own value. */
  .ct-impact__word {
    position: absolute;
    right: -0.06em;
    bottom: -0.14em;
    z-index: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(150px, 26vw, 420px);
    font-weight: 700;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: rgba(255, 255, 255, 0.045);
    pointer-events: none;
    user-select: none;
    white-space: nowrap;
  }

  .ct-impact__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(30px, 4.4vw, 64px);
    align-items: center;
  }

  .ct-impact__h {
    margin-top: var(--sb-3);
    font-family: var(--sb-font-display);
    font-size: clamp(28px, 4.4vw, 58px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.042em;
    color: #fff;
  }
  .ct-impact__h em { font-style: normal; color: var(--sb-lime); }

  /* The arc: four steps on one hairline, numerals above the words. Not cards —
     there is no box, only the rule they hang from. */
  .ct-arc {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 10px;
    margin: clamp(24px, 3.2vw, 38px) 0 0;
    padding: clamp(14px, 2vw, 20px) 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    list-style: none;
  }
  .ct-arc__step { display: grid; gap: 4px; }
  .ct-arc__n {
    font-family: var(--sb-font-display);
    font-size: clamp(15px, 1.5vw, 21px);
    font-weight: 700;
    color: var(--sb-lime);
  }
  .ct-arc__k {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.8);
  }

  .ct-impact__art {
    margin: 0;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--sb-r-3);
    box-shadow: 0 44px 84px -40px rgba(0, 0, 0, 0.8);
  }
  .ct-impact__art :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 32%; }

  .ct__f--focus { top: 8%; left: 3%; width: clamp(38px, 4.4vw, 64px); opacity: 0.6; }

  /* ═══ 04 · CREATE ══════════════════════════════════════════════════════════ */
  .ct-create {
    position: relative;
    overflow: hidden;
    padding-block: clamp(58px, 9vw, 128px);
    background: var(--sb-sand);
  }

  .ct-create__in {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(30px, 4.4vw, 64px);
    align-items: center;
  }

  .ct-create__collage { position: relative; }

  .ct-create__a,
  .ct-create__b,
  .ct-create__c { margin: 0; overflow: hidden; }
  .ct-create__a :global(img),
  .ct-create__b :global(img),

---
/**
 * LIGHTBOX — one viewer, bound to any trigger on the page.
 *
 * ═══ THE CONTRACT ══════════════════════════════════════════════════════════
 *
 * Drop `<Lightbox />` once on a page. Then any anchor marked `data-lb-open`
 * opens it, reading:
 *
 *   href              the full-size image (also the no-JS fallback)
 *   data-lb-alt       the description, used as the viewer's alt
 *   data-lb-cap       optional caption line
 *
 * The set is recomputed from the DOM every time it opens, so a gallery that
 * filters or paginates never arrows into a frame the reader cannot see.
 *
 * ⚠ THE TRIGGER IS AN <a href>, NOT A <button>. Without JavaScript the link
 * still opens the photograph — the reader loses the viewer, not the picture.
 * A button would leave them with a control that does nothing.
 *
 * ⚠ THIS DUPLICATES THE VIEWER INSIDE Masonry.astro, AND THAT IS A KNOWN DEBT,
 * recorded here rather than left for someone to discover. Masonry's copy is
 * wound through that page's filtering and batching — its `visible` array is
 * derived from the wall's filter state — so lifting it out is a real refactor
 * of a working page rather than a move. This component is written to the
 * contract Masonry would need (recompute on open, read from the trigger), so
 * that migration is an edit to Masonry alone when someone has time to test the
 * campus gallery properly. Two viewers is worse than one; two viewers with the
 * second one built to absorb the first is the cheapest honest step.
 */
---

<div class="lbx" data-lbx hidden>
  <div class="lbx__scrim" data-lbx-close aria-hidden="true"></div>

  <div class="lbx__panel" role="dialog" aria-modal="true" aria-label="Photograph viewer">
    <header class="lbx__bar">
      <p class="lbx__meta">
        <span class="lbx__cap" data-lbx-cap></span>
        <span class="lbx__n t-tabular" data-lbx-n></span>
      </p>

      <button type="button" class="lbx__close" data-lbx-close>
        <span class="u-visually-hidden">Close the viewer</span>
        <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1.5 1.5l11 11m0-11l-11 11" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>
      </button>
    </header>

    <div class="lbx__stage">
      <button type="button" class="lbx__nav lbx__prev" data-lbx-prev aria-label="Previous photograph">
        <svg width="17" height="12" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M5 1L1 5l4 4M1 5h13" stroke="currentColor" stroke-width="1.7" />
        </svg>
      </button>

      {/* alt is written by the script from the trigger, so the viewer describes
          the picture rather than announcing "image". */}
      <img class="lbx__img" data-lbx-img alt="" />

      <button type="button" class="lbx__nav lbx__next" data-lbx-next aria-label="Next photograph">
        <svg width="17" height="12" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.7" />
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  /* ⚠ ABOVE EVERY OTHER FIXED LAYER ON THE SITE. The known ladder is: masthead
     50, mobile drawer 100, the drawer's own close button 120. At 200 the viewer
     cleared the drawer but the STICKY MASTHEAD still painted over the scrim —
     the top bar sat bright and undimmed above a darkened page, and the logo
     stayed clickable behind the modal. 900 leaves room for anything added
     between, without reaching for the maximum and starting an arms race. */
  /* ⚠ THE ROW IS EXPLICIT, AND THAT IS THE WHOLE FIX. Left implicit, the single
     grid row is AUTO-SIZED — so it grew to the 1656px the panel wanted, and the
     panel's `height: 100%` then measured itself against that. Circular: content
     sized the row, the row sized the percentage, nothing was ever clamped.

     `minmax(0, 1fr)` on a fixed, definite-height container gives a definite row
     that content cannot inflate. That is what makes the percentages down the
     chain — panel, stage, image — resolve to real numbers. */
  .lbx {
    position: fixed;
    z-index: 900;
    inset: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    place-items: center;
    padding: clamp(12px, 2.5vw, 40px);
  }

  .lbx[hidden] { display: none; }

  .lbx__scrim {
    position: absolute;
    inset: 0;
    background: rgba(12, 6, 4, 0.88);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .lbx.is-open .lbx__scrim { opacity: 1; }

  /* ⚠ `height`, NOT `max-height`. This read `max-height: 100%`, and that made
     the panel's height AUTO — content-driven, merely capped. A percentage height
     on a descendant of an auto-height box is indefinite, so the `max-height:
     100%` on the image below resolved to nothing at all.

     It went unnoticed because every landscape photograph is caught by
     `max-width: 100%` first: at 1600×1066 in an 1100px panel the width binds and
     the height simply follows. The two PORTRAIT frames in the Viswakarma Pooja
     set are 1066×1600 — narrower than the panel, so nothing bound them and they
     painted at full natural size. Measured at 1909×1021: the image ran 675px
     past the bottom of the window, and at 1280×620 it ran 1068px past.

     A definite height here makes the `minmax(0, 1fr)` stage row definite, which
     is what lets the image's own `max-height: 100%` finally resolve. */
  .lbx__panel {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    gap: var(--sb-4);
    width: min(100%, 1100px);
    height: 100%;
  }

  .lbx__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sb-5);
  }

  .lbx__meta { display: flex; align-items: baseline; gap: var(--sb-4); min-width: 0; }

  .lbx__cap {
    font-size: var(--sb-body-sm);
    line-height: 1.4;
    color: rgba(255, 255, 255, 0.82);
  }

  .lbx__n { font-size: var(--sb-body-sm); color: rgba(255, 255, 255, 0.55); white-space: nowrap; }

  /* ⚠ SOLID, NOT AN OUTLINE. This was a transparent disc with a 1px 28%-white
     border — which reads as decoration rather than a control, and the client
     reported not being able to find it. Against an 0.88 scrim the page's own
     text still bleeds through at roughly 1.5:1, so a hairline ring competes
     with that noise instead of standing out of it.

     A filled white disc with a dark glyph is unambiguous at a glance, is the
     convention every photo viewer uses, and measures 18:1 against the scrim. */
  .lbx__close {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 44px;
    aspect-ratio: 1;
    border: 0;
    border-radius: 50%;
    background: #fff;
    color: var(--sb-charcoal);
    cursor: pointer;
    box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.7);
    transition: background 180ms ease, transform 180ms var(--sb-ease);
  }

  .lbx__close:hover { background: var(--sb-lime); transform: scale(1.06); }
  .lbx__close:focus-visible { outline: 2px solid var(--sb-focus); outline-offset: 3px; }

  .lbx__stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 0;
  }

  /* ⚠ PINNED TO THE STAGE, NOT SIZED BY `max-width/max-height: 100%`. The
     percentage pair looks like the obvious answer and quietly fails: a grid
     item's percentage height resolves against its GRID AREA, and both this
     stage's row and the wrapper's above it were implicit and therefore
     content-sized. So the row grew to the photograph and the photograph then
     measured itself against the row. Fixing the outer row alone was not enough —
     the same trap sat one level down.

     `inset: 0` plus `object-fit: contain` takes the box from the stage and fits
     the picture inside it, which cannot overflow whatever the chain above does,
     and centres on both axes for free. The frame is still never cropped — that
     is the entire point of this view. */
  .lbx__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    border-radius: var(--sb-r-2);
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 240ms ease, transform 320ms var(--sb-ease);
  }

  .lbx.is-ready .lbx__img { opacity: 1; transform: none; }

  .lbx__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 46px;
    aspect-ratio: 1;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    cursor: pointer;
    transition: background 180ms ease, transform 180ms var(--sb-ease);
  }

  .lbx__prev { left: 0; }
  .lbx__next { right: 0; }

  .lbx__nav:hover,
  .lbx__nav:focus-visible { background: rgba(255, 255, 255, 0.26); transform: translateY(-50%) scale(1.06); }
  .lbx__nav:focus-visible { outline: 2px solid var(--sb-focus); outline-offset: 2px; }
  .lbx__nav[hidden] { display: none; }

  @media (max-width: 620px) {
    .lbx__nav { width: 40px; }
    .lbx__prev { left: -4px; }
    .lbx__next { right: -4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .lbx__scrim,
    .lbx__img,
    .lbx__nav,
    .lbx__close { transition-duration: 1ms; }
    .lbx__img,
    .lbx__close:hover { transform: none; }
  }
</style>

<script>
  /**
   * ⚠ EVERY SYMBOL IS INSIDE THE BLOCK. Astro concatenates component scripts
   * into one page bundle, so a bare `const nav` here would collide with any
   * other component's `nav` on the same page — this codebase has shipped a
   * 500ing script that way twice, with a green build both times.
   */
  {
    const box = document.querySelector<HTMLElement>('[data-lbx]');

    /**
     * ⚠ EVERY INTERNAL LOOKUP IS SCOPED TO `box`, NEVER TO `document`. These
     * were `document.querySelector` and it destroyed the gallery.
     *
     * The triggers carried `data-lb-cap` for the viewer to read. The viewer's
     * own caption element carried the same attribute name — and the triggers
     * come FIRST in the document, because this component is mounted at the end
     * of the page. So `document.querySelector('[data-lb-cap]')` returned the
     * first gallery link rather than the caption span, and
     * `cap.textContent = …` replaced that link's entire contents — its
     * <picture> and its zoom badge — with a line of text. The first photograph
     * in every gallery turned into its own title the moment the viewer opened.
     *
     * Scoping to `box` makes the collision impossible rather than unlikely, and
     * the trigger attributes are named `data-lb-*` against the viewer's
     * `data-lbx-*` so the two namespaces cannot be confused by eye either.
     */
    const frame = box?.querySelector<HTMLImageElement>('[data-lbx-img]');
    const cap = box?.querySelector<HTMLElement>('[data-lbx-cap]');
    const tally = box?.querySelector<HTMLElement>('[data-lbx-n]');
    const prevBtn = box?.querySelector<HTMLButtonElement>('[data-lbx-prev]');
    const nextBtn = box?.querySelector<HTMLButtonElement>('[data-lbx-next]');

    if (box && frame && prevBtn && nextBtn) {
      let shots: HTMLAnchorElement[] = [];
      let at = 0;
      let opener: HTMLElement | null = null;

      const show = (i: number) => {
        const a = shots[i];
        if (!a) return;
        at = i;
        box.classList.remove('is-ready');
        frame.src = a.getAttribute('href') ?? '';
        frame.alt = a.dataset.lbAlt ?? '';
        if (cap) cap.textContent = a.dataset.lbCap ?? '';
        if (tally) tally.textContent = `${i + 1} / ${shots.length}`;
        /* A single-image gallery gets no arrows — two controls that both do
           nothing is worse than none. */
        prevBtn.hidden = shots.length < 2;
        nextBtn.hidden = shots.length < 2;
        const done = () => box.classList.add('is-ready');
        if (frame.complete) done();
        else frame.addEventListener('load', done, { once: true });
      };

      const step = (d: number) => show((at + d + shots.length) % shots.length);

      const close = () => {
        box.hidden = true;
        box.classList.remove('is-open', 'is-ready');
        document.documentElement.style.removeProperty('overflow');
        /* Focus goes back where it came from, or the reader is dumped at the
           top of the document with no idea what they just closed. */
        opener?.focus();
        opener = null;
      };

      const open = (from: HTMLAnchorElement) => {
        /* Recomputed on every open, so a filtered or paginated gallery never
           arrows into something hidden. */
        shots = [...document.querySelectorAll<HTMLAnchorElement>('[data-lb-open]')].filter(
          (a) => a.offsetParent !== null,
        );
        const i = shots.indexOf(from);
        if (i === -1) return;
        opener = from;
        box.hidden = false;
        /* Locking the document rather than the body — iOS ignores overflow on
           body when the page is already scrolled. */
        document.documentElement.style.overflow = 'hidden';
        requestAnimationFrame(() => box.classList.add('is-open'));
        show(i);
        /* ⚠ `button[data-lbx-close]`, NOT `[data-lbx-close]`. That attribute is
           on the scrim as well as the close button, and the scrim is a <div>
           that comes first in the DOM — so the bare selector returned an
           unfocusable element and `.focus()` silently did nothing. Focus stayed
           on the page behind the modal, which is the whole failure this line
           exists to prevent. */
        box.querySelector<HTMLButtonElement>('button[data-lbx-close]')?.focus();
      };

      document.addEventListener('click', (e) => {
        const trigger = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-lb-open]');
        if (!trigger) return;
        /* Let a modified click do what the reader asked — open in a new tab. */
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.button !== 0) return;
        e.preventDefault();
        open(trigger);
      });

      box.querySelectorAll('[data-lbx-close]').forEach((el) => el.addEventListener('click', close));
      prevBtn.addEventListener('click', () => step(-1));
      nextBtn.addEventListener('click', () => step(1));

      document.addEventListener('keydown', (e) => {
        if (box.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft') step(-1);
        else if (e.key === 'ArrowRight') step(1);
        else if (e.key === 'Tab') {
          /* A modal that lets Tab escape into the page behind it is a modal in
             appearance only. Three controls, cycled. */
          const keys = [...box.querySelectorAll<HTMLElement>('button:not([hidden])')];
          if (!keys.length) return;
          const first = keys[0];
          const last = keys[keys.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      });
    }
  }
</script>

---
/**
 * §10 · NOTICE BOARD & ALUMNI — audit 1.10 (notices) and 12.2 (alumni registration)
 *
 * Audit 1.10 asks for a text-first notice board rather than another photo grid;
 * audit 12.2 asks for an alumni registration route off the homepage. They share
 * a band because each alone is a thin strip, and a thin strip between two large
 * sections reads as an afterthought.
 *
 * DATES — deliberately absent. The audit's own point about a notice board is
 * that it must be current, and a date we invented would make it untrue on the
 * day it shipped. Each row therefore carries a category, not a timestamp, and
 * points at the real page the school already maintains. When the school hands
 * over a notice feed with real dates (asset request A7), swap `notices` for it
 * and add a `date` to the row — the layout already leaves room on the right.
 *
 * Every destination below exists on the live site (docs/01 § 5).
 */
import { school } from '../../data/site';

/**
 * ⚠ THE ALUMNI CARD'S GROUND, and it is run through Astro's image pipeline
 * rather than set as a CSS url() — the source is a 1 MB PNG and a url() would
 * ship every byte of it. 400/560/900 are all on IMAGE_WIDTHS in
 * astro.config.mjs; the adapter SILENTLY DROPS any width that is not, so do not
 * invent one here. 900 is the ceiling worth asking for at this card's width.
 */
import { Picture } from 'astro:assets';
import alumniArt from '../../assets/icons/NoticeBoard.png';

const notices = [
  {
    tag: 'Admissions',
    title: 'Admissions open — Nursery to Class IX and Class XI',
    detail: 'Apply online, or call the admissions desk on ' + school.phone.admissionsDisplay,
    href: '/admission-notice/',
  },
  {
    tag: 'Academics',
    title: 'Academic calendar — terms, holidays and examination dates',
    detail: 'The session calendar as published by the school office',
    href: '/academics/academic-calendar/',
  },
  {
    tag: 'Results',
    title: 'Report cards and results portal',
    detail: 'Parent login for term reports and examination results',
    href: school.external.results,
    external: true,
  },
  {
    tag: 'Transport',
    title: 'School transport — 22 routes across Ballia',
    detail: 'Route list and stops · transport desk ' + school.phone.transportDisplay,
    href: '/campus/transport/',
  },
  {
    tag: 'Records',
    title: 'Transfer Certificate download',
    detail: 'Request and download a TC for a withdrawn student',
    href: school.external.downloadTC,
    external: true,
  },
  {
    tag: 'Compliance',
    title: 'Mandatory public disclosure — CBSE',
    detail: `Affiliation ${school.affiliationNo} · School Code ${school.schoolCode}`,
    href: '/general-info/',
  },
];
---

<section class="notice" aria-labelledby="notice-heading">
  <div class="u-container">
    <div class="notice__grid">
      {/* --- Notice board ------------------------------------------------- */}
      <div class="notice__board" data-reveal>
        <header class="notice__head">
          <div>
            <p class="notice__pill"><span class="pill pill--violet">Notice Board</span></p>
            <h2 class="notice__heading t-h2-sans" data-split id="notice-heading">
              What you need to <span class="t-squiggle">know</span>
            </h2>
          </div>
          <a class="notice__all" href="/news-events/notices/">
            All notices
            <svg width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.6" />
            </svg>
          </a>
        </header>

        <ul class="notice__list">
          {notices.map((n) => (
            <li class="notice__item">
              <a
                class="notice__link"
                href={n.href}
                {...('external' in n && n.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <span class="notice__tag">{n.tag}</span>
                <span class="notice__text">
                  <span class="notice__title">{n.title}</span>
                  <span class="notice__detail">{n.detail}</span>
                </span>
                <span class="notice__go" aria-hidden="true">
                  <svg width="13" height="10" viewBox="0 0 14 10" fill="none">
                    <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      {/* --- Alumni ------------------------------------------------------- */}
      <aside class="notice__alumni" data-reveal data-reveal-delay="120"
        aria-labelledby="alumni-heading">
        {/* Decorative ground. alt="" because the crest watermark inside it is
            already the school's own mark, present in the masthead of every
            page — announcing it here would be repetition, not information. */}
        <Picture
          class="notice__alumni-bg"
          src={alumniArt}
          alt=""
          aria-hidden="true"
          formats={['avif', 'webp']}
          widths={[400, 560, 900]}
          sizes="(max-width: 1023px) 92vw, 32vw"
          loading="lazy"
          decoding="async"
        />
        <p class="notice__pill"><span class="pill pill--violet">Alumni</span></p>
        <h2 class="notice__alumni-heading" id="alumni-heading">
          Once a Sunbeamite, always a Sunbeamite
        </h2>
        <p class="notice__alumni-copy">
          Thirteen batches have left the Agarsanda campus since 2013, and
          <strong>Pradiptam</strong>, the alumni meet, brings them back to it. Register
          and we will keep you on the list for the next one.
        </p>

      </aside>
    </div>
  </div>
</section>

<style>
  .notice {
    background: var(--sb-sand);
    padding-block: var(--sb-section-y);
  }

  .notice__grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--sb-8);
    /* stretch, not start: the notice list is roughly twice the alumni card's
       natural height, and a start-aligned card left a column of dead ground
       beneath it. The card fills the row and centres its own content. */
    align-items: stretch;
  }

  /* --- Board ---------------------------------------------------------------- */

  .notice__board {
    padding: var(--sb-8);
    border-radius: var(--sb-r-2);
    background: #fff;
    box-shadow: var(--sb-shadow-card);
  }

  .notice__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sb-6);
    margin-bottom: var(--sb-7);
  }

  .notice__pill { margin-bottom: var(--sb-5); }
  .notice__heading { color: var(--sb-charcoal); }

  .notice__all {
    display: inline-flex;
    align-items: center;
    gap: var(--sb-3);
    flex-shrink: 0;
    padding-bottom: 4px;
    font-size: var(--sb-body-sm);
    font-weight: 600;
    color: var(--sb-violet);
    border-bottom: 1px solid currentColor;
  }

  .notice__all svg { transition: transform var(--sb-dur-link) var(--sb-ease); }
  .notice__all:hover svg { transform: translateX(3px); }

  .notice__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--sb-hairline);
  }

  /* Single selector shape throughout — see the note in ProofStrip on Astro's
     scope attribute raising combinator specificity above later overrides. */
  .notice__item { border-bottom: var(--sb-hairline); }

  .notice__link {
    display: grid;
    grid-template-columns: 108px minmax(0, 1fr) 34px;
    align-items: center;
    gap: var(--sb-5);
    padding: var(--sb-5) var(--sb-4);
    margin-inline: calc(var(--sb-4) * -1);
    border-radius: var(--sb-r-0);
    transition: background-color var(--sb-dur-link) ease;
  }

  .notice__link:hover { background: var(--sb-violet-wash); }

  .notice__tag {
    justify-self: start;
    padding: 4px 10px;
    border-radius: var(--sb-r-full);
    background: var(--sb-violet-wash);
    color: var(--sb-violet-dark);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .notice__text {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .notice__title {
    font-size: var(--sb-body-sm);
    font-weight: 600;
    line-height: 1.4;
    color: var(--sb-charcoal);
  }

  .notice__detail {
    font-size: var(--sb-caption);
    line-height: 1.45;
    color: var(--sb-text-muted);
  }

  .notice__go {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--sb-r-full);
    border: 1px solid var(--sb-border-strong);
    color: var(--sb-charcoal);
    transition: background-color var(--sb-dur-btn) ease, border-color var(--sb-dur-btn) ease,
      color var(--sb-dur-btn) ease;
  }

  .notice__link:hover .notice__go {
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    color: #fff;
  }

  /* --- Alumni --------------------------------------------------------------- */

  /* ⚠⚠ THIS CARD WAS DARK AND IS NOW LIGHT, AND EVERY COLOUR IN IT MOVED WITH
     IT. The client supplied a cream artwork ground with the school crest
     watermarked into it; white text on ink became ink text on cream, the pill
     went from --lime (an on-dark orange) to --violet, and the card grew a
     hairline because a cream panel on sand needs an edge that an ink panel did
     not. Flipping the ground back without flipping these is white-on-cream. */
  .notice__alumni {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--sb-9) var(--sb-8);
    border-radius: var(--sb-r-2);
    /* Fallback ground, and it matters: it is what shows in the moment before
       the artwork paints, and it is the artwork's own field colour. */
    background: #fdf6ef;
    border: 1px solid rgba(201, 60, 10, 0.14);
    color: var(--sb-ink);
    box-shadow: var(--sb-shadow-card);
    overflow: hidden;
  }

  /* <Picture> puts this class on the <img>; the <picture> wrapper is static, so
     `inset: 0` resolves against .notice__alumni, which is position: relative. */
  /* ⚠ OVERSIZED BY 6% AND PULLED BACK 3%, so the card's overflow:hidden crops
     the artwork's own bleed. The file is itself a drawn card — a rounded
     rectangle with white outside its corners — and placed flush it read as a
     frame inside a frame, the drawn arc sitting a few pixels inside this card's
     radius.

     ⚠⚠ THE SIZE IS EXPLICIT BECAUSE `inset: -3%` WITH `width: auto` DOES NOT
     WORK ON AN IMAGE. For an absolutely positioned REPLACED element, `width:
     auto` resolves to the intrinsic width and the opposite inset is then
     ignored as over-constrained — the artwork sized itself to 460px, anchored
     left, and left a pale strip down the right and bottom edges. width/height
     have to be stated. */
  .notice__alumni-bg {
    position: absolute;
    top: -3%;
    left: -2%;
    z-index: 0;
    width: 106%;
    height: 106%;
    /* ⚠⚠ WITHOUT THIS THE OVERSIZE ONLY HAPPENS VERTICALLY. base.css sets
       `img, picture, svg, video { max-width: 100% }` globally, so `width: 106%`
       was clamped straight back to 100% while `height: 106%` — which no global
       rule caps — went through. The artwork ended up 449 wide in a 451 card,
       anchored left, overhanging 12.5px on the left and falling 14.5px SHORT on
       the right: a pale strip down the right edge and across the bottom, and
       nothing in this rule to explain it. Measured, not guessed. */
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  /* ⚠⚠ A VEIL THAT SOFTENS THE CREST, NOT ONE THAT ERASES IT. The crest is
     watermarked dead centre of the file and the copy sits dead centre of the
     card, so at full strength the heading was reading over the ring lettering
     and "Estd.2013" and the text stopped looking like the thing you were meant
     to read. The first attempt at this fix went too far the other way and
     removed the crest altogether — the client wants it visible, just faint.

     ⚠ 0.8 IS A TUNED VALUE, NOT A ROUND NUMBER. Rendered and compared at 0.95,
     0.8, 0.7, 0.58 and 0.45: below about 0.7 the ring lettering starts
     competing with the heading, and at 0.95 the crest is gone. 0.8 leaves the
     ring, the sun rays and "Estd.2013" all legible as a watermark while the
     copy stays clean. Judge any change to it on screen, at this card's size —
     the number means nothing on its own.

     ⚠ IT CLEARS BY THE CORNERS on purpose, so the orange corner blobs keep
     their full strength. Fading the whole image instead would have taken those
     with it, and they are half the reason the artwork is here.

     ⚠ IT IS A PSEUDO-ELEMENT AT z-index 1, BETWEEN THE IMAGE (0) AND THE COPY
     (2). Paint order alone will not do it — ::after paints with the element's
     children and the <picture> comes first in the DOM, so with no explicit
     z-index the veil lands under the artwork and does nothing at all. */
  .notice__alumni::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: radial-gradient(
      118% 76% at 50% 50%,
      rgba(253, 246, 239, 0.8) 0%,
      rgba(253, 246, 239, 0.72) 34%,
      rgba(253, 246, 239, 0.43) 60%,
      rgba(253, 246, 239, 0) 80%
    );
  }

  /* ⚠⚠ :not(picture), NOT :not(.notice__alumni-bg). <Picture> renders
     <picture><source…><img class="notice__alumni-bg"> — the class lands on the
     IMG, so the direct child of this card is the <picture> wrapper, which does
     not carry it. Written the obvious way this rule matched the wrapper, made
     it position: relative, and the absolutely-positioned image then sized
     against an empty inline box instead of the card: 369x0, invisible, with the
     image loaded and no error anywhere. The wrapper must stay static so the
     image resolves against .notice__alumni. */
  .notice__alumni > :not(picture) {
    position: relative;
    z-index: 2;
  }


  .notice__alumni-heading {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: var(--sb-h3);
    line-height: var(--sb-h3-lh);
    letter-spacing: -0.02em;
    margin-bottom: var(--sb-5);
  }

  .notice__alumni-copy {
    font-size: var(--sb-body-sm);
    line-height: 1.6;
    /* Charcoal, not muted. Muted grey was picked against a plain card; over
       artwork — even veiled — it was the weakest thing on it. */
    color: var(--sb-charcoal);
  }

  .notice__alumni-copy strong { color: var(--sb-ink); font-weight: 700; }

  /* ⚠ .notice__alumni-cta AND .notice__alumni-alt WERE DELETED HERE, not
     recoloured. Neither element is emitted by this component any more — the
     button and the "or email us" line went in an earlier pass — so both rules
     styled nothing. Dead rules for markup no page renders are how a stylesheet
     stops being readable, and they would have been the next thing to "fix" for
     contrast on a ground they never sat on. */

  /* --- Tablet ---------------------------------------------------------------- */

  @media (max-width: 1023px) {
    .notice__grid { grid-template-columns: minmax(0, 1fr); }

    /* ⚠ PAN OFF THE CREST BELOW THIS BREAKPOINT. The grid drops to one column
       here, so the card turns landscape while the artwork stays portrait —
       `cover` then crops hard vertically and blows the watermarked crest up to
       several times its desktop size, directly behind the copy. "Estd.2013" cut
       straight through the last line. Taking the slice from the very top keeps
       the corner blob and loses the crest, which is the right trade: it is a
       watermark, and the text has to be read. */
    .notice__alumni-bg { object-position: center top; }
  }

  /* --- Mobile ---------------------------------------------------------------- */

  @media (max-width: 639px) {
    .notice__board,
    .notice__alumni { padding: var(--sb-6); }

    .notice__head { flex-direction: column; align-items: flex-start; gap: var(--sb-5); }

    /* The arrow disc goes — the whole row is the tap target — and the tag moves
       above the title so the text keeps a full-width measure. */
    .notice__link {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sb-3);
      padding-block: var(--sb-4);
    }

    .notice__go { display: none; }
  }
</style>

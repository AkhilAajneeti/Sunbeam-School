---
/**
 * §12 · STUDENT & ALUMNI VOICES — audit 13.1
 *
 * Three infinite marquee rows, adjacent rows travelling in opposite directions.
 * The avatar sits on the right of every card.
 *
 * CONTAINMENT: the rows live inside the standard site container and each row
 * clips at the container edge, not the viewport. That is the difference from
 * the earlier version — no full-bleed, no negative margins, so cards are never
 * cut off against the screen edge. Edge masks fade them in and out.
 *
 * Motion is CSS-only: each track holds the set twice and translates -50%, so
 * the loop is seamless without JavaScript measuring anything.
 *
 * WCAG 2.2.2 — KNOWN GAP, client decision. The success criterion wants a pause
 * mechanism for content that moves for more than five seconds, and this had a
 * real button. The client asked for it to be removed, so what remains is:
 *   · pause on hover and on keyboard focus (`:focus-within`)
 *   · prefers-reduced-motion stops the animation entirely and turns each row
 *     into a plain horizontal scroller
 * That covers pointer users, keyboard users and anyone with reduced motion set,
 * but it is not a substitute for an always-available control. If an audit flags
 * it, restore the button — it lived in a `.voices__foot` under the rows.
 *
 * CONTENT: `voices.items` is empty, so cards render their empty state. Quotes
 * attributed to named students of a real school are not ours to write — see
 * docs/08 D19. Fill `items` in data/home.ts and every card populates.
 */
import { voices } from '../../data/home';
import { showBuildNotes } from '../../data/site';
import { Picture } from 'astro:assets';

/**
 * Cloud edges. Built from overlapping circles rather than one hand-written path
 * — circles of the same opaque fill merge into a single silhouette, so the
 * shape stays editable (nudge a radius, get a different cloud) instead of being
 * an unreadable string of bezier coordinates.
 *
 * Clustered into five masses with shallow valleys between them. An evenly
 * spaced row of similar circles reads as a scalloped border; real cloud has a
 * big central billow with smaller puffs shouldering it, and gaps between.
 */
const cloudTop = [
  { cx: 34, cy: 44, r: 46 }, { cx: 122, cy: 38, r: 72 }, { cx: 214, cy: 42, r: 52 },
  { cx: 272, cy: 32, r: 34 },
  { cx: 352, cy: 38, r: 50 }, { cx: 446, cy: 34, r: 84 }, { cx: 548, cy: 36, r: 58 },
  { cx: 604, cy: 30, r: 32 },
  { cx: 690, cy: 38, r: 44 }, { cx: 772, cy: 40, r: 72 }, { cx: 856, cy: 38, r: 54 },
  { cx: 908, cy: 30, r: 30 },
  { cx: 996, cy: 38, r: 48 }, { cx: 1088, cy: 32, r: 88 }, { cx: 1188, cy: 36, r: 60 },
  { cx: 1248, cy: 30, r: 34 },
  { cx: 1320, cy: 38, r: 42 }, { cx: 1394, cy: 40, r: 66 }, { cx: 1448, cy: 42, r: 44 },
];

const cloudBottom = [
  { cx: 30, cy: 40, r: 52 }, { cx: 116, cy: 34, r: 80 }, { cx: 208, cy: 38, r: 48 },
  { cx: 262, cy: 30, r: 30 },
  { cx: 338, cy: 40, r: 44 }, { cx: 412, cy: 38, r: 68 }, { cx: 496, cy: 34, r: 56 },
  { cx: 560, cy: 30, r: 34 },
  { cx: 648, cy: 36, r: 52 }, { cx: 748, cy: 32, r: 86 }, { cx: 848, cy: 36, r: 58 },
  { cx: 906, cy: 30, r: 32 },
  { cx: 984, cy: 40, r: 46 }, { cx: 1066, cy: 38, r: 70 }, { cx: 1152, cy: 40, r: 50 },
  { cx: 1212, cy: 32, r: 32 },
  { cx: 1298, cy: 36, r: 54 }, { cx: 1390, cy: 34, r: 78 }, { cx: 1452, cy: 40, r: 46 },
];

const ROWS = 3;
const hasContent = voices.items.length > 0;
const all: any[] = hasContent ? [...voices.items] : Array.from({ length: voices.slots });
const perRow = Math.ceil(all.length / ROWS);
const rows = Array.from({ length: ROWS }, (_, i) => all.slice(i * perRow, (i + 1) * perRow));
const durations = ['58s', '72s', '64s'];
---

<section class="voices" data-voices aria-labelledby="voices-heading">
  {/* Cloud edges. Filled with --sb-sand, the colour of the sections ABOVE and
      BELOW — that is what makes the band melt into its neighbours instead of
      reading as a separate slab dropped onto the page. Purely decorative, so
      hidden from assistive tech. */}
  <span class="voices__edge voices__edge--top" aria-hidden="true">
    <svg viewBox="0 0 1440 130" preserveAspectRatio="none" focusable="false">
      <rect x="0" y="0" width="1440" height="32" />
      {cloudTop.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
    </svg>
  </span>

  <span class="voices__edge voices__edge--bottom" aria-hidden="true">
    <svg viewBox="0 0 1440 130" preserveAspectRatio="none" focusable="false">
      <rect x="0" y="0" width="1440" height="32" />
      {cloudBottom.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
    </svg>
  </span>

  <div class="u-container">
    <div class="voices__head" data-reveal>
      <p class="voices__eyebrow pill pill--violet">{voices.eyebrow}</p>
      <h2 class="voices__heading t-h2-sans" data-split id="voices-heading">
        What our students <span class="t-squiggle">say</span>
      </h2>
      <p class="voices__deck t-body-lg">{voices.deck}</p>
    </div>

    <div class="voices__rows">
      {rows.map((row, r) => (
        <div class="voices__row" data-dir={r % 2 === 1 ? 'right' : 'left'}>
          <div class="voices__track" style={`--dur: ${durations[r]}`}>
            {/* Rendered twice for the seamless loop; the duplicate is hidden
                from assistive tech so nothing is announced two times over. */}
            {[0, 1].map((copy) =>
              row.map((item: any) => (
                <figure class="vcard" aria-hidden={copy === 1 ? 'true' : undefined}>
                  <div class="vcard__body">
                    <svg class="vcard__quotemark" width="20" height="16" viewBox="0 0 18 15"
                      fill="currentColor" aria-hidden="true">
                      <path d="M7.2 0C3.3 0 0 3.1 0 7.4c0 3.9 2.7 6.9 6.2 7.6l.6-1.9C4.5 12.4 3 10.6 3 8.3h4.2V0Zm10.6 0c-3.9 0-7.2 3.1-7.2 7.4 0 3.9 2.7 6.9 6.2 7.6l.6-1.9c-2.3-.7-3.8-2.5-3.8-4.8H18V0Z" />
                    </svg>

                    {hasContent ? (
                      <>
                        <blockquote class="vcard__quote">{item.quote}</blockquote>
                        <figcaption class="vcard__person">
                          <span class="vcard__name">{item.name}</span>
                          <span class="vcard__sep" aria-hidden="true"></span>
                          <span class="vcard__class">Class of {item.classOf}</span>
                        </figcaption>
                      </>
                    ) : (
                      <>
                        <p class="vcard__quote vcard__quote--empty">
                          Quote to be supplied by the school.
                        </p>
                        <figcaption class="vcard__person">
                          <span class="vcard__name vcard__name--empty">Student name</span>
                          <span class="vcard__sep" aria-hidden="true"></span>
                          <span class="vcard__class">Class of 20——</span>
                        </figcaption>
                      </>
                    )}
                  </div>

                  <div class="vcard__avatar">
                    {item?.photo ? (
                      <Picture
                        src={item.photo}
                        alt={`${item.name}, Sunbeam School Ballia, Class of ${item.classOf}`}
                        formats={['avif', 'webp']}
                        widths={[88, 176]}
                        sizes="88px"
                        loading="lazy"
                      />
                    ) : (
                      <span class="vcard__monogram" aria-hidden="true">
                        <svg width="18" height="15" viewBox="0 0 18 15" fill="currentColor">
                          <path d="M7.2 0C3.3 0 0 3.1 0 7.4c0 3.9 2.7 6.9 6.2 7.6l.6-1.9C4.5 12.4 3 10.6 3 8.3h4.2V0Zm10.6 0c-3.9 0-7.2 3.1-7.2 7.4 0 3.9 2.7 6.9 6.2 7.6l.6-1.9c-2.3-.7-3.8-2.5-3.8-4.8H18V0Z" />
                        </svg>
                      </span>
                    )}
                  </div>
                </figure>
              ))
            )}
          </div>
        </div>
      ))}
    </div>

    {!hasContent && showBuildNotes && (
      <p class="voices__note">
        <strong>Nine slots are laid out and ready.</strong> Real quotes, names,
        class years and headshots are outstanding — asset request <strong>A4</strong>.
      </p>
    )}
  </div>
</section>

<style>
  /* Two very low-saturation washes — cool on the left, warm on the right —
     over the page ground. Kept faint on purpose: the moment a tint is strong
     enough to notice as a colour, the band stops reading as atmosphere and
     starts reading as a coloured box.

     The flat --sb-ivory is the LAST layer, so it is also the computed
     background-color. That matters: the contrast audit resolves grounds from
     `backgroundColor`, and a gradient-only background would resolve to
     transparent and silently skip every text node in this section. */
  .voices {
    /* The cloud edges are absolutely positioned INSIDE the section's padding,
       so they eat it: at 120px padding and a 108px cloud, only 12px of clear
       space was left between the cards and the silhouette — which is what made
       the band feel cramped top and bottom.
       Padding is therefore section rhythm PLUS the cloud height, so the clear
       space either side matches every other section on the page. */
    --cloud-h: clamp(52px, 7.5vw, 108px);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(62% 78% at 10% 38%, rgba(163, 191, 232, 0.28), transparent 68%),
      radial-gradient(58% 74% at 90% 58%, rgba(255, 176, 148, 0.30), transparent 68%),
      var(--sb-ivory);
    padding-block: calc(var(--sb-section-y) + var(--cloud-h));
  }

  /* --- Cloud edges ---------------------------------------------------------- */

  .voices__edge {
    position: absolute;
    left: 0;
    right: 0;
    z-index: -1;
    /* Always shorter than the section's own padding, so the clouds sit in the
       breathing space and never collide with the heading:
       108px against 120px padding at desktop, 52px against 64px at mobile. */
    height: var(--cloud-h);
    line-height: 0;
    pointer-events: none;
  }

  .voices__edge svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--sb-sand);
  }

  .voices__edge--top { top: 0; }

  /* Mirrored rather than a second SVG — the two puff sets already differ, so
     flipping gives a distinct silhouette without more markup. */
  .voices__edge--bottom { bottom: 0; transform: scaleY(-1); }

  /* --- Header, centred ----------------------------------------------------- */

  .voices__head {
    max-width: 62ch;
    margin-inline: auto;
    margin-bottom: var(--sb-9);
    text-align: center;
  }

  .voices__eyebrow { margin-bottom: var(--sb-6); }

  .voices__heading {
    color: var(--sb-charcoal);
    margin-bottom: var(--sb-heading-gap);
  }

  /* One step darker than the usual deck muted grey. The blue wash puts this
     text on a ground of roughly rgb(227,232,241) at its worst point, where
     --sb-text-muted measured 4.46:1 at 768 — a hair under AA. Sampled from
     rendered pixels, not from the computed background-color, which reports flat
     ivory and cannot see a gradient at all. */
  .voices__deck {
    color: var(--sb-text-secondary);
    max-width: 54ch;
    margin-inline: auto;
  }

  /* --- Rows ---------------------------------------------------------------- */

  .voices__rows {
    display: flex;
    flex-direction: column;
    gap: var(--sb-5);
  }

  .voices__row {
    display: flex;
    /* Clipping happens HERE — at the container edge, not the viewport. */
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 5%, #000 95%, transparent);
  }

  .voices__track {
    display: flex;
    gap: var(--sb-5);
    width: max-content;
    padding-right: var(--sb-5); /* keeps the seam even */
    animation: voices-marquee var(--dur) linear infinite;
    will-change: transform;
  }

  /* Adjacent rows travel in opposite directions. */
  .voices__row[data-dir='right'] .voices__track { animation-direction: reverse; }

  @keyframes voices-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* Pause on hover and on keyboard focus. The explicit pause button was removed
     at the client's request — see the WCAG note in the header comment. */
  .voices__rows:hover .voices__track,
  .voices__rows:focus-within .voices__track {
    animation-play-state: paused;
  }

  /* --- Pill card, avatar always on the right -------------------------------- */

  .vcard {
    flex: 0 0 auto;
    width: 404px;
    display: flex;
    /* Avatar first on every card — the markup puts the body first for reading
       order, so the visual order is reversed here. */
    flex-direction: row-reverse;
    align-items: center;
    gap: var(--sb-5);
    margin: 0;
    padding: var(--sb-4) var(--sb-7) var(--sb-4) var(--sb-4);
    background: #fff;
    border-radius: var(--sb-r-full);
    box-shadow: var(--sb-shadow-card);
    transition: box-shadow var(--sb-dur-image) var(--sb-ease);
  }

  .vcard:hover { box-shadow: var(--sb-shadow-card-hover); }

  .vcard__body {
    min-width: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--sb-3);
  }

  .vcard__quotemark { color: var(--sb-violet); opacity: 0.28; }

  .vcard__quote {
    margin: 0;
    font-size: var(--sb-body-sm);
    line-height: 1.5;
    color: var(--sb-text-secondary);
  }

  .vcard__quote--empty { font-style: italic; color: var(--sb-text-muted); }

  .vcard__person {
    display: flex;
    align-items: center;
    gap: var(--sb-3);
    flex-wrap: wrap;
  }

  .vcard__name {
    font-size: var(--sb-body-sm);
    font-weight: 700;
    color: var(--sb-charcoal);
  }

  .vcard__name--empty { color: var(--sb-text-muted); font-weight: 600; }

  .vcard__sep { width: 1px; height: 12px; background: var(--sb-border-strong); }

  .vcard__class { font-size: var(--sb-caption); color: var(--sb-text-muted); }

  .vcard__avatar {
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    border-radius: var(--sb-r-full);
    overflow: hidden;
    background: var(--sb-violet-wash);
    display: grid;
    place-items: center;
  }

  .vcard__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .vcard__monogram { color: var(--sb-violet); opacity: 0.55; }

  .voices__note {
    margin: var(--sb-8) 0 0;
    padding: var(--sb-4) var(--sb-6);
    border-left: 3px solid var(--sb-violet);
    background: var(--sb-violet-wash);
    font-size: var(--sb-body-sm);
    color: var(--sb-text-secondary);
  }

  /* --- Mobile ---------------------------------------------------------------- */

  @media (max-width: 767px) {
    /* The marquee RUNS on mobile too, opposite directions and all — an earlier
       pass replaced it with a static list, which lost the effect the section is
       built around. Only the card sizing changes here: at 306px wide with a
       68px avatar the cards were bigger than the phone could carry, and the
       text had about four characters a line to work with. */
    .vcard {
      width: 276px;
      gap: var(--sb-5);
      padding: var(--sb-5);
      /* A full pill wastes the width a phone does not have. */
      border-radius: var(--sb-r-2);
    }

    /* The name and class share a line on desktop with a rule between them. In a
       176px text column they wrap, and the rule is left dangling at the end of
       the name. Stack them and drop the rule — it only has a job when the two
       sit side by side. */
    .vcard__person {
      flex-direction: column;
      align-items: flex-start;
      gap: 1px;
    }

    .vcard__sep { display: none; }

    .voices__rows { gap: var(--sb-4); }
    .vcard__body { gap: var(--sb-2); }
    .vcard__avatar { width: 52px; height: 52px; }
    .vcard__quotemark { width: 16px; height: 13px; }
    .vcard__quote { font-size: 14px; line-height: 1.5; }

    .voices__head { max-width: none; margin-bottom: var(--sb-7); }
  }

  /* --- Reduced motion --------------------------------------------------------
     No movement at all; each row becomes a normal scroller so every card is
     still reachable. */
  @media (prefers-reduced-motion: reduce) {
    .voices__track { animation: none; transform: none; }
    .voices__row { overflow-x: auto; scrollbar-width: thin; }
  }
</style>


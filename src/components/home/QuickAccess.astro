---
/**
 * §04 · PARENT QUICK ACCESS — docs/06 §04
 *
 * The highest-frequency audience (D2, existing parents) gets a one-tap route to
 * the six things they actually come for, without being routed through marketing.
 *
 * Rebuilt on reference 1's card pattern: a soft pastel disc holding a line-art
 * icon, title, one-line descriptor and a circular arrow. Replaces the earlier
 * rule-separated band, which read as thin and gave a lot of air to very little.
 *
 * The icons are functional, not decorative — each names its destination, which
 * is what makes this scannable at a glance for a returning parent.
 */
import { quickAccess } from '../../data/site';

/** Pastel disc per item, plus the icon path. Tones stay in the warm family. */
const looks = [
  { tone: 'peach', label: 'Admissions' },
  { tone: 'sky', label: 'Transport' },
  { tone: 'sun', label: 'Academic Calendar' },
  { tone: 'mint', label: 'Notice Board' },
  { tone: 'rose', label: 'Results' },
  { tone: 'lilac', label: 'Contact' },
] as const;
---

<section class="quick" aria-labelledby="quick-heading">
  <div class="u-container">
    <div class="quick__head">
      <p class="quick__eyebrow"><span class="pill pill--violet">For Parents &amp; Students</span></p>
      <h2 class="quick__heading t-h2-sans" data-split id="quick-heading">
        Everything you came <span class="t-squiggle">for</span>
      </h2>
    </div>

    <ul class="quick__grid">
      {quickAccess.map((item, i) => (
        <li>
          <a
            class="qcard"
            href={item.href}
            {...('external' in item && item.external
              ? { target: '_blank', rel: 'noopener' }
              : {})}
          >
            <span class={`qcard__disc qcard__disc--${looks[i].tone}`} aria-hidden="true">
              {i === 0 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" />
                  <path d="M14 3v5h5M9 13h6M9 17h4" />
                </svg>
              )}
              {i === 1 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="12" rx="2" />
                  <path d="M3 10h18M7 16v2M17 16v2" />
                  <circle cx="7.5" cy="13" r="1" /><circle cx="16.5" cy="13" r="1" />
                </svg>
              )}
              {i === 2 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="16" rx="2" />
                  <path d="M3 10h18M8 3v4M16 3v4M8 14h3M8 17h6" />
                </svg>
              )}
              {i === 3 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="4" width="16" height="16" rx="2" />
                  <path d="M8 3v3M16 3v3M8 11h8M8 15h5" />
                </svg>
              )}
              {i === 4 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 20V10M12 20V4M19 20v-7" />
                  <path d="M3 20h18" />
                </svg>
              )}
              {i === 5 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              )}
            </span>

            <span class="qcard__body">
              <span class="qcard__title">{item.label}</span>
              <span class="qcard__desc">{item.desc}</span>
              <span class="qcard__go" aria-hidden="true">
                <svg width="13" height="10" viewBox="0 0 14 10" fill="none">
                  <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.6" />
                </svg>
              </span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .quick {
    background: var(--sb-ivory);
    padding-block: var(--sb-section-y);
    border-bottom: var(--sb-hairline);
  }

  .quick__head {
    text-align: center;
    margin-bottom: var(--sb-9);
  }

  .quick__eyebrow { margin-bottom: var(--sb-5); }
  .quick__heading { color: var(--sb-charcoal); }

  .quick__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sb-8) var(--sb-9);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --- Card ----------------------------------------------------------------- */

  .qcard {
    display: flex;
    align-items: flex-start;
    gap: var(--sb-6);
    height: 100%;
  }

  .qcard__disc {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    border-radius: var(--sb-r-full);
    transition: transform var(--sb-dur-image) var(--sb-ease);
  }

  .qcard:hover .qcard__disc { transform: scale(1.06); }

  /* Soft discs, warm family. Icon strokes are the deep tone of each disc so
     they stay legible rather than relying on the pastel alone. */
  .qcard__disc--peach { background: #ffe6da; color: #b03d0c; }
  .qcard__disc--sky   { background: #dfeafb; color: #1d4e89; }
  .qcard__disc--sun   { background: #fdeecb; color: #8a5a00; }
  .qcard__disc--mint  { background: #dcf0e4; color: #2f6b4f; }
  .qcard__disc--rose  { background: #fde0e6; color: #a8264a; }
  .qcard__disc--lilac { background: #e7e3f7; color: #4b3b96; }

  .qcard__body {
    display: flex;
    flex-direction: column;
    gap: var(--sb-3);
    padding-top: var(--sb-2);
  }

  .qcard__title {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: var(--sb-h4);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
    transition: color var(--sb-dur-link) ease;
  }

  .qcard:hover .qcard__title,
  .qcard:focus-visible .qcard__title { color: var(--sb-violet); }

  .qcard__desc {
    font-size: var(--sb-body-sm);
    line-height: 1.55;
    color: var(--sb-text-muted);
  }

  .qcard__go {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    margin-top: var(--sb-2);
    border-radius: var(--sb-r-full);
    border: 1px solid var(--sb-border-strong);
    color: var(--sb-charcoal);
    transition: background-color var(--sb-dur-btn) ease, color var(--sb-dur-btn) ease,
      border-color var(--sb-dur-btn) ease, transform var(--sb-dur-btn) var(--sb-ease);
  }

  .qcard:hover .qcard__go {
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    color: #fff;
    transform: translateX(3px);
  }

  /* --- Tablet: 2 columns ------------------------------------------------------ */

  @media (max-width: 1023px) {
    .quick__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sb-8) var(--sb-7); }
    .qcard__disc { width: 76px; height: 76px; }
    .qcard__disc svg { width: 26px; height: 26px; }
  }

  /* --- Mobile: single column, tighter -------------------------------------- */

  @media (max-width: 639px) {
    .quick__grid { grid-template-columns: minmax(0, 1fr); gap: var(--sb-7); }
    .qcard { gap: var(--sb-5); align-items: center; }
    .qcard__disc { width: 64px; height: 64px; }
    .qcard__disc svg { width: 24px; height: 24px; }
    .qcard__go { display: none; } /* the whole card is the tap target here */
  }
</style>

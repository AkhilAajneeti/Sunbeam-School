---
/**
 * §03b · RECOGNITION PROOF STRIP — docs/06 §03b
 *
 * Answers "is this school actually any good?" inside the first viewport.
 * The audit fixes the full Achievements section at the page tail (1.14); this
 * thin bar honours that placement while still meeting the parent's immediate
 * question. It is a proof BAR, not a section — no heading, no cards, no images,
 * and deliberately no large numerals (that treatment belongs to §05 and §14).
 *
 * Every claim is verified — docs/01 § 5.
 */
import { proofPoints } from '../../data/site';

const label =
  'Achievements and recognition — ' +
  proofPoints.map((p) => `${p.primary}, ${p.qualifier}`).join('. ');
---

<section class="proof" aria-label="Recognition">
  <div class="u-container">
    <a class="proof__strip" href="/about/achievements/" aria-label={label}>
      {proofPoints.map((point) => (
        <span class="proof__cell">
          <span class="proof__primary">{point.primary}</span>
          <span class="proof__qualifier t-caption">{point.qualifier}</span>
        </span>
      ))}
      <span class="proof__more" aria-hidden="true">
        <svg class="arrow" width="14" height="10" viewBox="0 0 14 10" fill="none">
          <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  .proof {
    background: var(--sb-sand);
    border-bottom: var(--sb-hairline);
  }

  .proof__strip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr)) auto;
    /* stretch, not center: the qualifiers run to different line counts, and
       top-aligned cells keep every primary line on one optical baseline. */
    align-items: stretch;
    min-height: 72px;
    transition: background-color var(--sb-dur-link) ease;
  }

  .proof__strip:hover {
    background: var(--sb-violet-wash);
  }

  /* NOTE ON SELECTOR SHAPE
     Every divider rule below is a single compound (.proof__cell:nth-child(...)),
     never a combinator. Astro appends its scope attribute to each compound in a
     selector, so `.proof__cell + .proof__cell` scopes to (0,4,0) while
     `.proof__cell:nth-child(n)` is (0,3,0) — the combinator then outranks any
     later breakpoint override and the dividers survive into layouts that should
     not have them. Keeping one shape keeps the cascade decided by source order. */

  .proof__cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: var(--sb-5) 0 var(--sb-5) var(--sb-6);
  }

  .proof__cell:nth-child(n + 2) {
    border-left: var(--sb-hairline);
  }

  .proof__cell:nth-child(1) { padding-left: 0; }

  .proof__primary {
    font-size: var(--sb-body-sm);
    font-weight: 600;
    color: var(--sb-charcoal);
    line-height: 1.35;
  }

  .proof__qualifier {
    color: var(--sb-text-muted);
  }

  .proof__more {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--sb-violet);
    opacity: 0;
    transition: opacity var(--sb-dur-link) ease;
  }

  .proof__strip:hover .proof__more,
  .proof__strip:focus-visible .proof__more {
    opacity: 1;
  }

  .proof__strip:hover .arrow {
    transform: translateX(3px);
  }

  .arrow {
    transition: transform var(--sb-dur-link) var(--sb-ease);
  }

  @media (max-width: 1279px) {
    .proof__cell:nth-child(n) { padding-left: var(--sb-5); }
    .proof__cell:nth-child(1) { padding-left: 0; }
    .proof__more { display: none; }
    .proof__strip { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  /* --- 2 × 2 from tablet down (docs/06 §03b) ------------------------------
     Four across needs ~236px a cell to hold "#1 Co-Ed Day School in Ballia" in
     two lines. At 768 that falls to 176px and the strip turns ragged, so the
     2 × 2 arrangement starts at the tablet band rather than at 767. */
  @media (max-width: 1023px) {
    .proof__strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      min-height: 0;
      padding-block: var(--sb-2);
    }

    /* reset, then re-apply per grid position */
    .proof__cell:nth-child(n) {
      padding: var(--sb-5) 0;
      border-left: 0;
    }

    .proof__cell:nth-child(2n) {
      padding-left: var(--sb-5);
      border-left: var(--sb-hairline);
    }

    .proof__cell:nth-child(n + 3) {
      border-top: var(--sb-hairline);
    }
  }

  /* --- Narrow phones: single column ---------------------------------------- */
  @media (max-width: 419px) {
    .proof__strip { grid-template-columns: minmax(0, 1fr); }

    .proof__cell:nth-child(n) {
      padding: var(--sb-4) 0;
      border-left: 0;
      border-top: 0;
    }

    .proof__cell:nth-child(n + 2) {
      border-top: var(--sb-hairline);
    }
  }
</style>

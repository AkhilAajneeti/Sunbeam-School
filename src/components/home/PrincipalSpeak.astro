---
/**
 * PRINCIPAL SPEAK — audit 1.9 / 1.10 / 1.12
 *
 * The audit keeps the Principal's Message as its own page (1.10). This is a
 * homepage extract that links through to it, not a replacement for it.
 *
 * COPY — taken verbatim from the school's published Principal's Message. Audit
 * 1.12 asks that page to be "thoroughly proofread to eliminate grammatical and
 * spelling errors"; the passages used here read cleanly, unlike the homepage
 * welcome text this redesign replaced. Nothing has been rewritten or invented.
 *
 * NAME — the live site says "Mrs. Arpita Singh"; a nameplate in one of the
 * supplied event photographs reads "Dr. Arpita Singh". Sticking with the
 * published form until the school confirms (docs/08 D15).
 */
import { school } from '../../data/site';
import Photo from '../ui/Photo.astro';
import principal from '../../assets/photos/sb-principal.jpg';

const quote =
  'At Sunbeam School Ballia, we believe that education is not merely about imparting knowledge, but about nurturing character, inspiring creativity, and preparing young minds to lead with empathy and vision.';

const paragraphs = [
  'The Sunbeam vision has always been to empower students with 21st-century skills while staying rooted in Indian culture and moral values. We are committed to holistic development — intellectual growth, physical well-being, emotional resilience and ethical strength.',
  'As Principal, my role is to ensure that every child feels valued, safe, and inspired to achieve their full potential.',
];
---

<section class="principal" aria-labelledby="principal-heading">
  <div class="u-container">
    <div class="principal__card">
      <div class="principal__media">
        <Photo
          src={principal}
          alt={`${school.principal}, Principal of Sunbeam School Ballia, at her desk.`}
          brief="Principal portrait"
          ratio="4 / 5"
          position="50% 28%"
          sizes="(max-width: 1023px) 100vw, 38vw"
        />
      </div>

      <div class="principal__body" data-reveal>
        <p class="principal__pill"><span class="pill pill--violet">Principal Speak</span></p>

        <h2 class="principal__heading t-h2-sans" id="principal-heading">
          A word from our <span class="t-squiggle">Principal</span>
        </h2>

        <blockquote class="principal__quote">
          <svg class="principal__mark" width="26" height="20" viewBox="0 0 18 15"
            fill="currentColor" aria-hidden="true">
            <path d="M7.2 0C3.3 0 0 3.1 0 7.4c0 3.9 2.7 6.9 6.2 7.6l.6-1.9C4.5 12.4 3 10.6 3 8.3h4.2V0Zm10.6 0c-3.9 0-7.2 3.1-7.2 7.4 0 3.9 2.7 6.9 6.2 7.6l.6-1.9c-2.3-.7-3.8-2.5-3.8-4.8H18V0Z" />
          </svg>
          <p>{quote}</p>
        </blockquote>

        <div class="principal__text">
          {paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <div class="principal__sign">
          <div>
            <p class="principal__name">{school.principal}</p>
            <p class="principal__role">Principal, {school.name}</p>
          </div>
          <a class="btn btn--secondary principal__cta" href="/about/principals-message/">
            Read the full message
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .principal {
    background: var(--sb-ivory);
    padding-block: clamp(48px, 6vh, 96px);
  }

  .principal__card {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
    background: #fff;
    border-radius: var(--sb-r-3);
    box-shadow: 0 30px 70px -34px rgba(21, 15, 51, 0.26);
    overflow: hidden;
    padding: clamp(20px, 2.4vh, 32px);
  }

  .principal__media {
    border-radius: var(--sb-r-2);
    overflow: hidden;
    max-height: clamp(320px, 52vh, 560px);
  }

  .principal__media :global(.photo) { height: 100%; }

  .principal__body { padding-right: clamp(0px, 2vw, 32px); }

  .principal__pill { margin-bottom: var(--sb-5); }

  .principal__heading {
    color: var(--sb-charcoal);
    font-size: clamp(24px, 3.2vh, var(--sb-h2));
    margin-bottom: var(--sb-6);
  }

  /* Pull quote — violet rule, mark set above rather than as a giant glyph. */
  .principal__quote {
    margin: 0 0 var(--sb-6);
    padding-left: var(--sb-6);
    border-left: 3px solid var(--sb-violet);
  }

  .principal__mark { color: var(--sb-violet); opacity: 0.4; margin-bottom: var(--sb-3); }

  .principal__quote p {
    font-size: clamp(15px, 2.1vh, var(--sb-body-lg));
    line-height: 1.55;
    color: var(--sb-charcoal);
    font-weight: 500;
  }

  .principal__text p {
    font-size: clamp(13px, 1.8vh, var(--sb-body-sm));
    line-height: 1.65;
    color: var(--sb-text-muted);
  }

  .principal__text p + p { margin-top: var(--sb-4); }

  .principal__sign {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sb-5);
    margin-top: var(--sb-7);
    padding-top: var(--sb-6);
    border-top: var(--sb-hairline);
  }

  .principal__name {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: var(--sb-body);
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }

  .principal__role {
    font-size: var(--sb-caption);
    color: var(--sb-text-muted);
    margin-top: 2px;
  }

  .principal__cta { flex-shrink: 0; }

  /* --- Tablet & mobile -------------------------------------------------------- */

  @media (max-width: 1023px) {
    .principal__card {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sb-7);
    }
    .principal__media { max-height: 340px; }
    .principal__body { padding-right: 0; }
  }

  @media (max-width: 767px) {
    .principal__card { padding: var(--sb-5); border-radius: var(--sb-r-2); }
    .principal__sign { flex-direction: column; align-items: flex-start; }
    .principal__cta { width: 100%; }
  }

  /* Very short viewports: the second paragraph steps aside so the quote,
     attribution and CTA all stay on screen. */
  @media (max-height: 880px) {
    .principal__text p:last-child { display: none; }
  }
</style>

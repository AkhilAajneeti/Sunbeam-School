---
import '../styles/tokens.css';
import '../styles/base.css';
import UtilityBar from '../components/navigation/UtilityBar.astro';
import Masthead from '../components/navigation/Masthead.astro';
import MobileNav from '../components/navigation/MobileNav.astro';
import Footer from '../components/layout/Footer.astro';
import { school } from '../data/site';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* A reload must start at the top.

        Browsers default `history.scrollRestoration` to "auto" and put you back
        where you were — normally helpful, but wrong for a page built as a scroll
        narrative: you reload and land in the middle of it with no context, and
        every entrance animation above you has already been skipped.

        This is deliberately an inline, render-blocking script in the head. It
        has to run before the browser performs the restoration; a module script
        or anything deferred executes too late and you would see the jump happen.

        Note this does NOT force a scroll — it only stops the browser restoring
        one. A URL with a #hash still lands on its target, which a `scrollTo(0,0)`
        would have fought. */}
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>
    <title>{title}</title>
    {/* Finding X8 — the current site ships no meta description at all. */}
    <meta name="description" content={description} />
    <meta name="theme-color" content="#5C0000" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" href="/brand/sunbeam-emblem.png" type="image/png" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-sans-latin-wght-normal.woff2"
      crossorigin
    />
    {/* The display face renders above the fold in the hero heading, so it is
        preloaded rather than discovered when the CSS parses. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/bricolage-grotesque-latin-wght-normal.woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={school.name} />
  </head>

  <body>
    <a class="u-skip-link" href="#main">Skip to content</a>

    <UtilityBar />
    <Masthead />
    <MobileNav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {/* Motion (docs/05 § N). Replaces the IntersectionObserver reveal that used
        to live here, so nothing is ever animated by two systems at once.
        Content is visible by default and this only hides things once it has
        loaded and confirmed motion is permitted — see src/scripts/motion.ts. */}
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

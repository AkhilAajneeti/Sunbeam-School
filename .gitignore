# ─── Dependencies ────────────────────────────────────────────────────────────
# Restored with `npm ci` from package-lock.json, which IS committed.
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/releases
!.yarn/versions


# ─── Build output ────────────────────────────────────────────────────────────
# Regenerated by `npm run build`. Includes every optimised image variant, so
# committing it would add tens of megabytes that change on every build.
dist/
.output/
.vercel/
.netlify/


# ─── Astro generated ─────────────────────────────────────────────────────────
# Type definitions and the content cache, regenerated on dev/build.
.astro/


# ─── Visual QA artefacts ─────────────────────────────────────────────────────
# Screenshots captured during review — ~64 MB and reproducible at any time with
# `node scripts/qa-shots.mjs`. Never useful in history.
qa/


# ─── Environment & secrets ───────────────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key


# ─── Logs & caches ───────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
.cache/
*.tsbuildinfo


# ─── Test / tooling ──────────────────────────────────────────────────────────
coverage/
playwright-report/
test-results/
.playwright/


# ─── Editor & OS ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*


# ─── OneDrive ────────────────────────────────────────────────────────────────
# This project lives inside a synced OneDrive folder; these are sync leftovers.
*.tmp
~$*


# ─── Deliberately NOT ignored ────────────────────────────────────────────────
# Keep these tracked — they are the project, not build output:
#
#   src/assets/photos/   school photography the build imports and optimises
#   public/brand/        logo derivatives produced by scripts/logo-prep.mjs
#   public/fonts/        self-hosted variable WOFF2 files
#   docs/                the approved design/requirements knowledge base
#   scripts/             logo prep + visual QA tooling
#   package-lock.json    pins the exact dependency tree for `npm ci`
#   *.pdf                the client audit report — the governing requirements doc

# ─── Source video ────────────────────────────────────────────────────────────
# The client's raw drone footage: 1080p50 at ~40 Mbps, ~100 MB per clip.
# banner-2.MP4 is 107 MB, which is OVER GitHub's 100 MB hard limit and would
# have its push REJECTED outright. What ships is the encode in public/video/
# (1600x900, CRF 32, ~3 MB each) plus the poster frames in src/assets/videos/,
# and both of those ARE tracked. Keep the masters here locally; re-encode with
# the recipe in components/home/Hero.astro rather than committing these.
src/assets/videos/*.MP4
src/assets/videos/*.mp4
src/assets/videos/*.MOV
src/assets/videos/*.mov
